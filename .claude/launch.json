{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cuidapp-administrativo",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "CUIDAPP_ADMINISTRATIVO",
        "--launch-profile",
        "http"
      ],
      "port": 5203
    },
    {
      "name": "cuidapp-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "CUIDAPP_API",
        "--launch-profile",
        "http"
      ],
      "port": 5258
    },
    {
      "name": "cuidapp-administrativo-local",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "CUIDAPP_ADMINISTRATIVO",
        "--launch-profile",
        "http",
        "--",
        "--ApiBaseUrl=http://localhost:5258/api/",
        "--SignalRHubUrl=http://localhost:5258/hubs/trabajo"
      ],
      "port": 5203
    }
  ]
}