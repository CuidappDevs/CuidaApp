@page "/sos-alertas"
@layout CUIDAPP_ADMINISTRATIVO.Components.Layout.AdminLayout
@implements IDisposable
@inject SosNotificationService SosService
@inject PanelApiService Api
@inject ConfirmacionService Confirmacion
@inject AvisoToastService Toasts

<PageTitle>Emergencias SOS · Cuidapp Admin</PageTitle>

<div class="pn-page">
    <div class="pn-toolbar">
        <div class="pn-seg">
            <button type="button" class="@(_vista == 0 ? "on" : "")" @onclick="() => CambiarVista(0)">
                Activas <span class="pn-seg-n">@SosService.AlertasPendientes.Count</span>
            </button>
            <button type="button" class="@(_vista == 1 ? "on" : "")" @onclick="() => CambiarVista(1)">Historial</button>
        </div>
        <span class="pn-grow"></span>
        <button type="button" class="pn-btn pn-btn-quiet" @onclick="Recargar">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-3-6.7L21 8M21 3v5h-5"></path></svg>
            Actualizar
        </button>
    </div>

    @if (_vista == 0)
    {
        var alertas = SosService.AlertasPendientes;
        @if (alertas.Count == 0)
        {
            <div class="adm-card">
                <EstadoVacio Titulo="No hay emergencias activas"
                             Texto="Cuando un cliente o un Care Partner presione el botón SOS, o la app detecte una posible caída, la alerta aparecerá aquí al instante."
                             Icono="M9 12l2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </div>
        }
        else
        {
            <div class="d-flex flex-column" style="gap:14px;">
                @foreach (var a in alertas)
                {
                    <div class="adm-card" style="border:1.5px solid #FCA5A5; box-shadow:0 8px 24px -12px rgba(220,38,38,.35);" @key="a.Id">
                        <div class="d-flex flex-wrap" style="gap:18px; padding:20px 22px;">
                            <div class="pn-kpi-icon" style="width:46px; height:46px; border-radius:14px; background:var(--danger-soft); color:var(--danger);">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"></path></svg>
                            </div>
                            <div class="d-flex flex-column" style="flex:1; min-width:240px; gap:8px;">
                                <div class="d-flex flex-wrap align-items-center" style="gap:8px;">
                                    <span style="font-size:16px; font-weight:600;">@a.NombreUsuario</span>
                                    <span class="pn-pill tone-muted no-dot">@a.TipoUsuario</span>
                                    @if (a.EsAutomatica)
                                    {
                                        <span class="pn-pill tone-danger">Posible caída · detección automática</span>
                                    }
                                    <span class="pn-muted">hace @Hace(a.FechaCreacion) · @a.FechaCreacion.ToString("HH:mm:ss")</span>
                                </div>

                                @if (!string.IsNullOrEmpty(a.Motivo))
                                {
                                    <div class="pn-callout tone-muted" style="padding:10px 12px;">@a.Motivo</div>
                                }

                                <dl class="pn-kv" style="margin:4px 0 0;">
                                    <dt>Servicio</dt>
                                    <dd><a class="pn-link" href="servicios/@a.TrabajoId">#@a.TrabajoId · ver detalle</a></dd>
                                    @if (!string.IsNullOrEmpty(a.EmailUsuario))
                                    {
                                        <dt>Correo</dt><dd>@a.EmailUsuario</dd>
                                    }
                                    <dt>Contacto de emergencia</dt>
                                    <dd>
                                        @if (!string.IsNullOrEmpty(a.ContactoNombre) || !string.IsNullOrEmpty(a.ContactoTelefono))
                                        {
                                            <span class="pn-strong">@a.ContactoNombre</span>
                                            @if (!string.IsNullOrEmpty(a.ContactoTelefono))
                                            {
                                                <text> · </text><a class="pn-link" href="tel:@a.ContactoTelefono">@a.ContactoTelefono</a>
                                            }
                                            @if (!string.IsNullOrEmpty(a.ContactoEmail))
                                            {
                                                <text> · @a.ContactoEmail</text>
                                            }
                                        }
                                        else
                                        {
                                            <span style="color:var(--warn);">No tiene contacto de emergencia registrado</span>
                                        }
                                    </dd>
                                    <dt>Ubicación</dt>
                                    <dd>
                                        @a.Latitud.ToString("F5", System.Globalization.CultureInfo.InvariantCulture), @a.Longitud.ToString("F5", System.Globalization.CultureInfo.InvariantCulture)
                                        · <a class="pn-link" target="_blank" rel="noopener" href="@($"https://www.google.com/maps?q={a.Latitud.ToString(System.Globalization.CultureInfo.InvariantCulture)},{a.Longitud.ToString(System.Globalization.CultureInfo.InvariantCulture)}")">Abrir en Google Maps</a>
                                    </dd>
                                </dl>
                            </div>
                            <div class="d-flex flex-column" style="gap:8px; flex:none;">
                                <button type="button" class="pn-btn pn-btn-ok" disabled="@(_procesando == a.Id)" @onclick="() => Atender(a)">Marcar como atendida</button>
                                <button type="button" class="pn-btn pn-btn-quiet" disabled="@(_procesando == a.Id)" @onclick="() => Descartar(a)">Falsa alarma</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="adm-card overflow-hidden">
            @if (_historial == null)
            {
                <Esqueleto Filas="5" ConAvatar="false" />
            }
            else if (_historial.Count == 0)
            {
                <EstadoVacio Titulo="Sin alertas anteriores" Texto="Aquí quedan las alertas atendidas o descartadas." />
            }
            else
            {
                <div class="pn-table-wrap">
                    <table class="pn-table">
                        <thead><tr><th>Fecha</th><th>Persona</th><th>Origen</th><th>Servicio</th><th>Resultado</th><th>Atendida por</th></tr></thead>
                        <tbody>
                            @foreach (var a in Paginador.Cortar(_historial, _pagina, 15))
                            {
                                <tr>
                                    <td class="pn-num" style="text-align:left;">@a.FechaCreacion.ToString("dd MMM yyyy, HH:mm")</td>
                                    <td><span class="pn-strong">@a.NombreUsuario</span> <span class="pn-muted">· @a.TipoUsuario</span></td>
                                    <td>@(a.EsAutomatica ? "Caída detectada" : "Botón SOS")</td>
                                    <td><a class="pn-link" href="servicios/@a.TrabajoId">#@a.TrabajoId</a></td>
                                    <td><span class="pn-pill @(a.Estado == "Atendida" ? "tone-ok" : "tone-muted")">@a.Estado</span></td>
                                    <td>@(a.AtendidoPor ?? "—") @if (a.FechaAtencion is { } f) { <span class="pn-muted">· @f.ToString("HH:mm")</span> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Paginador Pagina="_pagina" Tamano="15" Total="_historial.Count" PaginaCambiada="p => _pagina = p" />
            }
        </div>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private int _vista;
    private int _pagina = 1;
    private int? _procesando;
    private string _nombreAdmin = "Administrador";
    private List<SosAlerta>? _historial;

    protected override async Task OnInitializedAsync()
    {
        SosService.OnAlertaRecibida += Refrescar;
        SosService.OnAlertaAtendida += Refrescar;
        if (AuthStateTask != null)
            _nombreAdmin = (await AuthStateTask).User.FindFirst(ClaimTypes.Name)?.Value ?? _nombreAdmin;
    }

    private void Refrescar() => InvokeAsync(StateHasChanged);

    private async Task CambiarVista(int v)
    {
        _vista = v;
        if (v == 1) { _historial = null; _pagina = 1; _historial = await Api.SosHistorialAsync() ?? new(); }
    }

    private async Task Recargar()
    {
        await SosService.RecargarAsync();
        if (_vista == 1) await CambiarVista(1);
        Toasts.Mostrar("Alertas actualizadas.");
    }

    private async Task Atender(SosAlerta a)
    {
        if (!await Confirmacion.PreguntarAsync("¿Marcar como atendida?",
                $"Confirma que ya se contactó a {a.NombreUsuario} o a su contacto de emergencia. Quedará registrada a tu nombre.", "Marcar atendida"))
            return;
        _procesando = a.Id;
        Toasts.Mostrar(await SosService.AtenderAsync(a.Id, _nombreAdmin));
        _procesando = null;
    }

    private async Task Descartar(SosAlerta a)
    {
        if (!await Confirmacion.PreguntarAsync("¿Es una falsa alarma?",
                $"La alerta de {a.NombreUsuario} saldrá de la lista de activas y quedará en el historial como descartada.", "Descartar alerta", peligro: true))
            return;
        _procesando = a.Id;
        Toasts.Mostrar(await SosService.DescartarAsync(a.Id));
        _procesando = null;
    }

    private static string Hace(DateTime fecha)
    {
        // Las fechas del servidor están en hora de RD (UTC-4).
        var min = (DateTime.UtcNow.AddHours(-4) - fecha).TotalMinutes;
        return min < 1 ? "menos de 1 min" : min < 60 ? $"{min:0} min" : min < 1440 ? $"{min / 60:0} h" : $"{min / 1440:0} d";
    }

    public void Dispose()
    {
        SosService.OnAlertaRecibida -= Refrescar;
        SosService.OnAlertaAtendida -= Refrescar;
    }
}
