@page "/sos-alertas"
@inject SosNotificationService SosService
@inject HttpClient Http
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Emergencias SOS - CuidApp Admin</PageTitle>

<div style="padding:24px; max-width:900px;">
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:20px;">
        <div>
            <h2 style="margin:0; font-size:20px; font-weight:600;">Emergencias SOS</h2>
            <p style="margin:4px 0 0; color:#6B7280; font-size:13px;">Alertas de emergencia recibidas en tiempo real</p>
        </div>
        <span style="background:#FEE2E2; color:#991B1B; padding:4px 12px; border-radius:20px; font-size:13px; font-weight:600;">
            @SosService.AlertasPendientes.Count activa(s)
        </span>
    </div>

    @if (SosService.AlertasPendientes.Count == 0)
    {
        <div style="text-align:center; padding:60px 20px; background:#F9FAFB; border-radius:12px; border:1px dashed #D1D5DB;">
            <div style="font-size:48px; margin-bottom:12px;">✅</div>
            <h3 style="margin:0; color:#374151; font-size:16px;">No hay alertas SOS activas</h3>
            <p style="margin:8px 0 0; color:#9CA3AF; font-size:13px;">Las emergencias aparecerán aquí en tiempo real cuando un cliente o cuidador presione el botón SOS.</p>
        </div>
    }
    else
    {
        @foreach (var alerta in SosService.AlertasPendientes.OrderByDescending(a => a.FechaCreacion))
        {
            <div style="background:white; border:2px solid #C62828; border-radius:12px; padding:20px; margin-bottom:16px; box-shadow: 0 4px 12px rgba(198,40,40,0.15);">
                <div style="display:flex; align-items:start; justify-content:space-between;">
                    <div style="display:flex; gap:14px;">
                        <div style="width:48px; height:48px; background:#FEE2E2; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:22px; flex-shrink:0;">
                            🚨
                        </div>
                        <div>
                            <div style="font-size:16px; font-weight:600; color:#111827;">@alerta.NombreUsuario</div>
                            @if (alerta.EsAutomatica)
                            {
                                <div style="margin-top:4px;">
                                    <span style="background:#C62828; color:white; padding:2px 8px; border-radius:10px; font-weight:700; font-size:11px;">⚠ DETECCIÓN AUTOMÁTICA · Posible caída</span>
                                </div>
                            }
                            <div style="font-size:13px; color:#6B7280; margin-top:2px;">
                                <span style="background:#FEF3C7; color:#92400E; padding:2px 8px; border-radius:10px; font-weight:600; font-size:11px;">@alerta.TipoUsuario</span>
                                &nbsp;· Trabajo #@alerta.TrabajoId
                                &nbsp;· @alerta.FechaCreacion.ToString("HH:mm:ss")
                            </div>
                            @if (!string.IsNullOrEmpty(alerta.EmailUsuario))
                            {
                                <div style="font-size:12px; color:#6B7280; margin-top:4px;">📧 @alerta.EmailUsuario</div>
                            }
                            @if (!string.IsNullOrEmpty(alerta.ContactoNombre) || !string.IsNullOrEmpty(alerta.ContactoTelefono))
                            {
                                <div style="font-size:12px; color:#374151; margin-top:4px;">
                                    👪 Contacto de emergencia: <b>@alerta.ContactoNombre</b>
                                    @if (!string.IsNullOrEmpty(alerta.ContactoTelefono)) { <span>· 📞 @alerta.ContactoTelefono</span> }
                                    @if (!string.IsNullOrEmpty(alerta.ContactoEmail)) { <span>· ✉ @alerta.ContactoEmail</span> }
                                </div>
                            }
                            else if (alerta.EsAutomatica)
                            {
                                <div style="font-size:12px; color:#B45309; margin-top:4px;">👪 Este cuidador no tiene contacto de emergencia registrado.</div>
                            }
                            @if (!string.IsNullOrEmpty(alerta.Motivo))
                            {
                                <div style="font-size:13px; color:#374151; margin-top:6px; background:#F8FAFC; padding:8px 12px; border-radius:8px;">@alerta.Motivo</div>
                            }
                            <div style="font-size:12px; color:#9CA3AF; margin-top:6px;">
                                📍 @alerta.Latitud.ToString("F6"), @alerta.Longitud.ToString("F6")
                                &nbsp;· <a href="https://www.google.com/maps?q=@alerta.Latitud,@alerta.Longitud" target="_blank" style="color:#2563EB;">Ver en mapa</a>
                            </div>
                        </div>
                    </div>
                    <div style="display:flex; gap:8px; flex-shrink:0;">
                        <button style="background:#16A34A; color:white; border:none; padding:8px 16px; border-radius:8px; font-weight:600; font-size:13px; cursor:pointer;" @onclick="() => AtenderAlerta(alerta)">Atender</button>
                        <button style="background:#F3F4F6; color:#374151; border:1px solid #D1D5DB; padding:8px 16px; border-radius:8px; font-weight:600; font-size:13px; cursor:pointer;" @onclick="() => DescartarAlerta(alerta)">Descartar</button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    protected override void OnInitialized()
    {
        SosService.OnAlertaRecibida += OnAlertaCambiada;
        SosService.OnAlertaAtendida += OnAlertaCambiada;
    }

    private void OnAlertaCambiada()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task AtenderAlerta(SosAlerta alerta)
    {
        try
        {
            await Http.PutAsJsonAsync($"sos/{alerta.Id}/atender", new { AtendidoPor = "Admin Panel" });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error atendiendo SOS: {ex.Message}");
        }

        SosService.MarcarAtendida(alerta.Id);
    }

    private async Task DescartarAlerta(SosAlerta alerta)
    {
        try
        {
            await Http.PutAsJsonAsync($"sos/{alerta.Id}/descartar", new { });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error descartando SOS: {ex.Message}");
        }

        SosService.MarcarAtendida(alerta.Id);
    }

    public void Dispose()
    {
        SosService.OnAlertaRecibida -= OnAlertaCambiada;
        SosService.OnAlertaAtendida -= OnAlertaCambiada;
    }
}
