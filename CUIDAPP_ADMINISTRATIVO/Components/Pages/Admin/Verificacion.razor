@page "/verificacion"
@layout CUIDAPP_ADMINISTRATIVO.Components.Layout.AdminLayout
@inject PanelApiService Api
@inject NavigationManager Nav

<PageTitle>Verificación · Cuidapp Admin</PageTitle>

<div class="pn-page">
    <div class="pn-toolbar">
        <div class="pn-seg">
            <button type="button" class="@(_filtro == 0 ? "on" : "")" @onclick="() => Filtrar(0)">Todos <span class="pn-seg-n">@(_lista?.Count ?? 0)</span></button>
            <button type="button" class="@(_filtro == 1 ? "on" : "")" @onclick="() => Filtrar(1)">Listos para aprobar <span class="pn-seg-n">@(_lista?.Count(v => v.ListoParaAprobar) ?? 0)</span></button>
            <button type="button" class="@(_filtro == 2 ? "on" : "")" @onclick="() => Filtrar(2)">Con documentos por revisar <span class="pn-seg-n">@(_lista?.Count(v => v.EstadoAprobacion == 1 && v.DocsPendientes > 0) ?? 0)</span></button>
            <button type="button" class="@(_filtro == 3 ? "on" : "")" @onclick="() => Filtrar(3)">Rechazados <span class="pn-seg-n">@(_lista?.Count(v => v.EstadoAprobacion == 3 || v.DocsRechazados > 0) ?? 0)</span></button>
        </div>
    </div>

    @if (_lista?.Any(v => v.ListoParaAprobar) == true && _filtro != 1)
    {
        <div class="pn-callout tone-ok">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 12l2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path></svg>
            <span>Hay <b>@_lista.Count(v => v.ListoParaAprobar)</b> Care Partner(s) con todos sus documentos aprobados que todavía no pueden ponerse visibles: solo falta aprobar su cuenta.</span>
        </div>
    }

    <div class="adm-card overflow-hidden">
        @if (_lista == null)
        {
            <Esqueleto Filas="6" />
        }
        else if (Filtrados().Count() == 0)
        {
            <EstadoVacio Titulo="Nadie en esta lista" Texto="Cuando un Care Partner se registre o reemplace un documento, aparecerá aquí." Icono="M9 12l2 2 4-4M12 3l7 3v6c0 4.5-3 7.7-7 9-4-1.3-7-4.5-7-9V6z" />
        }
        else
        {
            <div class="pn-table-wrap">
                <table class="pn-table">
                    <thead><tr><th>Care Partner</th><th>Documentos</th><th>Esperando</th><th>Última subida</th><th>Estado</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var v in Paginador.Cortar(Filtrados(), _pagina, 15))
                        {
                            <tr class="pn-row-link" @onclick='() => Nav.NavigateTo($"care-partners/{v.UsuarioId}")'>
                                <td>
                                    <div class="pn-who">
                                        <Avatar Url="@Api.Archivo(v.FotoUrl)" Nombre="@v.Nombre" />
                                        <div class="pn-who-text"><span>@v.Nombre</span><span class="pn-muted">@v.Email@(v.Telefono != null ? $" · {v.Telefono}" : "")</span></div>
                                    </div>
                                </td>
                                <td style="min-width:170px;">
                                    <div class="d-flex flex-column" style="gap:6px;">
                                        <div class="pn-progress">
                                            @if (v.DocsTotal > 0)
                                            {
                                                <span style="width:@(100 * v.DocsAprobados / v.DocsTotal)%; background:var(--ok);"></span>
                                                <span style="width:@(100 * v.DocsRechazados / v.DocsTotal)%; background:var(--danger);"></span>
                                                <span style="width:@(100 * v.DocsPendientes / v.DocsTotal)%; background:#FCD34D;"></span>
                                            }
                                        </div>
                                        <span class="pn-muted">@v.DocsAprobados aprobados · @v.DocsPendientes por revisar · @v.DocsRechazados rechazados</span>
                                    </div>
                                </td>
                                <td style="white-space:nowrap;">@Espera(v.FechaCreacion)</td>
                                <td class="pn-muted" style="white-space:nowrap;">@(v.UltimaSubida?.ToString("dd MMM, h:mm tt") ?? "—")</td>
                                <td>
                                    @if (v.EstadoAprobacion == 3) { <span class="pn-pill tone-danger">Cuenta rechazada</span> }
                                    else if (v.ListoParaAprobar) { <span class="pn-pill tone-ok">Listo para aprobar</span> }
                                    else if (v.DocsRechazados > 0) { <span class="pn-pill tone-danger">Esperando reemplazo</span> }
                                    else { <span class="pn-pill tone-warn">Por revisar</span> }
                                </td>
                                <td class="pn-num"><span class="pn-link">Revisar →</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Paginador Pagina="_pagina" Tamano="15" Total="Filtrados().Count()" PaginaCambiada="p => _pagina = p" />
        }
    </div>
</div>

@code {
    private List<VerificacionFila>? _lista;
    private int _filtro;
    private int _pagina = 1;

    protected override async Task OnInitializedAsync() => _lista = await Api.VerificacionAsync() ?? new();

    private void Filtrar(int f) { _filtro = f; _pagina = 1; }

    private IEnumerable<VerificacionFila> Filtrados() => (_lista ?? new()).Where(v => _filtro switch
    {
        1 => v.ListoParaAprobar,
        2 => v.EstadoAprobacion == 1 && v.DocsPendientes > 0,
        3 => v.EstadoAprobacion == 3 || v.DocsRechazados > 0,
        _ => true
    });

    private static string Espera(DateTime? f)
    {
        if (f == null) return "—";
        var d = (DateTime.UtcNow.AddHours(-4) - f.Value).TotalDays;
        return d < 1 ? "Hoy" : d < 2 ? "1 día" : $"{d:0} días";
    }
}
