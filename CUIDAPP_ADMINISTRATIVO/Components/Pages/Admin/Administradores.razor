@page "/administradores"
@layout CUIDAPP_ADMINISTRATIVO.Components.Layout.AdminLayout
@using System.Security.Claims
@using CUIDAPP_ADMINISTRATIVO.Models.Admin
@using CUIDAPP_ADMINISTRATIVO.Services
@inject AdminAccountApiService AdminAccountService

<PageTitle>Administradores · Cuidapp Admin</PageTitle>

<div class="d-grid gap-4" style="grid-template-columns: 1fr 360px; align-items:start;">

    @* ----- Listado ----- *@
    <div class="adm-card overflow-hidden">
        <div class="adm-card-pad" style="border-bottom:1px solid var(--adm-line);">
            <span class="adm-card-title">Cuentas con acceso al panel</span>
            <div class="adm-card-sub">Rol de administrador (RolId = 1).</div>
        </div>

        @if (_cargando)
        {
            <div class="adm-card-pad text-center" style="color:var(--adm-muted);">Cargando administradores...</div>
        }
        else
        {
            @foreach (var a in _admins)
            {
                <div class="d-flex flex-wrap align-items-center" style="gap:12px 16px; padding:16px 24px; border-bottom:1px solid var(--adm-line-soft);">
                    <div class="d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:42px; height:42px; border-radius:14px; background:var(--cuid-blue-soft); font-size:13px; font-weight:600; color:var(--cuid-blue);">
                        @Iniciales(a.NombreCompleto)
                    </div>
                    <div class="d-flex flex-column" style="flex:1; min-width:220px; gap:3px;">
                        <span style="font-size:14.5px; font-weight:600;">@a.NombreCompleto</span>
                        <span class="adm-card-sub">@a.Email · Desde @a.FechaCreacion.ToString("dd MMM yyyy")</span>
                    </div>
                    <span class="flex-shrink-0" style="padding:5px 11px; border-radius:999px; font-size:12px; font-weight:600;
                                 background:@(a.IsActive ? "#DCFCE7" : "#FEE2E2"); color:@(a.IsActive ? "#166534" : "#B91C1C");">
                        @a.EstadoTexto
                    </span>
                    <div class="flex-shrink-0">
                        @if (a.UsuarioId == _adminId)
                        {
                            <span style="font-size:12px; color:var(--adm-muted-2);">Tu cuenta</span>
                        }
                        else if (a.IsActive)
                        {
                            <button type="button" class="adm-btn adm-btn-ghost-line" disabled="@(_procesando == a.UsuarioId)" @onclick="() => Suspender(a.UsuarioId)">
                                Suspender
                            </button>
                        }
                        else
                        {
                            <button type="button" class="adm-btn" style="height:36px; padding:0 16px; border:none; border-radius:11px; background:#16A34A; color:#fff; font-size:13px;"
                                    disabled="@(_procesando == a.UsuarioId)" @onclick="() => Reactivar(a.UsuarioId)">
                                Reactivar
                            </button>
                        }
                    </div>
                </div>
            }
        }
    </div>

    @* ----- Crear cuenta ----- *@
    <div class="adm-card d-flex flex-column" style="padding:26px; gap:16px;">
        <div class="d-flex flex-column" style="gap:4px;">
            <span class="adm-card-title">Crear cuenta administrativa</span>
            <span class="adm-card-sub" style="line-height:1.55;">Tendrá acceso completo al panel de inmediato.</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(_mensaje))
        {
            <div class="adm-card adm-card-pad" style="background:@(_mensajeEsError ? "#FEF2F2" : "#EFF6FF"); border-color:@(_mensajeEsError ? "#FECACA" : "#BFDBFE"); padding:12px 16px; font-size:13px;">
                @_mensaje
            </div>
        }

        <div class="d-flex flex-column" style="gap:6px;">
            <span class="adm-field-k">Nombre completo</span>
            <input class="adm-input" @bind="_nombre" />
        </div>
        <div class="d-flex flex-column" style="gap:6px;">
            <span class="adm-field-k">Correo</span>
            <input class="adm-input" type="email" @bind="_email" />
        </div>
        <div class="d-flex flex-column" style="gap:6px;">
            <span class="adm-field-k">Contraseña</span>
            <input class="adm-input" type="password" @bind="_password" />
        </div>

        <button type="button" class="adm-btn" style="height:44px; border:none; border-radius:11px; background:var(--cuid-blue); color:#fff; font-size:14px;"
                disabled="@_creando" @onclick="Crear">
            @(_creando ? "Creando..." : "Crear cuenta")
        </button>
    </div>

</div>

@code {
    [CascadingParameter]
    private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private List<AdminUsuario> _admins = new();
    private bool _cargando = true;
    private int? _procesando;
    private bool _creando;
    private int _adminId;

    private string _nombre = "";
    private string _email = "";
    private string _password = "";
    private string? _mensaje;
    private bool _mensajeEsError;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var user = (await AuthStateTask).User;
            _adminId = int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
        }

        await Cargar();
    }

    private async Task Cargar()
    {
        _cargando = true;
        StateHasChanged();

        _admins = await AdminAccountService.ObtenerAdminsAsync();

        _cargando = false;
    }

    private async Task Crear()
    {
        if (string.IsNullOrWhiteSpace(_nombre) || string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _mensaje = "Completa nombre, correo y contraseña.";
            _mensajeEsError = true;
            return;
        }

        if (_password.Length < 8)
        {
            _mensaje = "La contraseña debe tener al menos 8 caracteres.";
            _mensajeEsError = true;
            return;
        }

        _creando = true;
        _mensaje = null;

        var result = await AdminAccountService.CrearAdminAsync(_email.Trim(), _password, _nombre.Trim());

        _creando = false;

        if (result.Success)
        {
            _mensaje = "Cuenta creada correctamente.";
            _mensajeEsError = false;
            _nombre = "";
            _email = "";
            _password = "";
            await Cargar();
        }
        else
        {
            _mensaje = result.ErrorMessage;
            _mensajeEsError = true;
        }
    }

    private async Task Suspender(int usuarioId)
    {
        _procesando = usuarioId;
        StateHasChanged();

        await AdminAccountService.SuspenderAsync(usuarioId, _adminId, "Suspendida por otro administrador");
        await Cargar();

        _procesando = null;
    }

    private async Task Reactivar(int usuarioId)
    {
        _procesando = usuarioId;
        StateHasChanged();

        await AdminAccountService.ReactivarAsync(usuarioId, _adminId);
        await Cargar();

        _procesando = null;
    }

    private static string Iniciales(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
            return "";

        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(partes.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }
}
