@page "/eliminaciones"
@layout CUIDAPP_ADMINISTRATIVO.Components.Layout.AdminLayout
@inject PanelApiService Api
@inject ConfirmacionService Confirmacion
@inject AvisoToastService Toasts

<PageTitle>Cuentas eliminadas · Cuidapp Admin</PageTitle>

<div class="pn-page">
    <div class="pn-toolbar">
        <div class="pn-seg">
            @foreach (var (id, texto) in Grupos)
            {
                <button type="button" class="@(_estado == id ? "on" : "")" @onclick="() => { _estado = id; _pagina = 1; }">@texto <span class="pn-seg-n">@(_filas?.Count(f => f.Estado == id) ?? 0)</span></button>
            }
        </div>
        <span class="pn-grow"></span>
        <input class="pn-input" placeholder="Buscar nombre o correo…" @bind="_buscar" @bind:event="oninput" style="width:240px;" />
    </div>

    <div class="pn-callout tone-info">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 16v-4m0-4h.01M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z"></path></svg>
        <span>Al pedir la eliminación, la cuenta se desactiva al instante. A los <b>30 días</b> se borran sus datos personales; se conservan servicios, pagos, contratos firmados y disputas sin esos datos. Antes de esa fecha el usuario puede recuperarla iniciando sesión, o soporte puede cancelarla aquí.</span>
    </div>

    <div class="adm-card overflow-hidden">
        @if (_filas == null)
        {
            <Esqueleto Filas="6" />
        }
        else if (!Visibles().Any())
        {
            <EstadoVacio Titulo="Nada en esta vista" Icono="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
        }
        else
        {
            <div class="pn-table-wrap">
                <table class="pn-table">
                    <thead><tr><th>Usuario</th><th>Pedida</th><th>@(_estado == 2 ? "Cancelada" : _estado == 3 ? "Borrada" : "Se borra")</th><th>Motivo</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var f in Paginador.Cortar(Visibles().ToList(), _pagina, 20))
                        {
                            <tr>
                                <td>
                                    <a class="pn-who" href="@(f.Rol == 3 ? $"care-partners/{f.UsuarioId}" : $"clientes/{f.UsuarioId}")" style="text-decoration:none; color:inherit;">
                                        <Avatar Nombre="@(f.NombreCompleto ?? "Usuario")" Tam="30" />
                                        <span class="pn-who-text"><span>@(f.NombreCompleto ?? $"Usuario #{f.UsuarioId}")</span><span class="pn-muted">@(f.Rol == 3 ? "Care Partner" : "Cliente") · @f.Email</span></span>
                                    </a>
                                </td>
                                <td>@f.FechaSolicitud.ToString("dd MMM yyyy")<div class="pn-muted" style="font-size:11.5px;">Desde @(f.Origen == "web" ? "la web" : "la app")</div></td>
                                <td>
                                    @if (f.Estado == 1)
                                    {
                                        var dias = (int)Math.Ceiling((f.FechaEjecucion - Ahora).TotalDays);
                                        <span class="pn-strong">@f.FechaEjecucion.ToString("dd MMM yyyy")</span>
                                        <div style="font-size:11.5px; font-weight:600; color:@(dias <= 3 ? "var(--danger)" : "var(--adm-muted-2)");">@(dias <= 0 ? "En la próxima hora" : $"Faltan {dias} día(s)")</div>
                                    }
                                    else if (f.Estado == 2)
                                    {
                                        <span>@f.FechaCancelacion?.ToString("dd MMM yyyy")</span>
                                        <div class="pn-muted" style="font-size:11.5px;">Por @(f.CanceladaPor == "admin" ? "soporte" : "el usuario")</div>
                                    }
                                    else { <span>@f.FechaEjecucion.ToString("dd MMM yyyy")</span> }
                                </td>
                                <td style="max-width:280px;">
                                    <span class="@(string.IsNullOrWhiteSpace(f.Motivo) ? "pn-muted" : "")">@(string.IsNullOrWhiteSpace(f.Motivo) ? "Sin motivo" : f.Motivo)</span>
                                    @if (!string.IsNullOrWhiteSpace(f.NotaAdmin)) { <div class="pn-muted" style="font-size:11.5px;">Nota: @f.NotaAdmin</div> }
                                </td>
                                <td class="pn-num">
                                    @if (f.Estado == 1 && _puedeOperar)
                                    {
                                        <button type="button" class="pn-btn pn-btn-quiet pn-btn-sm" disabled="@_procesando" @onclick="() => Cancelar(f)">Cancelar eliminación</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Paginador Pagina="_pagina" Tamano="20" Total="Visibles().Count()" PaginaCambiada="p => _pagina = p" />
        }
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly (int Id, string Texto)[] Grupos = { (1, "Programadas"), (2, "Canceladas"), (3, "Borradas") };

    private List<EliminacionCuentaFila>? _filas;
    private int _estado = 1;
    private string _buscar = "";
    private int _pagina = 1;
    private bool _procesando, _puedeOperar;

    private static DateTime Ahora => DateTime.UtcNow.AddHours(-4);

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null) _puedeOperar = SesionAdmin.PuedeOperar((await AuthStateTask).User);
        await Cargar();
    }

    private async Task Cargar() => _filas = await Api.EliminacionesAsync() ?? new();

    private IEnumerable<EliminacionCuentaFila> Visibles()
    {
        var b = _buscar.Trim();
        var filas = (_filas ?? new())
            .Where(f => f.Estado == _estado)
            .Where(f => b.Length == 0 || (f.NombreCompleto ?? "").Contains(b, StringComparison.OrdinalIgnoreCase) || (f.Email ?? "").Contains(b, StringComparison.OrdinalIgnoreCase));
        // Programadas: la más próxima a borrarse primero. Resto: lo más reciente primero.
        return _estado == 1 ? filas.OrderBy(f => f.FechaEjecucion) : filas.OrderByDescending(f => f.FechaCancelacion ?? f.FechaEjecucion);
    }

    private async Task Cancelar(EliminacionCuentaFila f)
    {
        var nota = await Confirmacion.PedirMotivoAsync("¿Cancelar la eliminación?",
            $"La cuenta de {f.NombreCompleto} se reactiva y no se borrará. Hazlo solo si el usuario lo pidió a soporte.", "Cancelar eliminación", "Nota", peligro: false);
        if (nota == null) return;
        _procesando = true;
        var r = await Api.CancelarEliminacionAsync(f.Id, nota);
        _procesando = false;
        Toasts.Mostrar(r);
        if (r.Ok) await Cargar();
    }
}
