@page "/vencimientos"
@layout CUIDAPP_ADMINISTRATIVO.Components.Layout.AdminLayout
@inject PanelApiService Api
@inject ConfirmacionService Confirmacion
@inject AvisoToastService Toasts

<PageTitle>Documentos · Cuidapp Admin</PageTitle>

<div class="pn-page">
    <div class="pn-toolbar">
        <div class="pn-seg">
            @foreach (var (id, texto) in Grupos)
            {
                <button type="button" class="@(_grupo == id ? "on" : "")" @onclick="() => { _grupo = id; _pagina = 1; }">@texto <span class="pn-seg-n">@Cuenta(id)</span></button>
            }
        </div>
        <span class="pn-grow"></span>
        <input class="pn-input" placeholder="Buscar Care Partner o documento…" @bind="_buscar" @bind:event="oninput" style="width:240px;" />
    </div>

    <div class="pn-callout tone-info">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 16v-4m0-4h.01M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z"></path></svg>
        <span>Ponle fecha de vencimiento a los documentos que caducan (cédula, buena conducta, certificado médico). Se avisa al Care Partner 30 y 7 días antes; el día que vence, el documento pasa a rechazado para que suba uno nuevo desde la app y queda <b>oculto</b> hasta que apruebes el nuevo aquí, en <b>Por revisar</b>.</span>
    </div>

    <div class="adm-card overflow-hidden">
        @if (_docs == null)
        {
            <Esqueleto Filas="6" />
        }
        else if (!Visibles().Any())
        {
            <EstadoVacio Titulo="@(_grupo == "revisar" ? "Nada por revisar" : "Sin documentos en esta vista")" Texto="@(_grupo == "vencidos" ? "Ningún documento vencido. 👌" : null)" Icono="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.6a1 1 0 0 1 .7.3l5.4 5.4a1 1 0 0 1 .3.7V19a2 2 0 0 1-2 2Z" />
        }
        else
        {
            <div class="pn-table-wrap">
                <table class="pn-table">
                    <thead><tr><th>Care Partner</th><th>Documento</th><th>Vence</th><th>Estado</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var d in Paginador.Cortar(Visibles().ToList(), _pagina, 20))
                        {
                            <tr>
                                <td>
                                    <a class="pn-who" href="care-partners/@d.CuidadorId" style="text-decoration:none; color:inherit;">
                                        <Avatar Url="@Api.Archivo(d.FotoUrl)" Nombre="@d.Nombre" Tam="30" />
                                        <span class="pn-who-text"><span>@d.Nombre</span><span class="pn-muted">@(d.Disponible == true ? "Visible" : "Oculto")</span></span>
                                    </a>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(d.UrlArchivo))
                                    {
                                        <a class="pn-link" href="@Api.Archivo(d.UrlArchivo)" target="_blank" rel="noopener">@d.TipoDocumento</a>
                                    }
                                    else { <span>@d.TipoDocumento</span> }
                                    @if (d.FechaSubida is { } fs) { <div class="pn-muted" style="font-size:11.5px;">Subido @fs.ToString("dd MMM yyyy")</div> }
                                </td>
                                <td>
                                    @if (_editando == d.Id)
                                    {
                                        <span class="d-inline-flex align-items-center" style="gap:6px;">
                                            <input class="pn-input" type="date" @bind="_fecha" style="width:150px;" />
                                            <button type="button" class="pn-btn pn-btn-primary pn-btn-sm" disabled="@_procesando" @onclick="() => GuardarFecha(d)">Guardar</button>
                                            <button type="button" class="pn-btn pn-btn-quiet pn-btn-sm" @onclick="() => _editando = null">×</button>
                                        </span>
                                    }
                                    else if (d.FechaVencimiento is { } fv)
                                    {
                                        <span class="pn-strong">@fv.ToString("dd MMM yyyy")</span>
                                        <div style="font-size:11.5px; font-weight:600; color:@ColorDias(d.DiasRestantes);">@TextoDias(d.DiasRestantes)</div>
                                    }
                                    else { <span class="pn-muted">Sin fecha</span> }
                                </td>
                                <td>
                                    @if (d.Estado == 1) { <span class="pn-pill tone-violet">Renovado · por revisar</span> }
                                    else if (d.Estado == 3) { <span class="pn-pill tone-danger" title="@d.ObservacionesAdmin">Esperando uno nuevo</span> }
                                    else if (d.DiasRestantes < 0) { <span class="pn-pill tone-danger">Vencido</span> }
                                    else if (d.DiasRestantes <= 30) { <span class="pn-pill tone-warn">@(d.AvisoVencimiento > 0 ? "Avisado" : "Por vencer")</span> }
                                    else { <span class="pn-pill tone-ok">Vigente</span> }
                                </td>
                                <td class="pn-num">
                                    @if (_puedeOperar && _editando != d.Id)
                                    {
                                        <span class="d-inline-flex" style="gap:6px;">
                                            @if (d.Estado == 1)
                                            {
                                                <button type="button" class="pn-btn pn-btn-ok pn-btn-sm" disabled="@_procesando" @onclick="() => Aprobar(d)">Aprobar</button>
                                                <button type="button" class="pn-btn pn-btn-danger-soft pn-btn-sm" disabled="@_procesando" @onclick="() => Rechazar(d)">Rechazar</button>
                                            }
                                            else if (d.Estado == 2)
                                            {
                                                <button type="button" class="pn-btn pn-btn-quiet pn-btn-sm" @onclick="() => Editar(d)">@(d.FechaVencimiento == null ? "Poner fecha" : "Cambiar")</button>
                                            }
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Paginador Pagina="_pagina" Tamano="20" Total="Visibles().Count()" PaginaCambiada="p => _pagina = p" />
        }
    </div>
</div>

@if (_aprobando != null)
{
    <div class="pn-overlay" @onclick="() => _aprobando = null">
        <div class="pn-dialog" role="dialog" aria-modal="true" aria-labelledby="ap-t" @onclick:stopPropagation="true">
            <h2 id="ap-t" class="pn-dialog-title">Aprobar @_aprobando.TipoDocumento</h2>
            <p class="pn-dialog-text">De @_aprobando.Nombre. Indica hasta cuándo es válido el documento nuevo (déjalo vacío si no vence).</p>
            <label class="pn-label" for="ap-f">Vence el</label>
            <input id="ap-f" class="pn-input" type="date" @bind="_fecha" />
            <div class="pn-dialog-actions">
                <button type="button" class="pn-btn pn-btn-quiet" @onclick="() => _aprobando = null">Cancelar</button>
                <button type="button" class="pn-btn pn-btn-ok" disabled="@(_procesando || (_fecha != null && _fecha <= Hoy))" @onclick="ConfirmarAprobar">Aprobar</button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly (string Id, string Texto)[] Grupos =
        { ("revisar", "Por revisar"), ("vencidos", "Vencidos"), ("pronto", "Próximos 30 días"), ("sinfecha", "Sin fecha"), ("vigentes", "Vigentes") };

    private List<DocumentoVencimiento>? _docs;
    private string _grupo = "pronto";
    private string _buscar = "";
    private int _pagina = 1;
    private int? _editando;
    private DateTime? _fecha;
    private DocumentoVencimiento? _aprobando;
    private bool _procesando, _puedeOperar;

    private static DateTime Hoy => DateTime.UtcNow.AddHours(-4).Date;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null) _puedeOperar = SesionAdmin.PuedeVerificar((await AuthStateTask).User);
        await Cargar();
        // Abre en la vista con más urgencia.
        _grupo = new[] { "revisar", "vencidos", "pronto" }.FirstOrDefault(g => Cuenta(g) > 0) ?? "sinfecha";
    }

    private async Task Cargar() => _docs = await Api.VencimientosAsync() ?? new();

    private int Cuenta(string grupo) => _docs?.Count(d => d.Grupo == grupo) ?? 0;

    private IEnumerable<DocumentoVencimiento> Visibles() => (_docs ?? new())
        .Where(d => d.Grupo == _grupo)
        .Where(d => string.IsNullOrWhiteSpace(_buscar) || d.Nombre.Contains(_buscar.Trim(), StringComparison.OrdinalIgnoreCase) || d.TipoDocumento.Contains(_buscar.Trim(), StringComparison.OrdinalIgnoreCase));

    private static string TextoDias(int? dias) => dias switch
    {
        null => "",
        < 0 => $"Venció hace {-dias} día(s)",
        0 => "Vence hoy",
        1 => "Vence mañana",
        _ => $"Faltan {dias} días"
    };

    private static string ColorDias(int? dias) => dias switch { < 0 => "var(--danger)", <= 7 => "var(--danger)", <= 30 => "var(--warn)", _ => "var(--adm-muted-2)" };

    private void Editar(DocumentoVencimiento d)
    {
        _editando = d.Id;
        _fecha = d.FechaVencimiento ?? Hoy.AddYears(1);
    }

    private async Task GuardarFecha(DocumentoVencimiento d)
    {
        if (_fecha is { } f && f <= Hoy && !await Confirmacion.PreguntarAsync("¿Fecha pasada?",
                "Con esa fecha el documento queda vencido y el Care Partner se ocultará en la próxima revisión (cada hora).", "Guardar igual", peligro: true))
            return;
        _procesando = true;
        var r = await Api.FijarVencimientoAsync(d.Id, _fecha);
        _procesando = false;
        Toasts.Mostrar(r);
        if (r.Ok) { _editando = null; await Cargar(); }
    }

    private void Aprobar(DocumentoVencimiento d)
    {
        _aprobando = d;
        _fecha = Hoy.AddYears(1);
    }

    private async Task ConfirmarAprobar()
    {
        if (_aprobando == null) return;
        _procesando = true;
        var r = await Api.RevisarDocumentoAsync(_aprobando.Id, true, _fecha, null);
        _procesando = false;
        Toasts.Mostrar(r);
        if (r.Ok) { _aprobando = null; await Cargar(); }
    }

    private async Task Rechazar(DocumentoVencimiento d)
    {
        var motivo = await Confirmacion.PedirMotivoAsync($"¿Rechazar {d.TipoDocumento}?",
            $"{d.Nombre} recibirá el motivo en su teléfono y podrá subir otro desde la app.", "Rechazar");
        if (motivo == null) return;
        _procesando = true;
        var r = await Api.RevisarDocumentoAsync(d.Id, false, null, motivo);
        _procesando = false;
        Toasts.Mostrar(r);
        if (r.Ok) await Cargar();
    }
}
