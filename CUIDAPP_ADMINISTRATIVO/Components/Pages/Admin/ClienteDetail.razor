@page "/clientes/{Id:int}"
@layout CUIDAPP_ADMINISTRATIVO.Components.Layout.AdminLayout
@using System.Security.Claims
@using CUIDAPP_ADMINISTRATIVO.Models.Cliente
@using CUIDAPP_ADMINISTRATIVO.Models.Cuidador
@inject ClienteAdminApiService ClienteService
@inject PanelApiService Api
@inject ConfirmacionService Confirmacion
@inject AvisoToastService Toasts
@inject NavigationManager Nav

<PageTitle>@(_cliente?.NombreCompleto ?? "Cliente") · Cuidapp Admin</PageTitle>

<div class="pn-page">
    <a href="clientes" class="adm-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m15 18-6-6 6-6"></path></svg>
        Volver a Clientes
    </a>

    @if (_cargando && _cliente == null)
    {
        <div class="adm-card"><Esqueleto Filas="6" /></div>
    }
    else if (_cliente is null)
    {
        <div class="adm-card"><EstadoVacio Titulo="Cliente no encontrado" Texto="Puede que la cuenta ya no exista." /></div>
    }
    else
    {
        var c = _cliente;
        var tel = _ficha?.Persona.Telefono;

        @* ---------- Encabezado ---------- *@
        <div class="adm-card pn-perfil">
            <div class="pn-perfil-cover @(c.IsActive ? "" : "is-off")"></div>
            <div class="pn-perfil-main">
                <span class="pn-perfil-foto"><Avatar Url="@Api.Archivo(c.FotoUrl)" Nombre="@c.NombreCompleto" Tam="88" /></span>
                <div class="pn-perfil-info">
                    <div class="d-flex flex-wrap align-items-center" style="gap:8px;">
                        <span class="pn-perfil-nombre">@c.NombreCompleto</span>
                        <span class="pn-pill tone-info no-dot">Cliente</span>
                        @if (!c.IsActive) { <span class="pn-pill tone-danger">@(Vigente?.Tipo == "TEMPORAL" ? "Suspendido" : "Baneado")</span> }
                        else { <span class="pn-pill tone-ok">Activo</span> }
                    </div>
                    <div class="pn-perfil-meta">
                        <a href="mailto:@c.Email">@c.Email</a>
                        @if (!string.IsNullOrWhiteSpace(tel)) { <a href="tel:@tel">@tel</a> }
                        <span>Desde @c.FechaCreacion.ToString("MMM yyyy", Es)</span>
                    </div>
                </div>
                <div class="pn-perfil-acciones">
                    @if (!string.IsNullOrWhiteSpace(tel))
                    {
                        <a class="pn-btn pn-btn-quiet pn-btn-sm" href="https://wa.me/1@(Digitos(tel))" target="_blank" rel="noopener">WhatsApp</a>
                        <a class="pn-btn pn-btn-quiet pn-btn-sm" href="tel:@tel">Llamar</a>
                    }
                    @if (_puedeOperar)
                    {
                        <button type="button" class="pn-btn pn-btn-primary pn-btn-sm" @onclick="EnviarAviso">Enviar aviso</button>
                    }
                </div>
            </div>
            <div class="pn-perfil-stats">
                <div><span class="k">Solicitados</span><span class="v">@c.TotalServiciosSolicitados</span><span class="pn-muted">servicios</span></div>
                <div><span class="k">Completados</span><span class="v">@c.ServiciosCompletados</span><span class="pn-muted">@Porcentaje(c.ServiciosCompletados, c.TotalServiciosSolicitados) del total</span></div>
                <div><span class="k">Cancelados</span><span class="v">@(_servicios?.Count(s => s.Estado == 5) ?? 0)</span><span class="pn-muted">servicios</span></div>
                <div><span class="k">Gastado</span><span class="v">RD$ @((_servicios?.Where(s => s.Estado == 4).Sum(s => s.Tarifa) ?? 0).ToString("N0"))</span><span class="pn-muted">en completados</span></div>
                <div><span class="k">Disputas</span><span class="v" style="color:@(Disputas > 0 ? "var(--warn)" : "inherit");">@Disputas</span><span class="pn-muted">rechazos del final</span></div>
            </div>
        </div>

        <div class="pn-ficha-layout">
            <div class="d-flex flex-column" style="gap:16px; min-width:0;">
                <div class="pn-seg" style="align-self:flex-start;">
                    <button type="button" class="@(_tab == "resumen" ? "on" : "")" @onclick="@(() => _tab = "resumen")">Resumen</button>
                    <button type="button" class="@(_tab == "servicios" ? "on" : "")" @onclick="@(() => _tab = "servicios")">Servicios <span class="pn-seg-n">@(_serviciosError ? "—" : (_servicios?.Count ?? 0).ToString())</span></button>
                    @if (_puedeOperar) { <button type="button" class="@(_tab == "editar" ? "on" : "")" @onclick="@(() => _tab = "editar")">Editar</button> }
                </div>

                @switch (_tab)
                {
                    case "resumen":
                        <div class="adm-card adm-card-pad d-flex flex-column" style="gap:18px;">
                            <span class="adm-card-title">Datos</span>
                            <dl class="pn-datos">
                                <div><dt>Correo</dt><dd>@c.Email</dd></div>
                                <div><dt>Teléfono</dt><dd>@(tel ?? "—")</dd></div>
                                <div><dt>Dirección principal</dt><dd>@(c.DireccionPrincipal ?? "—")</dd></div>
                                <div><dt>Registrado</dt><dd>@c.FechaCreacion.ToString("d 'de' MMMM yyyy", Es)</dd></div>
                                <div><dt>Último servicio</dt><dd>@(_servicios?.FirstOrDefault()?.Fecha.ToString("d MMM yyyy", Es) ?? "—")</dd></div>
                                <div><dt>Care Partner más frecuente</dt><dd>@(Frecuente() ?? "—")</dd></div>
                            </dl>
                        </div>
                        @if (_servicios?.Count > 0)
                        {
                            <div class="adm-card overflow-hidden">
                                <div class="pn-card-head"><span class="adm-card-title">Últimos servicios</span><button type="button" class="pn-btn pn-btn-quiet pn-btn-sm" @onclick="@(() => _tab = "servicios")">Ver todos</button></div>
                                @TablaServicios(_servicios.Take(5))
                            </div>
                        }
                        break;

                    case "servicios":
                        <div class="adm-card overflow-hidden">
                            @if (_serviciosError) { <EstadoVacio Titulo="No se pudo cargar el historial" Texto="El servidor todavía no tiene esta función: aparece cuando se publique la API nueva." /> }
                            else if (_servicios == null) { <Esqueleto Filas="5" ConAvatar="false" /> }
                            else if (_servicios.Count == 0) { <EstadoVacio Titulo="Todavía no ha pedido servicios" /> }
                            else
                            {
                                @TablaServicios(Paginador.Cortar(_servicios, _pagServ, 15))
                                <Paginador Pagina="_pagServ" Tamano="15" Total="_servicios.Count" PaginaCambiada="x => _pagServ = x" />
                            }
                        </div>
                        break;

                    case "editar":
                        <div class="adm-card adm-card-pad d-flex flex-column" style="gap:16px;">
                            <div class="d-flex flex-column" style="gap:2px;">
                                <span class="adm-card-title">Editar información</span>
                                <span class="adm-card-sub">Los cambios se ven de inmediato en la app del cliente.</span>
                            </div>
                            <div class="pn-grid-2-eq" style="display:grid; gap:14px;">
                                <div><label class="pn-label" for="e-n">Nombre completo</label><input id="e-n" class="adm-input" maxlength="150" @bind="_editNombre" /></div>
                                <div><label class="pn-label" for="e-d">Dirección principal</label><input id="e-d" class="adm-input" maxlength="300" @bind="_editDireccion" /></div>
                                <div><label class="pn-label" for="e-cn">Contacto de emergencia</label><input id="e-cn" class="adm-input" maxlength="150" @bind="_editContactoNombre" /></div>
                                <div><label class="pn-label" for="e-ct">Teléfono de emergencia</label><input id="e-ct" class="adm-input" type="tel" inputmode="tel" maxlength="20" @bind="_editContactoTelefono" /></div>
                            </div>
                            <div class="d-flex" style="gap:8px;">
                                <button type="button" class="pn-btn pn-btn-primary" disabled="@(_guardando || !HayCambios)" @onclick="GuardarInfo">@(_guardando ? "Guardando…" : "Guardar cambios")</button>
                                <button type="button" class="pn-btn pn-btn-quiet" disabled="@(!HayCambios)" @onclick="RestaurarEdicion">Descartar</button>
                            </div>
                        </div>
                        break;
                }
            </div>

            <div class="d-flex flex-column" style="gap:16px; min-width:0;">
                <GestionCuenta UsuarioId="Id" Nombre="@c.NombreCompleto" EsCuidador="false" Activa="c.IsActive" PuedeOperar="_puedeOperar"
                               ServiciosPendientes="Pendientes" Sanciones="_sanciones"
                               Suspender="(motivo, fin) => ClienteService.SuspenderAsync(Id, _adminId, motivo, fin)"
                               ReactivarCuenta="() => ClienteService.ReactivarAsync(Id, _adminId)"
                               Cambio="Cargar" />

                <div class="adm-card adm-card-pad d-flex flex-column" style="gap:6px;">
                    <span class="adm-card-title">Contacto de emergencia</span>
                    @if (string.IsNullOrWhiteSpace(c.ContactoEmergenciaNombre))
                    {
                        <span class="pn-muted">No ha registrado uno.</span>
                    }
                    else
                    {
                        <span style="font-size:14px;">@c.ContactoEmergenciaNombre</span>
                        @if (!string.IsNullOrWhiteSpace(c.ContactoEmergenciaTelefono)) { <a class="pn-link" href="tel:@c.ContactoEmergenciaTelefono">@c.ContactoEmergenciaTelefono</a> }
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly System.Globalization.CultureInfo Es = new("es-DO");

    private ClienteAdmin? _cliente;
    private FichaMapa? _ficha;
    private List<SancionCuidador> _sanciones = new();
    private List<ServicioFila>? _servicios;
    private bool _serviciosError;
    private bool _cargando = true, _guardando, _puedeOperar;
    private int _adminId, _pagServ = 1;
    private string _tab = "resumen";
    private string _editNombre = "", _editDireccion = "", _editContactoNombre = "", _editContactoTelefono = "";

    private SancionCuidador? Vigente => _sanciones.FirstOrDefault(x => x.Estado == "VIGENTE");
    private int Pendientes => _servicios?.Count(s => s.ClienteId == Id && s.Estado is 1 or 2 or 3 or 7) ?? 0;
    private int Disputas => _servicios?.Count(s => s.RechazadoPorCliente || s.PagoDisputado) ?? 0;

    private bool HayCambios => _cliente != null && (_editNombre.Trim() != _cliente.NombreCompleto || _editDireccion.Trim() != (_cliente.DireccionPrincipal ?? "")
        || _editContactoNombre.Trim() != (_cliente.ContactoEmergenciaNombre ?? "") || _editContactoTelefono.Trim() != (_cliente.ContactoEmergenciaTelefono ?? ""));

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask != null)
        {
            var user = (await AuthStateTask).User;
            _adminId = int.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
            _puedeOperar = SesionAdmin.PuedeOperar(user);
        }
        await Cargar();
    }

    private async Task Cargar()
    {
        _cargando = true;
        var detalle = ClienteService.ObtenerDetalleAsync(Id);
        var sanciones = ClienteService.ObtenerSancionesAsync(Id);
        var ficha = Api.FichaMapaAsync(Id);
        var servicios = Api.ServiciosUsuarioAsync(Id);
        await Task.WhenAll(detalle, sanciones, ficha, servicios);

        _cliente = detalle.Result;
        _sanciones = sanciones.Result;
        _ficha = ficha.Result;
        _servicios = servicios.Result;
        _serviciosError = _servicios == null;
        RestaurarEdicion();
        _cargando = false;
    }

    private void RestaurarEdicion()
    {
        if (_cliente == null) return;
        _editNombre = _cliente.NombreCompleto;
        _editDireccion = _cliente.DireccionPrincipal ?? "";
        _editContactoNombre = _cliente.ContactoEmergenciaNombre ?? "";
        _editContactoTelefono = _cliente.ContactoEmergenciaTelefono ?? "";
    }

    private string? Frecuente() => _servicios?.Where(s => s.Estado == 4).GroupBy(s => s.CuidadorNombre)
        .OrderByDescending(g => g.Count()).Select(g => $"{g.Key} ({g.Count()})").FirstOrDefault();

    private static string Porcentaje(int a, int b) => b == 0 ? "0%" : $"{100.0 * a / b:0}%";
    private static string Digitos(string t) => new(t.Where(char.IsDigit).ToArray());

    private RenderFragment TablaServicios(IEnumerable<ServicioFila> filas) => __builder =>
    {
        <div class="pn-table-wrap">
            <table class="pn-table">
                <thead><tr><th>Servicio</th><th>Fecha</th><th>Care Partner</th><th>Estado</th><th class="pn-num">Tarifa</th></tr></thead>
                <tbody>
                    @foreach (var s in filas)
                    {
                        <tr class="pn-row-link" @onclick="@(() => Nav.NavigateTo($"servicios/{s.Id}"))">
                            <td><span class="pn-strong">@s.TipoServicio</span><div class="pn-muted" style="font-size:11.5px;">#@s.Id</div></td>
                            <td>@s.Fecha.ToString("dd MMM yyyy")<div class="pn-muted" style="font-size:11.5px;">@s.HoraInicio – @s.HoraFin</div></td>
                            <td>@s.CuidadorNombre</td>
                            <td>
                                <span class="pn-pill @EstadoServicio.Tono(s.Estado)">@EstadoServicio.Texto(s.Estado)</span>
                                @if (s.TieneSos) { <span class="pn-pill tone-danger no-dot" style="margin-left:4px;">SOS</span> }
                            </td>
                            <td class="pn-num">RD$ @s.Tarifa.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };

    private async Task EnviarAviso()
    {
        var texto = await Confirmacion.PedirMotivoAsync($"Aviso para {_cliente!.NombreCompleto}",
            "Le llega como notificación al teléfono.", "Enviar", "Mensaje", peligro: false);
        if (texto == null) return;
        Toasts.Mostrar(await Api.NotificarAsync(new[] { Id }, "Mensaje de CuidApp", texto));
    }

    private async Task GuardarInfo()
    {
        if (string.IsNullOrWhiteSpace(_editNombre))
        {
            Toasts.Mostrar("El nombre no puede quedar vacío.", false);
            return;
        }
        _guardando = true;
        var ok = await ClienteService.ActualizarInfoAsync(Id, _editNombre.Trim(),
            string.IsNullOrWhiteSpace(_editDireccion) ? null : _editDireccion.Trim(),
            string.IsNullOrWhiteSpace(_editContactoNombre) ? null : _editContactoNombre.Trim(),
            string.IsNullOrWhiteSpace(_editContactoTelefono) ? null : _editContactoTelefono.Trim());
        _guardando = false;
        Toasts.Mostrar(ok ? "Información actualizada." : "No se pudo guardar. Intenta de nuevo.", ok);
        if (ok) await Cargar();
    }
}
