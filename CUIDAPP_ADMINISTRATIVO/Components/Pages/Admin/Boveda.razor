@page "/boveda"
@layout CUIDAPP_ADMINISTRATIVO.Components.Layout.AdminLayout
@inject PanelApiService Api
@inject ConfirmacionService Confirmacion
@inject IJSRuntime JS

<PageTitle>Bóveda de contratos · Cuidapp Admin</PageTitle>

<div class="pn-page">
    @if (!_acceso)
    {
        <div class="adm-card"><EstadoVacio Titulo="Sin acceso" Texto="La bóveda solo la pueden abrir Superadmin y Legal y Dirección." Icono="M12 15v2m-6 4h12a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2Zm10-10V7a4 4 0 0 0-8 0v4h8Z" /></div>
    }
    else
    {
        <div class="pn-callout tone-info">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 15v2m-6 4h12a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2Zm10-10V7a4 4 0 0 0-8 0v4h8Z"></path></svg>
            <span>Cuando una cuenta se elimina, sus <b>contratos firmados</b> se guardan aquí intactos (nombre, cédula y firma) y <b>cifrados</b>, como respaldo ante reclamaciones. Solo Superadmin y Legal y Dirección pueden abrirlos; cada apertura pide un motivo y queda registrada. Antes de mostrarlo se comprueba que el archivo no fue alterado.</span>
        </div>

        <div class="adm-card overflow-hidden">
            @if (_docs == null)
            {
                <Esqueleto Filas="5" />
            }
            else if (_docs.Count == 0)
            {
                <EstadoVacio Titulo="La bóveda está vacía" Texto="Aquí aparecerán los contratos de las cuentas que se eliminen." Icono="M12 15v2m-6 4h12a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2Zm10-10V7a4 4 0 0 0-8 0v4h8Z" />
            }
            else
            {
                <div class="pn-table-wrap">
                    <table class="pn-table">
                        <thead><tr><th>Contrato</th><th>Firmado</th><th>En la bóveda desde</th><th>Cuentas eliminadas</th><th>Huella (SHA-256)</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var d in Paginador.Cortar(_docs, _pagina, 20))
                            {
                                <tr>
                                    <td><span class="pn-strong">Contrato #@d.ContratoId</span><div class="pn-muted" style="font-size:11.5px;">Documento #@d.DocumentoId · @Tamano(d.TamanoBytes)</div></td>
                                    <td>@(d.FechaFirma?.ToString("dd MMM yyyy") ?? "—")</td>
                                    <td>@(d.FechaBoveda?.ToString("dd MMM yyyy") ?? "—")</td>
                                    <td>@(d.UsuariosIdEliminados.Count == 0 ? "En proceso" : string.Join(", ", d.UsuariosIdEliminados.Select(u => $"#{u}")))</td>
                                    <td><code style="font-size:11.5px;" title="@d.Sha256">@Corto(d.Sha256)</code></td>
                                    <td class="pn-num"><button type="button" class="pn-btn pn-btn-primary pn-btn-sm" @onclick="() => Abrir(d)">Abrir</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Paginador Pagina="_pagina" Tamano="20" Total="_docs.Count" PaginaCambiada="p => _pagina = p" />
            }
        </div>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<DocumentoBoveda>? _docs;
    private bool _acceso;
    private int _pagina = 1;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
            _acceso = SesionAdmin.Nivel((await AuthStateTask).User) is SesionAdmin.Superadmin or SesionAdmin.Legal;
        if (_acceso)
            _docs = (await Api.BovedaAsync() ?? new()).OrderByDescending(d => d.FechaBoveda).ToList();
    }

    private static string Tamano(long? bytes) => bytes is { } b ? (b >= 1048576 ? $"{b / 1048576d:N1} MB" : $"{Math.Max(1, b / 1024)} KB") : "";

    private static string Corto(string? hash) => string.IsNullOrEmpty(hash) || hash.Length < 16 ? hash ?? "" : $"{hash[..8]}…{hash[^8..]}";

    private async Task Abrir(DocumentoBoveda d)
    {
        var motivo = await Confirmacion.PedirMotivoAsync($"Abrir el contrato #{d.ContratoId}",
            "Contiene datos personales de una cuenta eliminada. Indica para qué lo necesitas: queda registrado junto con tu nombre y la hora.",
            "Abrir contrato", "Motivo", peligro: false, minimo: 10);
        if (motivo == null) return;
        await JS.InvokeVoidAsync("open", $"boveda/pdf/{d.DocumentoId}?motivo={Uri.EscapeDataString(motivo)}", "_blank", "noopener");
    }
}
