        new("servicios", "Servicios", "servicios", "M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2ZM9 16l2 2 4-4", Niveles: N.NoKyc, Grupo: "servicios"),
