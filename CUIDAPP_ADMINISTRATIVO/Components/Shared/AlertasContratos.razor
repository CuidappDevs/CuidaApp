@inject PanelApiService Api
@inject AuthenticationStateProvider Auth
@* Alertas de contratos fijos. Solo se muestra si hay alguna: sin alertas no ocupa lugar. *@
@if (_puedeOperar && _alertas is { Count: > 0 })
{
    <section class="pn-callout tone-warn pn-alertas-contratos" aria-label="Alertas de contratos">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path><path d="M12 9v4m0 4h.01"></path></svg>
        <div class="d-flex flex-column" style="gap:8px; flex:1; min-width:0;">
            <span><b>@_alertas.Count @(_alertas.Count == 1 ? "alerta" : "alertas") en contratos fijos</b> · revísalas antes de que afecten las jornadas.</span>
            <ul class="pn-alertas-lista">
                @foreach (var a in _alertas)
                {
                    <li>
                        <a class="pn-link pn-strong" href="contratos/@a.ContratoId">CF-@a.ContratoId.ToString("D5")</a>
                        <span>@a.Texto</span>
                        @if (a.Cantidad > 1) { <span class="pn-pill tone-warn no-dot">@a.Cantidad</span> }
                    </li>
                }
            </ul>
        </div>
        <a class="pn-btn pn-btn-quiet pn-btn-sm" href="contratos">Ver contratos</a>
    </section>
}
@code {
    private bool _puedeOperar;
    private List<AlertaContrato>? _alertas;
    protected override async Task OnInitializedAsync()
    {
        _puedeOperar = SesionAdmin.PuedeOperar((await Auth.GetAuthenticationStateAsync()).User);
        if (_puedeOperar) _alertas = await Api.AlertasContratosAsync();
    }
}
