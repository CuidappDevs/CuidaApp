<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:CUIDAPP.Localization"
             x:Class="CUIDAPP.Views.Contratos.PermisoContratarPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ColorBackground}"
             SafeAreaEdges="None">

    <Grid RowDefinitions="Auto, *" SafeAreaEdges="None">

        <!-- ENCABEZADO (borde a borde) -->
        <Grid Grid.Row="0" SafeAreaEdges="None" Padding="0,0,0,40">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#2A63B8" Offset="0.0" />
                    <GradientStop Color="{StaticResource ColorPrimary}" Offset="0.6" />
                    <GradientStop Color="{StaticResource ColorPrimaryDark}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Ellipse Fill="#14FFFFFF" WidthRequest="220" HeightRequest="220" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-90,-80,0"/>

            <VerticalStackLayout x:Name="ContenidoEncabezado" Spacing="10">
                <Grid ColumnDefinitions="44,*,44" Padding="12,10">
                    <Border Stroke="Transparent" BackgroundColor="#26FFFFFF" WidthRequest="44" HeightRequest="44" SemanticProperties.Description="{loc:T volver}">
                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Border.GestureRecognizers>
                        <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="White" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label x:Name="LblTitulo" Grid.Column="1" Text="{loc:T permiso_titulo}" FontSize="17" FontFamily="OpenSansSemibold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>
                <Label x:Name="LblSubtitulo" Text="{loc:T permiso_subtitulo}" FontSize="14" FontFamily="OpenSansRegular" TextColor="#E6FFFFFF" Padding="24,0" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Hoja -->
        <Border Grid.Row="1" Margin="0,-28,0,0" Stroke="Transparent" BackgroundColor="{StaticResource ColorBackground}" StrokeShape="RoundRectangle 28,28,0,0">
            <Grid>
                <ActivityIndicator x:Name="Cargando" IsRunning="True" IsVisible="True" Color="{StaticResource ColorPrimary}" VerticalOptions="Center" HorizontalOptions="Center"/>
                <ScrollView x:Name="Desplazamiento" IsVisible="False">
                    <VerticalStackLayout x:Name="Contenido" Padding="20,24,20,0" Spacing="16"/>
                </ScrollView>
            </Grid>
        </Border>
    </Grid>
</ContentPage>