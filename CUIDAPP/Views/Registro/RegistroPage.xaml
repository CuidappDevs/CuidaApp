                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border WidthRequest="28" HeightRequest="28" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF1FB" VerticalOptions="Start" Margin="0,1,0,0">
                            <Label Text="6" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorPrimary}" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{loc:T tyc_6_t}" FontSize="16" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}"/>
                            <Label Text="{loc:T tyc_6_b}" FontSize="14" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" LineHeight="1.45"/>
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border WidthRequest="28" HeightRequest="28" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF1FB" VerticalOptions="Start" Margin="0,1,0,0">
                            <Label Text="7" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorPrimary}" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{loc:T tyc_7_t}" FontSize="16" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}"/>
                            <Label Text="{loc:T tyc_7_b}" FontSize="14" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" LineHeight="1.45"/>
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border WidthRequest="28" HeightRequest="28" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF1FB" VerticalOptions="Start" Margin="0,1,0,0">
                            <Label Text="8" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorPrimary}" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{loc:T tyc_8_t}" FontSize="16" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}"/>
                            <Label Text="{loc:T tyc_8_b}" FontSize="14" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" LineHeight="1.45"/>
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border WidthRequest="28" HeightRequest="28" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF1FB" VerticalOptions="Start" Margin="0,1,0,0">
                            <Label Text="9" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorPrimary}" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{loc:T tyc_9_t}" FontSize="16" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}"/>
                            <Label Text="{loc:T tyc_9_b}" FontSize="14" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" LineHeight="1.45"/>
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border WidthRequest="28" HeightRequest="28" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF1FB" VerticalOptions="Start" Margin="0,1,0,0">
                            <Label Text="10" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorPrimary}" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{loc:T tyc_10_t}" FontSize="16" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}"/>
                            <Label Text="{loc:T tyc_10_b}" FontSize="14" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" LineHeight="1.45"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Pie con acciones -->
            <Border Grid.Row="3" StrokeThickness="0" BackgroundColor="{StaticResource ColorSurface}" StrokeShape="RoundRectangle 24,24,0,0" Padding="20,14,20,24">
                <Border.Shadow>
                    <Shadow Brush="#0A2F41" Offset="0,-6" Radius="18" Opacity="0.08" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout x:Name="LblHintTerminos" HorizontalOptions="Center" Spacing="6">
                        <Path Data="M20 12L18.59 10.59L13 16.17V4H11V16.17L5.42 10.58L4 12L12 20L20 12Z" Fill="{StaticResource ColorTextMuted}" Aspect="Uniform" WidthRequest="13" HeightRequest="13" VerticalOptions="Center"/>
                        <Label Text="{loc:T tyc_hint}" FontSize="12" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextMuted}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <Button x:Name="BtnRechazarTerminos" Grid.Column="0" Text="{loc:T tyc_rechazar}" Clicked="OnRechazarTerminosTapped" IsEnabled="False" Opacity="0.5"
                                BackgroundColor="{StaticResource ColorSurface}" TextColor="{StaticResource ColorTextStrong}" BorderColor="{StaticResource ColorBorder}" BorderWidth="1.5"
                                FontFamily="OpenSansSemibold" FontSize="15" CornerRadius="16" HeightRequest="54"
                                Pressed="OnBotonTerminosPresionado" Released="OnBotonTerminosSoltado"/>
                        <Button x:Name="BtnAceptarTerminos" Grid.Column="1" Text="{loc:T tyc_aceptar}" Clicked="OnAceptarTerminosTapped" IsEnabled="False" Opacity="0.5"
                                BackgroundColor="{StaticResource ColorPrimary}" TextColor="White"
                                FontFamily="OpenSansSemibold" FontSize="15" CornerRadius="16" HeightRequest="54"
                                Pressed="OnBotonTerminosPresionado" Released="OnBotonTerminosSoltado">
                            <Button.Shadow>
                                <Shadow Brush="{StaticResource ColorPrimary}" Offset="0,8" Radius="16" Opacity="0.25" />
                            </Button.Shadow>
                        </Button>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Overlay Exito -->
        <ContentView x:Name="OverlayExito" BackgroundColor="#80000000" Opacity="0" IsVisible="False" InputTransparent="False">
            <Border Stroke="Transparent" StrokeShape="RoundRectangle 20" BackgroundColor="White" Padding="30" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="300">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <Path x:Name="OverlayIcon" Data="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM10 17L5 12L6.41 10.59L10 14.17L17.59 6.58L19 8L10 17Z" Fill="#065F46" Aspect="Uniform" WidthRequest="60" HeightRequest="60" HorizontalOptions="Center"/>
                    <Label x:Name="OverlayTitle" Text="{loc:T exito_2}" FontSize="24" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Center"/>
                    <Label x:Name="OverlayMessage" Text="{loc:T registro_completado}" FontSize="16" FontFamily="OpenSansRegular" TextColor="#6B7280" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>
        </ContentView>
    </Grid>
</ContentPage>
