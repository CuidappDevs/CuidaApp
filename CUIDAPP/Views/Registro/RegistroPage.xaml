                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{loc:T tyc_1_t}" FontSize="16" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}"/>
                            <Label Text="{loc:T tyc_1_b}" FontSize="14" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" LineHeight="1.45"/>
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border WidthRequest="28" HeightRequest="28" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF1FB" VerticalOptions="Start" Margin="0,1,0,0">
                            <Label Text="2" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorPrimary}" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{loc:T tyc_2_t}" FontSize="16" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}"/>
                            <Label Text="{loc:T tyc_2_b}" FontSize="14" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" LineHeight="1.45"/>
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border WidthRequest="28" HeightRequest="28" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF1FB" VerticalOptions="Start" Margin="0,1,0,0">
                            <Label Text="3" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorPrimary}" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{loc:T tyc_3_t}" FontSize="16" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}"/>
                            <Label Text="{loc:T tyc_3_b}" FontSize="14" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" LineHeight="1.45"/>
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border WidthRequest="28" HeightRequest="28" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="#EAF1FB" VerticalOptions="Start" Margin="0,1,0,0">
                            <Label Text="4" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorPrimary}" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{loc:T tyc_4_t}" FontSize="16" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}"/>
                            <Label Text="{loc:T tyc_4_b}" FontSize="14" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" LineHeight="1.45"/>
                        </VerticalStackLayout>
