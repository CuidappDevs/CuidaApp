                                    <Entry x:Name="EntryEmergenciaNombre" Grid.Column="1" Placeholder="{loc:T nombre_del_contacto}" FontFamily="OpenSansRegular" PlaceholderColor="#8A97A6" TextColor="{StaticResource ColorTextStrong}" FontSize="15" BackgroundColor="Transparent" HeightRequest="52" Focused="OnCampoFocused" Unfocused="OnCampoUnfocused"/>
