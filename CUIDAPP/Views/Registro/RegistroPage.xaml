<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:CUIDAPP.Localization"
             x:Class="CUIDAPP.Views.Registro.RegistroPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFFFFF">

    <Grid>
        <Grid RowDefinitions="Auto, *">
            
            <!-- Top Bar Fija -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20,15,20,10">
                <ContentView x:Name="BtnBack" VerticalOptions="Center">
                    <ContentView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </ContentView.GestureRecognizers>
                    <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="{StaticResource ColorTextStrong}" Aspect="Uniform" WidthRequest="22" HeightRequest="22" />
                </ContentView>
                
                <Label x:Name="TopTitle" Grid.Column="1" Text="{loc:T registro}" FontSize="17" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False"/>
                <Label x:Name="StepIndicator" Grid.Column="2" Text="{loc:T 1_de_x}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#6B7280" VerticalOptions="Center"/>
            </Grid>

            <ScrollView x:Name="ScrollRegistro" Grid.Row="1" SizeChanged="OnScrollRegistroSizeChanged">
                <Grid Padding="20,10,20,20">
                    
                    <!-- PASO 1: Bienvenida -->
                    <Grid x:Name="PasoBienvenida" RowDefinitions="Auto,*,Auto" IsVisible="True">
                        <VerticalStackLayout Grid.Row="0" Spacing="8" Margin="0,24,0,8">
                            <Label Text="{loc:T hola_3}" FontSize="32" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Center"/>
                            <Label Text="{loc:T vamos_a_crear_tu_perfil}" FontSize="16" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>

                        <!-- Ilustración: cuidadora saludando (formas vectoriales, animada en bucle) -->
                        <Grid Grid.Row="1" WidthRequest="260" HeightRequest="260" HorizontalOptions="Center" VerticalOptions="Center">

                            <!-- Anillo que respira -->
                            <Ellipse x:Name="HolaAnillo" Stroke="{StaticResource ColorPrimaryLight}" StrokeThickness="2" Opacity="0.35"
                                     WidthRequest="236" HeightRequest="236" HorizontalOptions="Center" VerticalOptions="Center"/>

                            <!-- Círculo de fondo (recorta al personaje) -->
                            <Border x:Name="HolaCirculo" WidthRequest="216" HeightRequest="216" HorizontalOptions="Center" VerticalOptions="Center" StrokeThickness="0">
                                <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#EEF4FC" Offset="0"/>
                                        <GradientStop Color="#D3E3F8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>

                                <AbsoluteLayout WidthRequest="216" HeightRequest="216">
                                    <!-- Brazo que saluda (detrás del cuerpo) -->
                                    <!-- Brazo que saluda: sale inclinado hacia afuera (lejos de la cara) desde el hombro -->
                                    <Grid x:Name="HolaBrazo" AbsoluteLayout.LayoutBounds="148,82,32,84" AnchorX="0.5" AnchorY="1" Rotation="22">
                                        <Border BackgroundColor="{StaticResource ColorPrimary}" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                                WidthRequest="22" HeightRequest="60" VerticalOptions="End"/>
                                        <!-- Mano abierta (palma + pulgar) -->
                                        <Grid x:Name="HolaMano" WidthRequest="30" HeightRequest="32" VerticalOptions="Start" AnchorX="0.5" AnchorY="1">
                                            <Border BackgroundColor="#F2C29B" StrokeThickness="0" StrokeShape="RoundRectangle 13,13,11,11" WidthRequest="24" HeightRequest="30" HorizontalOptions="Center"/>
                                            <Ellipse Fill="#F2C29B" WidthRequest="11" HeightRequest="11" HorizontalOptions="Start" VerticalOptions="End" Margin="-1,0,0,6"/>
                                        </Grid>
                                    </Grid>

                                    <!-- Cuerpo -->
                                    <Border AbsoluteLayout.LayoutBounds="48,150,120,80" BackgroundColor="{StaticResource ColorPrimary}" StrokeThickness="0" StrokeShape="RoundRectangle 56,56,0,0"/>
                                    <!-- Cuello -->
                                    <Border AbsoluteLayout.LayoutBounds="96,132,24,24" BackgroundColor="#E5B08A" StrokeThickness="0" StrokeShape="RoundRectangle 8"/>
                                    <!-- Logo de la app en el uniforme -->
                                    <Border AbsoluteLayout.LayoutBounds="94,168,28,28" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                        <Image Source="logo_cuidapp.png" Aspect="AspectFit" Margin="3"/>
                                    </Border>

                                    <!-- Pelo (atrás) -->
                                    <Ellipse AbsoluteLayout.LayoutBounds="64,46,88,96" Fill="#3B2A22"/>
                                    <!-- Cabeza -->
                                    <Ellipse AbsoluteLayout.LayoutBounds="70,58,76,82" Fill="#F2C29B"/>
                                    <!-- Flequillo -->
                                    <Border AbsoluteLayout.LayoutBounds="66,46,84,34" BackgroundColor="#3B2A22" StrokeThickness="0" StrokeShape="RoundRectangle 42,42,8,30"/>

                                    <!-- Ojos -->
                                    <Ellipse x:Name="HolaOjoIzq" AbsoluteLayout.LayoutBounds="90,96,8,10" Fill="#1F2937"/>
                                    <Ellipse x:Name="HolaOjoDer" AbsoluteLayout.LayoutBounds="118,96,8,10" Fill="#1F2937"/>
                                    <!-- Mejillas -->
                                    <Ellipse AbsoluteLayout.LayoutBounds="80,110,12,7" Fill="#F28B82" Opacity="0.45"/>
                                    <Ellipse AbsoluteLayout.LayoutBounds="124,110,12,7" Fill="#F28B82" Opacity="0.45"/>
                                    <!-- Sonrisa -->
                                    <Path AbsoluteLayout.LayoutBounds="97,114,22,10" Data="M1 1 Q11 10 21 1" Stroke="#1F2937" StrokeThickness="2.5" StrokeLineCap="Round" Aspect="None"/>
                                </AbsoluteLayout>
                            </Border>

                            <!-- Corazón flotante -->
                            <Path x:Name="HolaCorazon" Data="M12 21.35L10.55 20.03C5.4 15.36 2 12.28 2 8.5C2 5.42 4.42 3 7.5 3C9.24 3 10.91 3.81 12 5.09C13.09 3.81 14.76 3 16.5 3C19.58 3 22 5.42 22 8.5C22 12.28 18.6 15.36 13.45 20.04L12 21.35Z" Fill="#EF5B6B" Aspect="Uniform" WidthRequest="30" HeightRequest="30"
                                  HorizontalOptions="End" VerticalOptions="Start" Margin="0,22,18,0"/>
                            <!-- Destellos -->
                            <Path x:Name="HolaDestello1" Data="M12 0L14.2 9.8L24 12L14.2 14.2L12 24L9.8 14.2L0 12L9.8 9.8Z" Fill="{StaticResource ColorAccent}" Aspect="Uniform" WidthRequest="16" HeightRequest="16"
                                  HorizontalOptions="Start" VerticalOptions="Start" Margin="22,46,0,0"/>
                            <Path x:Name="HolaDestello2" Data="M12 0L14.2 9.8L24 12L14.2 14.2L12 24L9.8 14.2L0 12L9.8 9.8Z" Fill="#F5B83D" Aspect="Uniform" WidthRequest="12" HeightRequest="12"
                                  HorizontalOptions="Start" VerticalOptions="End" Margin="30,0,0,40"/>
                        </Grid>

                        <VerticalStackLayout Grid.Row="2" Spacing="12">
                        <Button Text="{loc:T comenzar}" Clicked="OnNextTapped" BackgroundColor="{StaticResource ColorPrimary}" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="16" HeightRequest="56"
                                Pressed="OnBotonTerminosPresionado" Released="OnBotonTerminosSoltado">
                            <Button.Shadow>
                                <Shadow Brush="{StaticResource ColorPrimary}" Offset="0,8" Radius="16" Opacity="0.25" />
                            </Button.Shadow>
                        </Button>
                        <Label Text="{loc:T al_continuar_aceptas_nuestros_terminos}" HorizontalTextAlignment="Center" FontSize="12" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- PASO 2: Rol -->
                    <Grid x:Name="PasoRol" RowDefinitions="Auto,Auto,*,Auto" IsVisible="False">
                        <VerticalStackLayout Grid.Row="0" Spacing="8" Margin="0,16,0,28">
                            <Label Text="{loc:T que_buscas_hoy}" FontSize="26" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Center"/>
                            <Label Text="{loc:T selecciona_el_motivo_principal_para}" FontSize="15" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Spacing="14">
                            <Border x:Name="RoleOptionCliente" Stroke="{StaticResource ColorBorder}" StrokeThickness="1.5" StrokeShape="RoundRectangle 20" Padding="16" BackgroundColor="White">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRoleOptionTapped" CommandParameter="Cliente" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                                    <Border x:Name="RoleIconBoxCliente" WidthRequest="52" HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource ColorBackground}" VerticalOptions="Center">
                                        <Path x:Name="RoleIconCliente" Data="M10 20V14H14V20H19V12H22L12 3L2 12H5V20H10Z" Fill="{StaticResource ColorTextMuted}" Aspect="Uniform" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                        <Label x:Name="RoleTextCliente" Text="{loc:T busco_ayuda_en_casa}" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource ColorTextStrong}"/>
                                        <Label Text="{loc:T necesito_contratar_servicios}" FontFamily="OpenSansRegular" FontSize="13" TextColor="{StaticResource ColorTextMuted}"/>
                                    </VerticalStackLayout>
                                    <!-- Indicador de selección -->
                                    <Border x:Name="RoleCheckCliente" Grid.Column="2" WidthRequest="24" HeightRequest="24" StrokeThickness="1.5" Stroke="{StaticResource ColorBorder}" BackgroundColor="White" VerticalOptions="Center">
                                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                        <Path x:Name="RoleCheckMarkCliente" Data="M9 16.17L4.83 12L3.41 13.41L9 19L21 7L19.59 5.59L9 16.17Z" Fill="White" Aspect="Uniform" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" VerticalOptions="Center" Opacity="0"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border x:Name="RoleOptionCuidador" Stroke="{StaticResource ColorBorder}" StrokeThickness="1.5" StrokeShape="RoundRectangle 20" Padding="16" BackgroundColor="White">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRoleOptionTapped" CommandParameter="Cuidador" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14">
                                    <Border x:Name="RoleIconBoxCuidador" WidthRequest="52" HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource ColorBackground}" VerticalOptions="Center">
                                        <Path x:Name="RoleIconCuidador" Data="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 4C13.66 4 15 5.34 15 7C15 8.66 13.66 10 12 10C10.34 10 9 8.66 9 7C9 5.34 10.34 4 12 4ZM16 18H8V16C8 13.34 13.33 12 16 12C16 12 16 12.01 16 12.01V18Z" Fill="{StaticResource ColorTextMuted}" Aspect="Uniform" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                        <Label x:Name="RoleTextCuidador" Text="{loc:T quiero_trabajar}" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource ColorTextStrong}"/>
                                        <Label Text="{loc:T ofrecer_mis_servicios_como_profesional}" FontFamily="OpenSansRegular" FontSize="13" TextColor="{StaticResource ColorTextMuted}"/>
                                    </VerticalStackLayout>
                                    <!-- Indicador de selección -->
                                    <Border x:Name="RoleCheckCuidador" Grid.Column="2" WidthRequest="24" HeightRequest="24" StrokeThickness="1.5" Stroke="{StaticResource ColorBorder}" BackgroundColor="White" VerticalOptions="Center">
                                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                        <Path x:Name="RoleCheckMarkCuidador" Data="M9 16.17L4.83 12L3.41 13.41L9 19L21 7L19.59 5.59L9 16.17Z" Fill="White" Aspect="Uniform" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" VerticalOptions="Center" Opacity="0"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- Recurrente (RolId 4): contratación formal tipo empleado. Desactivada hasta que exista su flujo. -->
                            <Border x:Name="RoleOptionRecurrente" Stroke="{StaticResource ColorBorder}" StrokeThickness="1.5" StrokeShape="RoundRectangle 20" Padding="16" BackgroundColor="White" Opacity="0.6" IsEnabled="False">
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14">
                                    <Border WidthRequest="52" HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource ColorBackground}" VerticalOptions="Center">
                                        <!-- Calendario con repetición -->
                                        <Path Data="M19 4H18V2H16V4H8V2H6V4H5C3.89 4 3 4.9 3 6V20C3 21.1 3.89 22 5 22H19C20.1 22 21 21.1 21 20V6C21 4.9 20.1 4 19 4ZM19 20H5V10H19V20ZM12 11.5V13.25L14.5 11L12 8.75V10.5C9.79 10.5 8 12.29 8 14.5C8 15.29 8.23 16.02 8.62 16.64L9.71 15.55C9.57 15.22 9.5 14.87 9.5 14.5C9.5 13.12 10.62 12 12 12V11.5ZM15.38 12.36L14.29 13.45C14.43 13.78 14.5 14.13 14.5 14.5C14.5 15.88 13.38 17 12 17V15.25L9.5 17.5L12 19.75V18C14.21 18 16 16.21 16 14.5C16 13.71 15.77 12.98 15.38 12.36Z" Fill="{StaticResource ColorTextMuted}" Aspect="Uniform" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                            <Label Text="{loc:T rol_recurrente}" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource ColorTextStrong}" VerticalOptions="Center"/>
                                            <Border Grid.Column="1" Stroke="Transparent" BackgroundColor="#FFF4DC" StrokeShape="RoundRectangle 10" Padding="8,3" VerticalOptions="Center">
                                                <Label Text="{loc:T en_desarrollo}" FontSize="10" FontFamily="OpenSansSemibold" TextColor="#8A4B00"/>
                                            </Border>
                                        </Grid>
                                        <Label Text="{loc:T rol_recurrente_desc}" FontFamily="OpenSansRegular" FontSize="13" TextColor="{StaticResource ColorTextMuted}"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Siguiente: siempre abajo -->
                        <Button Grid.Row="3" Text="{loc:T siguiente}" Clicked="OnNextTapped" BackgroundColor="{StaticResource ColorPrimary}" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="16" HeightRequest="56"
                                Pressed="OnBotonTerminosPresionado" Released="OnBotonTerminosSoltado">
                            <Button.Shadow>
                                <Shadow Brush="{StaticResource ColorPrimary}" Offset="0,8" Radius="16" Opacity="0.25" />
                            </Button.Shadow>
                        </Button>
                    </Grid>

                    <!-- PASO CREDENCIALES -->
                    <Grid x:Name="PasoCredenciales" RowDefinitions="Auto,Auto,*,Auto" IsVisible="False">
                        <VerticalStackLayout Grid.Row="0" Spacing="8" Margin="0,16,0,28">
                            <Label Text="{loc:T crea_tu_cuenta}" FontSize="26" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                            <Label Text="{loc:T usa_tu_correo_para_registrarte}" FontSize="15" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Spacing="18">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{loc:T correo_electronico}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource ColorTextStrong}"/>
                                <Border Stroke="{StaticResource ColorBorder}" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource ColorBackground}" Padding="14,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Path Data="M20 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V6C22 4.9 21.1 4 20 4ZM20 8L12 13L4 8V6L12 11L20 6V8Z" Fill="{StaticResource ColorTextMuted}" Aspect="Uniform" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"/>
                                    <Entry x:Name="EntryEmail" Grid.Column="1" Keyboard="Email" Placeholder="{loc:T ejemplo_correo_com}" ClearButtonVisibility="WhileEditing" FontFamily="OpenSansRegular" PlaceholderColor="#8A97A6" TextColor="{StaticResource ColorTextStrong}" FontSize="15" BackgroundColor="Transparent" HeightRequest="52" Focused="OnCampoFocused" Unfocused="OnCampoUnfocused"/>
                                </Grid>
                            </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{loc:T contrasena}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource ColorTextStrong}"/>
                                <Border Stroke="{StaticResource ColorBorder}" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource ColorBackground}" Padding="14,0">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Path Data="M18 8H17V6C17 3.24 14.76 1 12 1C9.24 1 7 3.24 7 6V8H6C4.9 8 4 8.9 4 10V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V10C20 8.9 19.1 8 18 8ZM12 17C10.9 17 10 16.1 10 15C10 13.9 10.9 13 12 13C13.1 13 14 13.9 14 15C14 16.1 13.1 17 12 17ZM15.1 8H8.9V6C8.9 4.29 10.29 2.9 12 2.9C13.71 2.9 15.1 4.29 15.1 6V8Z" Fill="{StaticResource ColorTextMuted}" Aspect="Uniform" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"/>
                                    <Entry x:Name="EntryPassword" Grid.Column="1" IsPassword="True" TextChanged="OnPasswordCambiado" Placeholder="{loc:T crea_una_contrasena_segura}" FontFamily="OpenSansRegular" PlaceholderColor="#8A97A6" TextColor="{StaticResource ColorTextStrong}" FontSize="15" BackgroundColor="Transparent" HeightRequest="52" Focused="OnCampoFocused" Unfocused="OnCampoUnfocused"/>
                                    <Grid Grid.Column="2" WidthRequest="44" HeightRequest="44" VerticalOptions="Center" Margin="0,0,-10,0">
                                        <Path Data="M12 4.5C7 4.5 2.73 7.61 1 12C2.73 16.39 7 19.5 12 19.5C17 19.5 21.27 16.39 23 12C21.27 7.61 17 4.5 12 4.5ZM12 17C9.24 17 7 14.76 7 12C7 9.24 9.24 7 12 7C14.76 7 17 9.24 17 12C17 14.76 14.76 17 12 17ZM12 9C10.34 9 9 10.34 9 12C9 13.66 10.34 15 12 15C13.66 15 15 13.66 15 12C15 10.34 13.66 9 12 9Z" Fill="{StaticResource ColorTextMuted}" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnToggleRegistroPassword"/></Grid.GestureRecognizers>
                                    </Grid>
                                </Grid>
                            </Border>
                            </VerticalStackLayout>
                            <!-- Requisitos de la contraseña: se marcan en verde al cumplirse -->
                            <VerticalStackLayout Spacing="6" Margin="2,-6,0,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Border x:Name="ReglaLargoCaja" WidthRequest="18" HeightRequest="18" StrokeThickness="0" BackgroundColor="{StaticResource ColorBorder}" VerticalOptions="Center">
                                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                        <Path Data="M9 16.17L4.83 12L3.41 13.41L9 19L21 7L19.59 5.59L9 16.17Z" Fill="White" Aspect="Uniform" WidthRequest="10" HeightRequest="10" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Label x:Name="ReglaLargoTexto" Grid.Column="1" Text="{loc:T regla_clave_largo}" FontFamily="OpenSansRegular" FontSize="13" TextColor="{StaticResource ColorTextMuted}" VerticalOptions="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Border x:Name="ReglaNumeroCaja" WidthRequest="18" HeightRequest="18" StrokeThickness="0" BackgroundColor="{StaticResource ColorBorder}" VerticalOptions="Center">
                                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                        <Path Data="M9 16.17L4.83 12L3.41 13.41L9 19L21 7L19.59 5.59L9 16.17Z" Fill="White" Aspect="Uniform" WidthRequest="10" HeightRequest="10" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Label x:Name="ReglaNumeroTexto" Grid.Column="1" Text="{loc:T regla_clave_numero}" FontFamily="OpenSansRegular" FontSize="13" TextColor="{StaticResource ColorTextMuted}" VerticalOptions="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Border x:Name="ReglaEspecialCaja" WidthRequest="18" HeightRequest="18" StrokeThickness="0" BackgroundColor="{StaticResource ColorBorder}" VerticalOptions="Center">
                                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                        <Path Data="M9 16.17L4.83 12L3.41 13.41L9 19L21 7L19.59 5.59L9 16.17Z" Fill="White" Aspect="Uniform" WidthRequest="10" HeightRequest="10" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Label x:Name="ReglaEspecialTexto" Grid.Column="1" Text="{loc:T regla_clave_especial}" FontFamily="OpenSansRegular" FontSize="13" TextColor="{StaticResource ColorTextMuted}" VerticalOptions="Center"/>
                                </Grid>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{loc:T confirmar_contrasena}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource ColorTextStrong}"/>
                                <Border Stroke="{StaticResource ColorBorder}" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource ColorBackground}" Padding="14,0">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Path Data="M18 8H17V6C17 3.24 14.76 1 12 1C9.24 1 7 3.24 7 6V8H6C4.9 8 4 8.9 4 10V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V10C20 8.9 19.1 8 18 8ZM12 17C10.9 17 10 16.1 10 15C10 13.9 10.9 13 12 13C13.1 13 14 13.9 14 15C14 16.1 13.1 17 12 17ZM15.1 8H8.9V6C8.9 4.29 10.29 2.9 12 2.9C13.71 2.9 15.1 4.29 15.1 6V8Z" Fill="{StaticResource ColorTextMuted}" Aspect="Uniform" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"/>
                                        <Entry x:Name="EntryPasswordConfirmar" Grid.Column="1" IsPassword="True" TextChanged="OnPasswordCambiado" Placeholder="{loc:T repite_tu_contrasena}" FontFamily="OpenSansRegular" PlaceholderColor="#8A97A6" TextColor="{StaticResource ColorTextStrong}" FontSize="15" BackgroundColor="Transparent" HeightRequest="52" Focused="OnCampoFocused" Unfocused="OnCampoUnfocused"/>
                                        <Grid Grid.Column="2" WidthRequest="44" HeightRequest="44" VerticalOptions="Center" Margin="0,0,-10,0">
                                            <Path Data="M12 4.5C7 4.5 2.73 7.61 1 12C2.73 16.39 7 19.5 12 19.5C17 19.5 21.27 16.39 23 12C21.27 7.61 17 4.5 12 4.5ZM12 17C9.24 17 7 14.76 7 12C7 9.24 9.24 7 12 7C14.76 7 17 9.24 17 12C17 14.76 14.76 17 12 17ZM12 9C10.34 9 9 10.34 9 12C9 13.66 10.34 15 12 15C13.66 15 15 13.66 15 12C15 10.34 13.66 9 12 9Z" Fill="{StaticResource ColorTextMuted}" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnToggleRegistroPasswordConfirmar"/></Grid.GestureRecognizers>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Label x:Name="LblCoincideClave" FontFamily="OpenSansRegular" FontSize="12" IsVisible="False"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <Button Grid.Row="3" Text="{loc:T siguiente}" Clicked="OnNextTapped" BackgroundColor="{StaticResource ColorPrimary}" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="16" HeightRequest="56" Margin="0,24,0,0"
                                Pressed="OnBotonTerminosPresionado" Released="OnBotonTerminosSoltado">
                            <Button.Shadow>
                                <Shadow Brush="{StaticResource ColorPrimary}" Offset="0,8" Radius="16" Opacity="0.25" />
                            </Button.Shadow>
                        </Button>
                    </Grid>

                    <!-- PASO NOMBRE Y BIO -->
                    <Grid x:Name="PasoNombre" RowDefinitions="Auto,Auto,*,Auto" IsVisible="False">
                        <VerticalStackLayout Grid.Row="0" Spacing="8" Margin="0,16,0,28">
