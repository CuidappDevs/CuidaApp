                                        <Path x:Name="PayIcon2" Data="M21 7.28V5C21 3.9 20.1 3 19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V16.72C21.59 16.37 22 15.74 22 15V9C22 8.26 21.59 7.63 21 7.28ZM20 15H13V9H20V15ZM5 19V5H19V7H13C11.9 7 11 7.9 11 9V15C11 16.1 11.9 17 13 17H19V19H5ZM16 13.5C15.17 13.5 14.5 12.83 14.5 12C14.5 11.17 15.17 10.5 16 10.5C16.83 10.5 17.5 11.17 17.5 12C17.5 12.83 16.83 13.5 16 13.5Z" Fill="{StaticResource ColorTextMuted}" Aspect="Uniform" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                        <Label x:Name="PayText2" Text="{loc:T billetera_cuidapp}" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource ColorTextStrong}"/>
                                        <Label Text="{loc:T retira_cuando_quieras}" FontFamily="OpenSansRegular" FontSize="13" TextColor="{StaticResource ColorTextMuted}"/>
                                    </VerticalStackLayout>
                                    <Border x:Name="PayCheck2" Grid.Column="2" WidthRequest="24" HeightRequest="24" StrokeThickness="1.5" Stroke="{StaticResource ColorBorder}" BackgroundColor="White" VerticalOptions="Center">
                                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                        <Path x:Name="PayCheckMark2" Data="M9 16.17L4.83 12L3.41 13.41L9 19L21 7L19.59 5.59L9 16.17Z" Fill="White" Aspect="Uniform" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" VerticalOptions="Center" Opacity="0"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border x:Name="PayOption3" Stroke="{StaticResource ColorBorder}" StrokeThickness="1.5" StrokeShape="RoundRectangle 20" Padding="16" BackgroundColor="White">
