                    <!-- PASO DIRECCION (SOLO CLIENTE) -->
                    <Grid x:Name="PasoDireccion" RowDefinitions="Auto,Auto,*,Auto" IsVisible="False">
                        <VerticalStackLayout Grid.Row="0" Spacing="8" Margin="0,16,0,28">
                            <Label Text="{loc:T datos_de_contacto}" FontSize="26" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
