<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CUIDAPP.Views.Auth.ForgotPasswordPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ColorBackground}">
    <Grid>
        <Grid RowDefinitions="Auto, *">
            <!-- Top Bar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="20,15,20,10">
                <ContentView x:Name="BtnBack" VerticalOptions="Center">
                    <ContentView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </ContentView.GestureRecognizers>
                    <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="{StaticResource ColorPrimary}" Aspect="Uniform" WidthRequest="22" HeightRequest="22" />
                </ContentView>
                <Label Grid.Column="1" x:Name="TopTitle" Text="Recuperar contraseña" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorPrimary}" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="25,20" Spacing="25">
                    
                    <!-- STEP 1: Email -->
                    <VerticalStackLayout x:Name="Step1" Spacing="20" IsVisible="True">
                        <Path Data="M20 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V6C22 4.9 21.1 4 20 4ZM20 8L12 13L4 8V6L12 11L20 6V8Z" Fill="{StaticResource ColorPrimary}" Aspect="Uniform" WidthRequest="60" HeightRequest="60" HorizontalOptions="Center" Margin="0,30,0,0"/>
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                            <Label Text="¿Olvidaste tu contraseña?" FontFamily="OpenSansSemibold" FontSize="24" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Center" />
                            <Label Text="Ingresa tu correo y te enviaremos un código de verificación" FontFamily="OpenSansRegular" FontSize="14" TextColor="{StaticResource ColorTextMuted}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Correo electrónico" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource ColorTextStrong}" />
                            <Border Stroke="{StaticResource ColorBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource ColorSurface}" Padding="15,2">
                                <Entry x:Name="EntryEmail" Placeholder="ejemplo@correo.com" FontFamily="OpenSansRegular" PlaceholderColor="{StaticResource ColorTextMuted}" TextColor="{StaticResource ColorTextStrong}" FontSize="15" BackgroundColor="Transparent" ClearButtonVisibility="WhileEditing" HeightRequest="45" Keyboard="Email" />
                            </Border>
                        </VerticalStackLayout>
                        <Button x:Name="BtnEnviar" Text="Enviar código" BackgroundColor="{StaticResource ColorPrimary}" TextColor="{StaticResource ColorSurface}" FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="12" HeightRequest="55" Clicked="OnEnviarClicked" Margin="0,10,0,0"/>
                    </VerticalStackLayout>

                    <!-- STEP 2: Código (6 boxes) -->
                    <VerticalStackLayout x:Name="Step2" Spacing="25" IsVisible="False">
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                            <Label Text="Verificar código" FontFamily="OpenSansSemibold" FontSize="24" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Center" />
                            <Label x:Name="LblEmail" Text="" FontFamily="OpenSansRegular" FontSize="14" TextColor="{StaticResource ColorTextMuted}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>

                        <!-- 6 Code Boxes -->
                        <Grid ColumnDefinitions="*, *, *, *, *, *" ColumnSpacing="10" HorizontalOptions="Center" Margin="0,10,0,0">
                            <Border Grid.Column="0" Stroke="{StaticResource ColorBorder}" StrokeThickness="2" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource ColorSurface}" HeightRequest="55" WidthRequest="50">
                                <Entry x:Name="Pin1" MaxLength="1" Keyboard="Numeric" FontSize="24" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" BackgroundColor="Transparent" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" HeightRequest="50"/>
                            </Border>
                            <Border Grid.Column="1" Stroke="{StaticResource ColorBorder}" StrokeThickness="2" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource ColorSurface}" HeightRequest="55" WidthRequest="50">
                                <Entry x:Name="Pin2" MaxLength="1" Keyboard="Numeric" FontSize="24" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" BackgroundColor="Transparent" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" HeightRequest="50"/>
                            </Border>
                            <Border Grid.Column="2" Stroke="{StaticResource ColorBorder}" StrokeThickness="2" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource ColorSurface}" HeightRequest="55" WidthRequest="50">
                                <Entry x:Name="Pin3" MaxLength="1" Keyboard="Numeric" FontSize="24" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" BackgroundColor="Transparent" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" HeightRequest="50"/>
                            </Border>
                            <Border Grid.Column="3" Stroke="{StaticResource ColorBorder}" StrokeThickness="2" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource ColorSurface}" HeightRequest="55" WidthRequest="50">
                                <Entry x:Name="Pin4" MaxLength="1" Keyboard="Numeric" FontSize="24" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" BackgroundColor="Transparent" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" HeightRequest="50"/>
                            </Border>
                            <Border Grid.Column="4" Stroke="{StaticResource ColorBorder}" StrokeThickness="2" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource ColorSurface}" HeightRequest="55" WidthRequest="50">
                                <Entry x:Name="Pin5" MaxLength="1" Keyboard="Numeric" FontSize="24" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" BackgroundColor="Transparent" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" HeightRequest="50"/>
                            </Border>
                            <Border Grid.Column="5" Stroke="{StaticResource ColorBorder}" StrokeThickness="2" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource ColorSurface}" HeightRequest="55" WidthRequest="50">
                                <Entry x:Name="Pin6" MaxLength="1" Keyboard="Numeric" FontSize="24" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" BackgroundColor="Transparent" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" HeightRequest="50"/>
                            </Border>
                        </Grid>

                        <!-- Timer -->
                        <Label x:Name="LblTimer" Text="" FontFamily="OpenSansRegular" FontSize="13" TextColor="{StaticResource ColorTextMuted}" HorizontalOptions="Center"/>

                        <Button x:Name="BtnVerificar" Text="Verificar código" BackgroundColor="{StaticResource ColorPrimary}" TextColor="{StaticResource ColorSurface}" FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="12" HeightRequest="55" Clicked="OnVerificarClicked" Margin="0,5,0,0"/>

                        <!-- Resend Code -->
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="¿No recibiste el código?" FontFamily="OpenSansRegular" FontSize="13" TextColor="{StaticResource ColorTextMuted}" />
                            <Label x:Name="LblReenviar" Text="Reenviar" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource ColorPrimary}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnReenviarTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
