<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:CUIDAPP.Localization"
             x:Class="CUIDAPP.Views.Auth.ForgotPasswordPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ColorPrimaryDark}"
             SafeAreaEdges="None">

    <!-- Mismo lenguaje visual que el login: encabezado azul + hoja blanca -->
    <ScrollView SafeAreaEdges="None">
        <Grid x:Name="Raiz" RowDefinitions="Auto,Auto" SafeAreaEdges="None">
            <!-- Degradado en toda la pantalla: al salir la hoja no queda ninguna costura -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#2A63B8" Offset="0.0" />
                    <GradientStop Color="{StaticResource ColorPrimary}" Offset="0.45" />
                    <GradientStop Color="{StaticResource ColorPrimaryDark}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>


            <!-- Encabezado -->
            <Grid x:Name="Encabezado" Grid.Row="0" SafeAreaEdges="None">

                <Ellipse x:Name="CirculoA" Fill="#14FFFFFF" WidthRequest="260" HeightRequest="260"
                         HorizontalOptions="End" VerticalOptions="Start" Margin="0,-100,-100,0" />
                <Ellipse x:Name="CirculoB" Fill="#0FFFFFFF" WidthRequest="180" HeightRequest="180"
                         HorizontalOptions="Start" VerticalOptions="End" Margin="-70,0,0,40" />

                <Grid x:Name="ContenidoEncabezado" RowDefinitions="Auto,*">
                    <!-- Barra superior -->
                    <Grid Grid.Row="0" ColumnDefinitions="44,*,44" Padding="8,4">
                        <ContentView x:Name="BtnBack" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                            <ContentView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackTapped" />
                            </ContentView.GestureRecognizers>
                            <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="White" Aspect="Uniform" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center" />
                        </ContentView>
                        <Label Grid.Column="1" x:Name="TopTitle" Text="{loc:T recuperar_contrasena}" FontSize="16" FontFamily="OpenSansSemibold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Grid>

                    <!-- Insignia -->
                    <Border x:Name="Insignia" Grid.Row="1" BackgroundColor="{StaticResource ColorSurface}" StrokeThickness="0" StrokeShape="RoundRectangle 30"
                            WidthRequest="104" HeightRequest="104" Opacity="0" Scale="0.92"
                            HorizontalOptions="Center" VerticalOptions="Center" Margin="0,0,0,36">
                        <Border.Shadow>
                            <Shadow Brush="#051A2A" Offset="0,12" Radius="26" Opacity="0.3" />
                        </Border.Shadow>
                        <Path Data="M20 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V6C22 4.9 21.1 4 20 4ZM20 8L12 13L4 8V6L12 11L20 6V8Z"
                              Fill="{StaticResource ColorPrimary}" Aspect="Uniform" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Grid>

            <!-- Hoja -->
            <Border x:Name="Hoja" Grid.Row="1" Margin="0,-36,0,0"
                    BackgroundColor="{StaticResource ColorSurface}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 32,32,0,0" Padding="24,32,24,32">
                <Grid x:Name="ContenidoHoja">
                        <!-- STEP 1: Email -->
                        <VerticalStackLayout x:Name="Step1" Spacing="20" IsVisible="True">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{loc:T olvidaste_tu_contrasena}" FontFamily="OpenSansSemibold" FontSize="26" TextColor="{StaticResource ColorTextStrong}" />
                                <Label Text="{loc:T ingresa_tu_correo_y_te}" FontFamily="OpenSansRegular" FontSize="15" TextColor="{StaticResource ColorTextMuted}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{loc:T correo_electronico}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource ColorTextStrong}" />
                                <Border Stroke="{StaticResource ColorBorder}" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource ColorBackground}" Padding="14,0">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Path Data="M20 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V6C22 4.9 21.1 4 20 4ZM20 8L12 13L4 8V6L12 11L20 6V8Z"
                                              Fill="{StaticResource ColorTextMuted}" Aspect="Uniform" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                        <Entry x:Name="EntryEmail" Grid.Column="1" Placeholder="{loc:T ejemplo_correo_com}" FontFamily="OpenSansRegular" PlaceholderColor="{StaticResource ColorPlaceholder}" TextColor="{StaticResource ColorTextStrong}" FontSize="15" BackgroundColor="Transparent" ClearButtonVisibility="WhileEditing" HeightRequest="52" Keyboard="Email"
                                               Focused="OnEntryFocused" Unfocused="OnEntryUnfocused" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                            <Button x:Name="BtnEnviar" Text="{loc:T enviar_codigo}" BackgroundColor="{StaticResource ColorPrimary}" TextColor="{StaticResource ColorSurface}" FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="16" HeightRequest="56" Clicked="OnEnviarClicked" Margin="0,4,0,30"
                                    Pressed="OnBotonPresionado" Released="OnBotonSoltado">
                                <Button.Shadow>
                                    <Shadow Brush="{StaticResource ColorPrimary}" Offset="0,8" Radius="16" Opacity="0.28" />
                                </Button.Shadow>
                            </Button>
                        </VerticalStackLayout>

                        <!-- STEP 2: Código (6 boxes) -->
                        <VerticalStackLayout x:Name="Step2" Spacing="25" IsVisible="False">
                            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                <Label Text="{loc:T verificar_codigo}" FontFamily="OpenSansSemibold" FontSize="24" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Center" />
                                <Label x:Name="LblEmail" Text="" FontFamily="OpenSansRegular" FontSize="14" TextColor="{StaticResource ColorTextMuted}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>

                            <!-- 6 Code Boxes -->
                            <Grid ColumnDefinitions="*, *, *, *, *, *" ColumnSpacing="10" HorizontalOptions="Center" Margin="0,10,0,0">
                                <Border Grid.Column="0" Stroke="{StaticResource ColorBorder}" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource ColorBackground}" HeightRequest="56" WidthRequest="48">
                                    <Entry x:Name="Pin1" MaxLength="1" Keyboard="Numeric" FontSize="24" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" BackgroundColor="Transparent" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" HeightRequest="50"/>
                                </Border>
                                <Border Grid.Column="1" Stroke="{StaticResource ColorBorder}" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource ColorBackground}" HeightRequest="56" WidthRequest="48">
                                    <Entry x:Name="Pin2" MaxLength="1" Keyboard="Numeric" FontSize="24" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" BackgroundColor="Transparent" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" HeightRequest="50"/>
                                </Border>
                                <Border Grid.Column="2" Stroke="{StaticResource ColorBorder}" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource ColorBackground}" HeightRequest="56" WidthRequest="48">
                                    <Entry x:Name="Pin3" MaxLength="1" Keyboard="Numeric" FontSize="24" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" BackgroundColor="Transparent" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" HeightRequest="50"/>
                                </Border>
                                <Border Grid.Column="3" Stroke="{StaticResource ColorBorder}" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource ColorBackground}" HeightRequest="56" WidthRequest="48">
                                    <Entry x:Name="Pin4" MaxLength="1" Keyboard="Numeric" FontSize="24" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" BackgroundColor="Transparent" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" HeightRequest="50"/>
                                </Border>
                                <Border Grid.Column="4" Stroke="{StaticResource ColorBorder}" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource ColorBackground}" HeightRequest="56" WidthRequest="48">
                                    <Entry x:Name="Pin5" MaxLength="1" Keyboard="Numeric" FontSize="24" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" BackgroundColor="Transparent" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" HeightRequest="50"/>
                                </Border>
                                <Border Grid.Column="5" Stroke="{StaticResource ColorBorder}" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource ColorBackground}" HeightRequest="56" WidthRequest="48">
                                    <Entry x:Name="Pin6" MaxLength="1" Keyboard="Numeric" FontSize="24" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" BackgroundColor="Transparent" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" HeightRequest="50"/>
                                </Border>
                            </Grid>

                            <!-- Timer -->
                            <Label x:Name="LblTimer" Text="" FontFamily="OpenSansRegular" FontSize="13" TextColor="{StaticResource ColorTextMuted}" HorizontalOptions="Center"/>

                            <Button x:Name="BtnVerificar" Text="{loc:T verificar_codigo}" BackgroundColor="{StaticResource ColorPrimary}" TextColor="{StaticResource ColorSurface}" FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="16" HeightRequest="56" Clicked="OnVerificarClicked" Margin="0,4,0,0"
                                    Pressed="OnBotonPresionado" Released="OnBotonSoltado">
                                <Button.Shadow>
                                    <Shadow Brush="{StaticResource ColorPrimary}" Offset="0,8" Radius="16" Opacity="0.28" />
                                </Button.Shadow>
                            </Button>

                            <!-- Resend Code -->
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                                <Label Text="{loc:T no_recibiste_el_codigo}" FontFamily="OpenSansRegular" FontSize="13" TextColor="{StaticResource ColorTextMuted}" />
                                <Label x:Name="LblReenviar" Text="{loc:T reenviar}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource ColorPrimary}" Padding="0,8">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnReenviarTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
