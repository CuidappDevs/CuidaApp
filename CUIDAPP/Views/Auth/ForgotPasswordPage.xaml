<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CUIDAPP.Views.Auth.ForgotPasswordPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F9FA">
    <Grid>
        <Grid RowDefinitions="Auto, *">
            <!-- Top Bar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="20,15,20,10">
                <ContentView x:Name="BtnBack" VerticalOptions="Center">
                    <ContentView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </ContentView.GestureRecognizers>
                    <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="#4024A2" Aspect="Uniform" WidthRequest="22" HeightRequest="22" />
                </ContentView>
                <Label Grid.Column="1" Text="Recuperar contraseña" FontSize="18" FontFamily="OpenSansSemibold" TextColor="#4024A2" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="25,20" Spacing="25">
                    
                    <!-- STEP 1: Email -->
                    <VerticalStackLayout x:Name="Step1" Spacing="20" IsVisible="True">
                        <Path Data="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 4C13.66 4 15 5.34 15 7C15 8.66 13.66 10 12 10C10.34 10 9 8.66 9 7C9 5.34 10.34 4 12 4ZM16 18H8V16C8 13.34 13.33 12 16 12C16 12 16 12.01 16 12.01V18Z" Fill="#4024A2" Aspect="Uniform" WidthRequest="60" HeightRequest="60" HorizontalOptions="Center" Margin="0,30,0,0"/>
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                            <Label Text="¿Olvidaste tu contraseña?" FontFamily="OpenSansSemibold" FontSize="24" TextColor="#111827" HorizontalOptions="Center" />
                            <Label Text="Ingresa tu correo y te enviaremos un código" FontFamily="OpenSansRegular" FontSize="14" TextColor="#6B7280" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Correo electrónico" FontFamily="OpenSansSemibold" FontSize="13" TextColor="#374151" />
                            <Border Stroke="#D1D5DB" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="15,2">
                                <Entry x:Name="EntryEmail" Placeholder="ejemplo@correo.com" FontFamily="OpenSansRegular" PlaceholderColor="#9CA3AF" TextColor="#111827" FontSize="15" BackgroundColor="Transparent" ClearButtonVisibility="WhileEditing" HeightRequest="45" Keyboard="Email" />
                            </Border>
                        </VerticalStackLayout>
                        <Button x:Name="BtnEnviar" Text="Enviar código" BackgroundColor="#4024A2" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="12" HeightRequest="55" Clicked="OnEnviarClicked" Margin="0,10,0,0"/>
                    </VerticalStackLayout>

                    <!-- STEP 2: Código + Contraseña -->
                    <VerticalStackLayout x:Name="Step2" Spacing="20" IsVisible="False">
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                            <Label Text="Ingresa el código" FontFamily="OpenSansSemibold" FontSize="24" TextColor="#111827" HorizontalOptions="Center" />
                            <Label x:Name="LblEmail" Text="" FontFamily="OpenSansRegular" FontSize="14" TextColor="#6B7280" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Código de 6 dígitos" FontFamily="OpenSansSemibold" FontSize="13" TextColor="#374151" />
                            <Border Stroke="#D1D5DB" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="15,2">
                                <Entry x:Name="EntryCode" Placeholder="000000" FontFamily="OpenSansRegular" PlaceholderColor="#9CA3AF" TextColor="#111827" FontSize="20" BackgroundColor="Transparent" HeightRequest="45" Keyboard="Numeric" MaxLength="6" HorizontalTextAlignment="Center"/>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Nueva contraseña" FontFamily="OpenSansSemibold" FontSize="13" TextColor="#374151" />
                            <Border Stroke="#D1D5DB" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="15,2">
                                <Entry x:Name="EntryNewPass" IsPassword="True" Placeholder="Mínimo 6 caracteres" FontFamily="OpenSansRegular" PlaceholderColor="#9CA3AF" TextColor="#111827" FontSize="15" BackgroundColor="Transparent" HeightRequest="45" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Confirmar contraseña" FontFamily="OpenSansSemibold" FontSize="13" TextColor="#374151" />
                            <Border Stroke="#D1D5DB" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="15,2">
                                <Entry x:Name="EntryConfirmPass" IsPassword="True" Placeholder="Repite tu contraseña" FontFamily="OpenSansRegular" PlaceholderColor="#9CA3AF" TextColor="#111827" FontSize="15" BackgroundColor="Transparent" HeightRequest="45" />
                            </Border>
                        </VerticalStackLayout>
                        <Button x:Name="BtnRestablecer" Text="Restablecer contraseña" BackgroundColor="#4024A2" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="12" HeightRequest="55" Clicked="OnRestablecerClicked" Margin="0,10,0,0"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
