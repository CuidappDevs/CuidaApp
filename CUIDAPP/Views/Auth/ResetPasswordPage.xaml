<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CUIDAPP.Views.Auth.ResetPasswordPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F9FA">
    <Grid>
        <Grid RowDefinitions="Auto, *">
            <!-- Top Bar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="20,15,20,10">
                <ContentView x:Name="BtnBack" VerticalOptions="Center">
                    <ContentView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </ContentView.GestureRecognizers>
                    <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="#4024A2" Aspect="Uniform" WidthRequest="22" HeightRequest="22" />
                </ContentView>
                <Label Grid.Column="1" Text="Nueva contraseña" FontSize="18" FontFamily="OpenSansSemibold" TextColor="#4024A2" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="25,20" Spacing="25">
                    
                    <!-- Icon -->
                    <Path Data="M18 8H17V6C17 3.24 14.76 1 12 1C9.24 1 7 3.24 7 6V8H6C4.9 8 4 8.9 4 10V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V10C20 8.9 19.1 8 18 8ZM12 17C10.9 17 10 16.1 10 15C10 13.9 10.9 13 12 13C13.1 13 14 13.9 14 15C14 16.1 13.1 17 12 17ZM15.1 8H8.9V6C8.9 4.29 10.29 2.9 12 2.9C13.71 2.9 15.1 4.29 15.1 6V8Z" Fill="#4024A2" Aspect="Uniform" WidthRequest="60" HeightRequest="60" HorizontalOptions="Center" Margin="0,30,0,0"/>
                    
                    <!-- Titles -->
                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Text="Crea tu nueva contraseña" FontFamily="OpenSansSemibold" FontSize="24" TextColor="#111827" HorizontalOptions="Center" />
                        <Label Text="La contraseña debe tener al menos 6 caracteres" FontFamily="OpenSansRegular" FontSize="14" TextColor="#6B7280" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <!-- New Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nueva contraseña" FontFamily="OpenSansSemibold" FontSize="13" TextColor="#374151" />
                        <Border Stroke="#D1D5DB" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="15,2">
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry x:Name="EntryNewPass" IsPassword="True" Placeholder="Mínimo 6 caracteres" FontFamily="OpenSansRegular" PlaceholderColor="#9CA3AF" TextColor="#111827" FontSize="15" BackgroundColor="Transparent" Grid.Column="0" HeightRequest="45" />
                                <Path Grid.Column="1" Data="M12 4.5C7 4.5 2.73 7.61 1 12C2.73 16.39 7 19.5 12 19.5C17 19.5 21.27 16.39 23 12C21.27 7.61 17 4.5 12 4.5ZM12 17C9.24 17 7 14.76 7 12C7 9.24 9.24 7 12 7C14.76 7 17 9.24 17 12C17 14.76 14.76 17 12 17ZM12 9C10.34 9 9 10.34 9 12C9 13.66 10.34 15 12 15C13.66 15 15 13.66 15 12C15 10.34 13.66 9 12 9Z" Fill="#A0AABF" Aspect="Uniform" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Margin="0,0,5,0" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Confirm Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Confirmar contraseña" FontFamily="OpenSansSemibold" FontSize="13" TextColor="#374151" />
                        <Border Stroke="#D1D5DB" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="15,2">
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry x:Name="EntryConfirmPass" IsPassword="True" Placeholder="Repite tu contraseña" FontFamily="OpenSansRegular" PlaceholderColor="#9CA3AF" TextColor="#111827" FontSize="15" BackgroundColor="Transparent" Grid.Column="0" HeightRequest="45" />
                                <Path Grid.Column="1" Data="M12 4.5C7 4.5 2.73 7.61 1 12C2.73 16.39 7 19.5 12 19.5C17 19.5 21.27 16.39 23 12C21.27 7.61 17 4.5 12 4.5ZM12 17C9.24 17 7 14.76 7 12C7 9.24 9.24 7 12 7C14.76 7 17 9.24 17 12C17 14.76 14.76 17 12 17ZM12 9C10.34 9 9 10.34 9 12C9 13.66 10.34 15 12 15C13.66 15 15 13.66 15 12C15 10.34 13.66 9 12 9Z" Fill="#A0AABF" Aspect="Uniform" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Margin="0,0,5,0" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password Match Indicator -->
                    <Label x:Name="LblMatch" Text="" FontFamily="OpenSansRegular" FontSize="12" HorizontalOptions="Center" IsVisible="False"/>

                    <!-- Reset Button -->
                    <Button x:Name="BtnRestablecer" Text="Restablecer contraseña" BackgroundColor="#4024A2" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="12" HeightRequest="55" Clicked="OnRestablecerClicked" Margin="0,10,0,0"/>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
