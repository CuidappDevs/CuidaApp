<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CUIDAPP.Views.Dinero.DineroPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F9FAFB">

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- HEADER -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20,15,20,10" BackgroundColor="White">
            <ContentView x:Name="BtnBack" VerticalOptions="Center">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </ContentView.GestureRecognizers>
                <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="#111827" Aspect="Uniform" WidthRequest="22" HeightRequest="22" />
            </ContentView>
            
            <Label Grid.Column="1" Text="Billetera" FontSize="18" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <!-- CONTENIDO -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,40" Spacing="25">
                
                <!-- Tarjeta Principal de Balance -->
                <Border Stroke="Transparent" BackgroundColor="#5A31F4" StrokeShape="RoundRectangle 24" Padding="25">
                    <Border.Shadow>
                        <Shadow Brush="#5A31F4" Offset="0,8" Opacity="0.3" Radius="15"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="Total cobrado" FontSize="14" FontFamily="OpenSansRegular" TextColor="#D8B4FE"/>
                        <Label x:Name="LblTotalCobrado" Text="RD$ 0.00" FontSize="36" FontFamily="OpenSansBold" TextColor="White"/>

                        <BoxView HeightRequest="1" Color="#8B5CF6" Margin="0,5,0,5"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Pendiente por cobrar" FontSize="13" FontFamily="OpenSansRegular" TextColor="#D8B4FE" VerticalOptions="Center"/>
                            <Label x:Name="LblPendiente" Grid.Column="1" Text="RD$ 0.00" FontSize="16" FontFamily="OpenSansSemibold" TextColor="White" VerticalOptions="Center"/>
                        </Grid>
                        <Label Text="Los pagos pendientes se procesan desde administración." FontSize="11" FontFamily="OpenSansRegular" TextColor="#D8B4FE"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Historial de Ingresos -->
                <VerticalStackLayout Spacing="15">
                    <Label Text="Historial de pagos" FontSize="18" FontFamily="OpenSansSemibold" TextColor="#111827" Margin="0,0,0,5"/>

                    <VerticalStackLayout x:Name="ListaPagos" Spacing="12" />
                    <Label x:Name="LblSinPagos" Text="Aún no tienes pagos registrados." FontSize="13" FontFamily="OpenSansRegular" TextColor="#9CA3AF" HorizontalOptions="Center" IsVisible="False" Margin="0,20,0,0"/>
                    <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" Color="#5A31F4" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTTOM TAB BAR (Hardcoded con Dinero Activo) -->
        <Border Grid.Row="2" Stroke="#F3F4F6" StrokeThickness="1" BackgroundColor="White" Padding="15,10" StrokeShape="RoundRectangle 0">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-4" Opacity="0.05" Radius="10"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*,*,*,*">
                <!-- Inicio (Inactivo) -->
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInicioTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Path Data="M10 20V14H14V20H19V12H22L12 3L2 12H5V20H10Z" Fill="#9CA3AF" Aspect="Uniform" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"/>
                    <Label Text="Inicio" FontSize="10" FontFamily="OpenSansRegular" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Trabajos (Inactivo) -->
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTrabajosTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Path Data="M20 6H16V4C16 2.9 15.1 2 14 2H10C8.9 2 8 2.9 8 4V6H4C2.9 6 2.01 6.9 2.01 8L2 19C2 20.1 2.9 21 4 21H20C21.1 21 22 20.1 22 19V8C22 6.9 21.1 6 20 6ZM10 4H14V6H10V4ZM20 19H4V8H20V19Z" Fill="#9CA3AF" Aspect="Uniform" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"/>
                    <Label Text="Trabajos" FontSize="10" FontFamily="OpenSansRegular" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Dinero (Activo) -->
                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <Path Data="M21 7.28V5C21 3.9 20.1 3 19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V16.72C21.59 16.37 22 15.74 22 15V9C22 8.26 21.59 7.63 21 7.28ZM20 15H13V9H20V15ZM5 19V5H19V7H13C11.9 7 11 7.9 11 9V15C11 16.1 11.9 17 13 17H19V19H5ZM16 13.5C15.17 13.5 14.5 12.83 14.5 12C14.5 11.17 15.17 10.5 16 10.5C16.83 10.5 17.5 11.17 17.5 12C17.5 12.83 16.83 13.5 16 13.5Z" Fill="#5A31F4" Aspect="Uniform" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"/>
                    <Label Text="Dinero" FontSize="10" FontFamily="OpenSansSemibold" TextColor="#5A31F4" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Perfil (Inactivo) -->
                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPerfilTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Path Data="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z" Fill="#9CA3AF" Aspect="Uniform" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"/>
                    <Label Text="Perfil" FontSize="10" FontFamily="OpenSansRegular" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>

</ContentPage>
