<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:CUIDAPP.Localization"
             x:Class="CUIDAPP.Views.Dinero.DineroPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ColorBackground}">

    <Grid RowDefinitions="Auto, *, Auto">
        
        <Grid Grid.Row="0" ColumnDefinitions="44, *, 44" Padding="12,8,16,8" BackgroundColor="{StaticResource ColorBackground}">
            <Border x:Name="BtnBack" Stroke="Transparent" BackgroundColor="{StaticResource ColorSurface}" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="{StaticResource ColorTextStrong}" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Grid.Column="1" Text="{loc:T billetera}" FontSize="17" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <!-- CONTENIDO -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,28" Spacing="22">
                
                <!-- Tarjeta de balance -->
                <Border x:Name="CardBalance" Stroke="Transparent" StrokeShape="RoundRectangle 26" Padding="22">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2A63B8" Offset="0" />
                            <GradientStop Color="{StaticResource ColorPrimary}" Offset="0.6" />
                            <GradientStop Color="{StaticResource ColorPrimaryDark}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource ColorPrimary}" Offset="0,12" Opacity="0.3" Radius="20"/>
                    </Border.Shadow>
                    <Grid>
                        <Ellipse Fill="#14FFFFFF" WidthRequest="170" HeightRequest="170" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-75,-65,0"/>
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{loc:T total_cobrado}" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#D9E6F7"/>
                                    <Label x:Name="LblTotalCobrado" Text="{loc:T rd_0_00}" FontSize="36" FontFamily="OpenSansSemibold" TextColor="White"/>
                                </VerticalStackLayout>
                                <Border Grid.Column="1" Stroke="Transparent" BackgroundColor="#26FFFFFF" WidthRequest="46" HeightRequest="46" VerticalOptions="Start">
                                    <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                    <Path Data="M21 7.28V5C21 3.9 20.1 3 19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V16.72C21.59 16.37 22 15.74 22 15V9C22 8.26 21.59 7.63 21 7.28ZM20 15H13V9H20V15ZM5 19V5H19V7H13C11.9 7 11 7.9 11 9V15C11 16.1 11.9 17 13 17H19V19H5ZM16 13.5C15.17 13.5 14.5 12.83 14.5 12C14.5 11.17 15.17 10.5 16 10.5C16.83 10.5 17.5 11.17 17.5 12C17.5 12.83 16.83 13.5 16 13.5Z" Fill="White" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                            </Grid>

                            <Border Stroke="Transparent" BackgroundColor="#1FFFFFFF" StrokeShape="RoundRectangle 16" Padding="14,12">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Path Data="M11.99 2C6.47 2 2 6.48 2 12C2 17.52 6.47 22 11.99 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 11.99 2ZM12 20C7.58 20 4 16.42 4 12C4 7.58 7.58 4 12 4C16.42 4 20 7.58 20 12C20 16.42 16.42 20 12 20ZM12.5 7H11V13L16.25 16.15L17 14.92L12.5 12.25V7Z" Fill="#FFD27A" Aspect="Uniform" WidthRequest="14" HeightRequest="14" VerticalOptions="Center"/>
                                            <Label Text="{loc:T pendiente_por_cobrar}" FontSize="13" FontFamily="OpenSansRegular" TextColor="#D9E6F7" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        <Label x:Name="LblPendiente" Grid.Column="1" Text="{loc:T rd_0_00}" FontSize="17" FontFamily="OpenSansSemibold" TextColor="White" VerticalOptions="Center"/>
                                    </Grid>
                                    <Label Text="{loc:T los_pagos_pendientes_se_procesan}" FontSize="11" FontFamily="OpenSansRegular" TextColor="#C9D9F0"/>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Historial de Ingresos -->
                <VerticalStackLayout Spacing="15">
                    <Label Text="{loc:T historial_de_pagos}" FontSize="17" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}"/>

                    <VerticalStackLayout x:Name="ListaPagos" Spacing="12" />
                    <VerticalStackLayout x:Name="LblSinPagos" Spacing="12" IsVisible="False" Margin="0,20,0,0" HorizontalOptions="Center">
                        <Border Stroke="Transparent" BackgroundColor="{StaticResource ColorSuccessSoft}" WidthRequest="80" HeightRequest="80" HorizontalOptions="Center">
                            <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                            <Path Data="M11.8 10.9C9.53 10.31 8.8 9.7 8.8 8.75C8.8 7.66 9.81 6.9 11.5 6.9C13.28 6.9 13.94 7.75 14 9H16.21C16.14 7.28 15.09 5.7 13 5.19V3H10V5.16C8.06 5.58 6.5 6.84 6.5 8.77C6.5 11.08 8.41 12.23 11.2 12.9C13.7 13.5 14.2 14.38 14.2 15.31C14.2 16 13.71 17.1 11.5 17.1C9.44 17.1 8.63 16.18 8.52 15H6.32C6.44 17.19 8.08 18.42 10 18.83V21H13V18.85C14.95 18.48 16.5 17.35 16.5 15.3C16.5 12.46 14.07 11.49 11.8 10.9Z" Fill="{StaticResource ColorSuccess}" Aspect="Uniform" WidthRequest="34" HeightRequest="34" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="{loc:T aun_no_tienes_pagos_registrados}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextMuted}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                    <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" Color="{StaticResource ColorPrimary}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- BARRA DE PESTAÑAS (fila propia de la cuadrícula) -->
        <Border Grid.Row="2" Stroke="Transparent" BackgroundColor="{StaticResource ColorSurface}" Padding="12,8,12,8" StrokeShape="RoundRectangle 24,24,0,0">
            <Border.Shadow>
                <Shadow Brush="{StaticResource ColorShadow}" Offset="0,-6" Opacity="0.07" Radius="16"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*,*,*,*">
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center" Padding="12,6">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInicioTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Path Data="M10 20V14H14V20H19V12H22L12 3L2 12H5V20H10Z" Fill="{StaticResource ColorTextMuted}" Aspect="Uniform" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center"/>
                    <Label Text="{loc:T inicio}" FontSize="10" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center" Padding="12,6">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTrabajosTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Path Data="M20 6H16V4C16 2.9 15.1 2 14 2H10C8.9 2 8 2.9 8 4V6H4C2.9 6 2.01 6.9 2.01 8L2 19C2 20.1 2.9 21 4 21H20C21.1 21 22 20.1 22 19V8C22 6.9 21.1 6 20 6ZM10 4H14V6H10V4ZM20 19H4V8H20V19Z" Fill="{StaticResource ColorTextMuted}" Aspect="Uniform" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center"/>
                    <Label Text="{loc:T trabajos}" FontSize="10" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Dinero (activa) -->
                <Border Grid.Column="2" Stroke="Transparent" BackgroundColor="{StaticResource ColorPrimarySoft}" StrokeShape="RoundRectangle 18" Padding="0,6" Margin="6,0">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Path Data="M21 7.28V5C21 3.9 20.1 3 19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V16.72C21.59 16.37 22 15.74 22 15V9C22 8.26 21.59 7.63 21 7.28ZM20 15H13V9H20V15ZM5 19V5H19V7H13C11.9 7 11 7.9 11 9V15C11 16.1 11.9 17 13 17H19V19H5ZM16 13.5C15.17 13.5 14.5 12.83 14.5 12C14.5 11.17 15.17 10.5 16 10.5C16.83 10.5 17.5 11.17 17.5 12C17.5 12.83 16.83 13.5 16 13.5Z" Fill="{StaticResource ColorPrimary}" Aspect="Uniform" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center"/>
                        <Label Text="{loc:T dinero}" FontSize="10" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorPrimary}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center" Padding="12,6">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPerfilTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Path Data="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z" Fill="{StaticResource ColorTextMuted}" Aspect="Uniform" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center"/>
                    <Label Text="{loc:T perfil}" FontSize="10" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>

</ContentPage>
