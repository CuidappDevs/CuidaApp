<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CUIDAPP.Views.Perfil.CuidadorPerfilPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F9FAFB">

    <Grid RowDefinitions="*, Auto">
        
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">
                
                <!-- PORTADA Y HEADER INMERSIVO FIX -->
                <Grid>
                    <!-- Fondo degradado/portada -->
                    <Border Stroke="Transparent" BackgroundColor="#2563EB" HeightRequest="160" VerticalOptions="Start" StrokeShape="Rectangle">
                        <!-- Botón Volver sutil -->
                        <ContentView HorizontalOptions="Start" VerticalOptions="Start" Margin="20,20,0,0">
                            <ContentView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackTapped" />
                            </ContentView.GestureRecognizers>
                            <Border Stroke="Transparent" BackgroundColor="#40000000" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40">
                                <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="White" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </ContentView>
                    </Border>
                    
                    <!-- Tarjeta Principal del Perfil superpuesta -->
                    <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 24" Margin="20,100,20,0" Padding="20,50,20,25">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,10" Opacity="0.05" Radius="20"/>
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                            <!-- Nombre y Especialidad -->
                            <Label x:Name="LblNombre" Text="" FontSize="26" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                            <Label x:Name="LblEspecialidad" Text="" FontSize="15" FontFamily="OpenSansSemibold" TextColor="#2563EB" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Foto de Perfil Absoluta -->
                    <Border Stroke="White" StrokeThickness="4" StrokeShape="RoundRectangle 60" BackgroundColor="#E5E7EB" WidthRequest="120" HeightRequest="120" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,40,0,0">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,4" Opacity="0.1" Radius="10"/>
                        </Border.Shadow>
                        <Image x:Name="ImgFotoPerfilGrande" Aspect="AspectFill" />
                    </Border>
                </Grid>

                <!-- STATS ROW -->
                <Grid ColumnDefinitions="*, *" Padding="20,25,20,10" ColumnSpacing="15">
                    <VerticalStackLayout Grid.Column="0" Spacing="5" HorizontalOptions="Center">
                        <Label x:Name="LblTrabajosCompletados" Text="0" FontSize="18" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Center"/>
                        <Label Text="Trabajos completados" FontSize="12" FontFamily="OpenSansRegular" TextColor="#6B7280" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="5" HorizontalOptions="Center">
                        <Label x:Name="LblEstadoCuenta" Text="Pendiente" FontSize="18" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Center"/>
                        <Label Text="Estado de cuenta" FontSize="12" FontFamily="OpenSansRegular" TextColor="#6B7280" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- DETALLES Y BIO -->
                <VerticalStackLayout Padding="20,15,20,40" Spacing="25">
                    
                    <!-- CARNET DIGITAL (NUEVO) -->
                    <Label Text="Carnet Digital" FontSize="16" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                    <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="0,15,0,0">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,4" Opacity="0.05" Radius="10"/>
                        </Border.Shadow>
                        <VerticalStackLayout>
                            <!-- Hueco superior del gafete -->
                            <Border Stroke="Transparent" BackgroundColor="#F3F4F6" StrokeShape="RoundRectangle 10" WidthRequest="40" HeightRequest="8" HorizontalOptions="Center" Margin="0,0,0,10"/>
                            
                            <Grid ColumnDefinitions="*, *" Padding="15,0,15,10">
                                <!-- Lado Izquierdo (Foto y Nombre) -->
                                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" Spacing="5">
                                    <Border Stroke="#E5E7EB" StrokeThickness="2" StrokeShape="RoundRectangle 40" BackgroundColor="#F3F4F6" WidthRequest="70" HeightRequest="70" HorizontalOptions="Center">
                                        <Image x:Name="ImgFotoCarnet" Aspect="AspectFill" />
                                    </Border>
                                    <Label x:Name="LblNombreCarnet" Text="" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Center"/>
                                    <Label Text="Cuidador/a" FontSize="11" FontFamily="OpenSansRegular" TextColor="#6B7280" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                                
                                <!-- Lado Derecho (Logo y QR) -->
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="5">
                                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="2">
                                        <Path Data="M12 21.35L10.55 20.03C5.4 15.36 2 12.28 2 8.5C2 5.42 4.42 3 7.5 3C9.24 3 10.91 3.81 12 5.09C13.09 3.81 14.76 3 16.5 3C19.58 3 22 5.42 22 8.5C22 12.28 18.6 15.36 13.45 20.04L12 21.35Z" Fill="#1D4ED8" Aspect="Uniform" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"/>
                                        <Label Text="CuidApp" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#1D4ED8" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    
                                    <!-- QR Simulado (Imagen placeholder) -->
                                    <Image Source="https://api.qrserver.com/v1/create-qr-code/?size=100x100&amp;data=CuidApp_MariaGonzalez" WidthRequest="70" HeightRequest="70" HorizontalOptions="Center" Margin="0,5,0,0"/>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Banner inferior del carnet -->
                            <Border Stroke="Transparent" BackgroundColor="#1D4ED8" Padding="10" Margin="0,10,0,0">
                                <Label x:Name="LblEspecialidadBanner" Text="" FontSize="10" FontFamily="OpenSansSemibold" TextColor="White" HorizontalOptions="Center" CharacterSpacing="1"/>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Tarjeta de Verificaciones (Confianza) -->
                    <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="20">
                        <VerticalStackLayout Spacing="15">
                            <Label Text="Verificaciones de Seguridad" FontSize="16" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                            <VerticalStackLayout x:Name="ListaVerificaciones" Spacing="15" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Biografía -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Sobre mí" FontSize="18" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                        <Label x:Name="LblBio" Text="" FontSize="14" FontFamily="OpenSansRegular" TextColor="#4B5563" LineHeight="1.5"/>
                    </VerticalStackLayout>

                    <!-- Tarifa por hora -->
                    <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="20">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="Tarifa base" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                                <Label x:Name="LblEspecialidadTarifa" Text="" FontSize="12" FontFamily="OpenSansRegular" TextColor="#6B7280"/>
                            </VerticalStackLayout>
                            <Label x:Name="LblTarifa" Grid.Column="1" Text="" FontSize="18" FontFamily="OpenSansSemibold" TextColor="#2563EB" VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <!-- Mis calificaciones -->
                    <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="20">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMisCalificacionesTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Mis calificaciones" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#111827" VerticalOptions="Center"/>
                            <Path Grid.Column="1" Data="M8.59 16.59L13.17 12L8.59 7.41L10 6L16 12L10 18L8.59 16.59Z" Fill="#9CA3AF" Aspect="Uniform" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <!-- Soporte -->
                    <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="20">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSoporteTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Soporte / Reportar un problema" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#111827" VerticalOptions="Center"/>
                            <Path Grid.Column="1" Data="M8.59 16.59L13.17 12L8.59 7.41L10 6L16 12L10 18L8.59 16.59Z" Fill="#9CA3AF" Aspect="Uniform" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTTOM TAB BAR (Hardcoded con Perfil Activo) -->
        <Border Grid.Row="1" Stroke="#F3F4F6" StrokeThickness="1" BackgroundColor="White" Padding="15,10" StrokeShape="RoundRectangle 0">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-4" Opacity="0.05" Radius="10"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*,*,*,*">
                <!-- Inicio (Inactivo) -->
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInicioTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Path Data="M10 20V14H14V20H19V12H22L12 3L2 12H5V20H10Z" Fill="#9CA3AF" Aspect="Uniform" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"/>
                    <Label Text="Inicio" FontSize="10" FontFamily="OpenSansRegular" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Trabajos -->
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTrabajosTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Path Data="M20 6H16V4C16 2.9 15.1 2 14 2H10C8.9 2 8 2.9 8 4V6H4C2.9 6 2.01 6.9 2.01 8L2 19C2 20.1 2.9 21 4 21H20C21.1 21 22 20.1 22 19V8C22 6.9 21.1 6 20 6ZM10 4H14V6H10V4ZM20 19H4V8H20V19Z" Fill="#9CA3AF" Aspect="Uniform" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"/>
                    <Label Text="Trabajos" FontSize="10" FontFamily="OpenSansRegular" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Dinero -->
                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDineroTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Path Data="M21 7.28V5C21 3.9 20.1 3 19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V16.72C21.59 16.37 22 15.74 22 15V9C22 8.26 21.59 7.63 21 7.28ZM20 15H13V9H20V15ZM5 19V5H19V7H13C11.9 7 11 7.9 11 9V15C11 16.1 11.9 17 13 17H19V19H5ZM16 13.5C15.17 13.5 14.5 12.83 14.5 12C14.5 11.17 15.17 10.5 16 10.5C16.83 10.5 17.5 11.17 17.5 12C17.5 12.83 16.83 13.5 16 13.5Z" Fill="#9CA3AF" Aspect="Uniform" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"/>
                    <Label Text="Dinero" FontSize="10" FontFamily="OpenSansRegular" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Perfil (Activo) -->
                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <Path Data="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z" Fill="#2563EB" Aspect="Uniform" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"/>
                    <Label Text="Perfil" FontSize="10" FontFamily="OpenSansSemibold" TextColor="#2563EB" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>

</ContentPage>
