<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:CUIDAPP.Localization"
             x:Class="CUIDAPP.Views.Perfil.MiHorarioPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ColorBackground}"
             SafeAreaEdges="None">

    <Grid RowDefinitions="Auto, *" SafeAreaEdges="None">

        <!-- ENCABEZADO (borde a borde) -->
        <Grid Grid.Row="0" SafeAreaEdges="None" Padding="0,0,0,40">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#2A63B8" Offset="0.0" />
                    <GradientStop Color="{StaticResource ColorPrimary}" Offset="0.6" />
                    <GradientStop Color="{StaticResource ColorPrimaryDark}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Ellipse Fill="#14FFFFFF" WidthRequest="220" HeightRequest="220" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-90,-80,0"/>

            <VerticalStackLayout x:Name="ContenidoEncabezado" Spacing="14">
                <Grid ColumnDefinitions="44,*,44" Padding="12,10">
                    <Border Stroke="Transparent" BackgroundColor="#26FFFFFF" WidthRequest="44" HeightRequest="44">
                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Border.GestureRecognizers>
                        <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="White" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Grid.Column="1" Text="{loc:T mi_horario_titulo}" FontSize="17" FontFamily="OpenSansSemibold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="20,0">
                    <Border Stroke="Transparent" BackgroundColor="#26FFFFFF" StrokeShape="RoundRectangle 14" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                        <Path Data="M11.99 2C6.47 2 2 6.48 2 12C2 17.52 6.47 22 11.99 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 11.99 2ZM12 20C7.58 20 4 16.42 4 12C4 7.58 7.58 4 12 4C16.42 4 20 7.58 20 12C20 16.42 16.42 20 12 20ZM12.5 7H11V13L16.25 16.15L17 14.92L12.5 12.25V7Z" Fill="White" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Grid.Column="1" Text="{loc:T horario_encabezado}" FontSize="15" FontFamily="OpenSansSemibold" TextColor="White" VerticalOptions="Center"/>
                </Grid>
            </VerticalStackLayout>
        </Grid>

        <!-- Hoja -->
        <Border Grid.Row="1" Margin="0,-28,0,0" Stroke="Transparent" BackgroundColor="{StaticResource ColorBackground}" StrokeShape="RoundRectangle 28,28,0,0">
            <Grid>
                <ActivityIndicator x:Name="Cargando" IsRunning="True" IsVisible="True" Color="{StaticResource ColorPrimary}" VerticalOptions="Center" HorizontalOptions="Center"/>

                <ScrollView x:Name="Contenido" IsVisible="False">
                    <VerticalStackLayout Padding="20,24,20,0" Spacing="16">

                        <!-- Modo -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Border x:Name="OpcionManual" Stroke="{StaticResource ColorBorder}" StrokeThickness="1.5" BackgroundColor="{StaticResource ColorSurface}" StrokeShape="RoundRectangle 18" Padding="14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnManualTapped" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{loc:T horario_modo_manual}" FontSize="15" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}"/>
                                        <Ellipse x:Name="MarcaManual" Grid.Column="1" WidthRequest="18" HeightRequest="18" StrokeThickness="2" Stroke="{StaticResource ColorBorder}"/>
                                    </Grid>
                                    <Label Text="{loc:T horario_modo_manual_desc}" FontSize="12" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border x:Name="OpcionAuto" Grid.Column="1" Stroke="{StaticResource ColorBorder}" StrokeThickness="1.5" BackgroundColor="{StaticResource ColorSurface}" StrokeShape="RoundRectangle 18" Padding="14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAutoTapped" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{loc:T horario_modo_auto}" FontSize="15" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}"/>
                                        <Ellipse x:Name="MarcaAuto" Grid.Column="1" WidthRequest="18" HeightRequest="18" StrokeThickness="2" Stroke="{StaticResource ColorBorder}"/>
                                    </Grid>
                                    <Label Text="{loc:T horario_modo_auto_desc}" FontSize="12" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Días (solo en modo horario) -->
                        <VerticalStackLayout x:Name="BloqueDias" Spacing="12" IsVisible="False">
                            <Border Stroke="Transparent" BackgroundColor="{StaticResource ColorPrimarySoft}" StrokeShape="RoundRectangle 16" Padding="14,12">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Path Data="M11 7H13V9H11V7ZM11 11H13V17H11V11ZM12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20Z" Fill="{StaticResource ColorPrimary}" Aspect="Uniform" WidthRequest="18" HeightRequest="18" VerticalOptions="Start"/>
                                    <Label Grid.Column="1" Text="{loc:T horario_info_auto}" FontSize="12.5" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextStrong}"/>
                                </Grid>
                            </Border>

                            <Label Text="{loc:T horario_dias_titulo}" FontSize="15" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" Margin="2,4,0,0"/>
                            <Border Stroke="Transparent" BackgroundColor="{StaticResource ColorSurface}" StrokeShape="RoundRectangle 20" Padding="0">
                                <VerticalStackLayout x:Name="ListaDias"/>
                            </Border>
                            <Label x:Name="BtnCopiarLunes" Text="{loc:T horario_copiar_lunes}" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorPrimary}" HorizontalOptions="Center" Padding="8">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCopiarLunesTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>

                        <!-- Guardar (dentro del contenido, nunca anclado al borde inferior) -->
                        <Border x:Name="BtnGuardar" Stroke="Transparent" BackgroundColor="{StaticResource ColorPrimary}" StrokeShape="RoundRectangle 16" HeightRequest="52" Margin="0,4,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGuardarTapped" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <Label x:Name="LblGuardar" Text="{loc:T horario_guardar}" FontSize="15" FontFamily="OpenSansSemibold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <ActivityIndicator x:Name="GuardandoIndicador" IsRunning="False" IsVisible="False" Color="White" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <ContentView x:Name="EspacioInferior"/>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
