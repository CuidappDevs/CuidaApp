<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CUIDAPP.Views.Dashboard.CuidadorDashboardPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFFFFF">

    <Grid RowDefinitions="*, Auto">
        
        <!-- Contenido principal -->
        <ScrollView Grid.Row="0">
            <Grid Padding="20,20,20,30" RowSpacing="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Main Card -->
                    <RowDefinition Height="Auto"/> <!-- Próximo Trabajo -->
                    <RowDefinition Height="Auto"/> <!-- Acciones -->
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, Auto">
                    <!-- Foto perfil -->
                    <Grid Grid.Column="0" WidthRequest="50" HeightRequest="50" Margin="0,0,15,0">
                        <Border Stroke="Transparent" StrokeShape="RoundRectangle 25" BackgroundColor="#E5E7EB" WidthRequest="50" HeightRequest="50">
                            <Image x:Name="ImgFotoPerfil" Aspect="AspectFill" />
                        </Border>
                    </Grid>

                    <!-- Textos Header -->
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label x:Name="LblSaludo" Text="Hola" FontSize="20" FontFamily="OpenSansSemibold" TextColor="#4024A2"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDisponibilidadTapped" />
                            </HorizontalStackLayout.GestureRecognizers>
                            <Border x:Name="IndicadorDisponible" Stroke="Transparent" BackgroundColor="#9CA3AF" StrokeShape="RoundRectangle 4" WidthRequest="8" HeightRequest="8" VerticalOptions="Center"/>
                            <Label x:Name="LblDisponible" Text="No disponible" FontSize="12" FontFamily="OpenSansSemibold" TextColor="#6B7280"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Campana de Notificación -->
                    <Grid Grid.Column="2" WidthRequest="40" HeightRequest="40" Margin="0,0,10,0" VerticalOptions="Center">
                        <Border Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40" BackgroundColor="White">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNotificacionesTapped" />
                            </Border.GestureRecognizers>
                            <Path Data="M12 22C13.1 22 14 21.1 14 20H10C10 21.1 10.9 22 12 22ZM18 16V11C18 7.93 16.36 5.36 13.5 4.68V4C13.5 3.17 12.83 2.5 12 2.5C11.17 2.5 10.5 3.17 10.5 4V4.68C7.63 5.36 6 7.92 6 11V16L4 18V19H20V18L18 16ZM16 17H8V11C8 8.52 9.51 6.5 12 6.5C14.49 6.5 16 8.52 16 11V17Z" Fill="#4024A2" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Border x:Name="BadgeNotificaciones" Stroke="White" StrokeThickness="2" StrokeShape="RoundRectangle 8" BackgroundColor="#EF4444" WidthRequest="16" HeightRequest="16" HorizontalOptions="End" VerticalOptions="Start" IsVisible="False" InputTransparent="True">
                            <Label x:Name="LblBadgeNotificaciones" Text="0" FontSize="9" FontFamily="OpenSansSemibold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>

                    <!-- Cerrar sesión -->
                    <Border Grid.Column="3" Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40" BackgroundColor="White" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCerrarSesionTapped" />
                        </Border.GestureRecognizers>
                        <Path Data="M17 7L15.59 8.41L18.17 11H8V13H18.17L15.59 15.59L17 17L22 12L17 7ZM4 5H12V3H4C2.9 3 2 3.9 2 5V19C2 20.1 2.9 21 4 21H12V19H4V5Z" Fill="#EF4444" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- MAIN CARD (Ganado hoy) -->
                <Border Grid.Row="1" Stroke="Transparent" BackgroundColor="#5A31F4" StrokeShape="RoundRectangle 16" Padding="25">
                    <Border.Shadow>
                        <Shadow Brush="#5A31F4" Offset="0,10" Opacity="0.3" Radius="15"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDineroTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Ganado hoy" FontSize="14" FontFamily="OpenSansRegular" TextColor="#E0E7FF"/>
                        <Label x:Name="LblGanadoHoy" Text="RD$0" FontSize="36" FontFamily="OpenSansSemibold" TextColor="White"/>
                        <Label Text="Ver detalle >" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#E0E7FF" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <!-- PROXIMO TRABAJO -->
                <VerticalStackLayout Grid.Row="2" Spacing="15">
                    <Label Text="Próximo trabajo" FontSize="16" FontFamily="OpenSansSemibold" TextColor="#374151"/>

                    <Border x:Name="CardProximoTrabajo" Stroke="#F3F4F6" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="15" IsVisible="False">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,4" Opacity="0.05" Radius="10"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProximoTrabajoTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <!-- Icono Izquierda -->
                            <Border Grid.Column="0" Stroke="Transparent" BackgroundColor="#F3E8FF" StrokeShape="RoundRectangle 12" WidthRequest="50" HeightRequest="50" VerticalOptions="Center" Margin="0,0,15,0">
                                <Path Data="M19.36 2.72L20.78 4.14L15.06 9.85C16.13 11.39 16.28 13.24 15.38 14.44L9.06 8.12C10.26 7.22 12.11 7.37 13.65 8.44L19.36 2.72ZM5.93 17.57C3.92 15.56 2.69 13.16 2.35 10.92L7.23 8.34L15.16 16.27L12.58 21.15C10.34 20.81 7.94 19.58 5.93 17.57ZM3.17 18.5C4.7 20.03 6.7 21.05 8.65 21.43L2 22L2.57 15.35C2.95 17.3 3.97 19.3 5.5 20.83L3.17 18.5Z" Fill="#5A31F4" Aspect="Uniform" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>

                            <!-- Info central -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label x:Name="LblProximoHorario" Text="" FontSize="12" FontFamily="OpenSansSemibold" TextColor="#5A31F4"/>
                                <Label x:Name="LblProximoServicio" Text="" FontSize="16" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                                <HorizontalStackLayout Spacing="5" Margin="0,2,0,0">
                                    <Path Data="M12 2C8.13 2 5 5.13 5 9C5 14.25 12 22 12 22C12 22 19 14.25 19 9C19 5.13 15.87 2 12 2ZM12 11.5C10.62 11.5 9.5 10.38 9.5 9C9.5 7.62 10.62 6.5 12 6.5C13.38 6.5 14.5 7.62 14.5 9C14.5 10.38 13.38 11.5 12 11.5Z" Fill="#9CA3AF" Aspect="Uniform" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                                    <Label x:Name="LblProximoDireccion" Text="" FontSize="13" FontFamily="OpenSansRegular" TextColor="#6B7280" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- Icono Calendario Derecha -->
                            <Border Grid.Column="2" Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Path Data="M19 4H18V2H16V4H8V2H6V4H5C3.89 4 3.01 4.9 3.01 6L3 20C3 21.1 3.89 22 5 22H19C20.1 22 21 21.1 21 20V6C21 4.9 20.1 4 19 4ZM19 20H5V10H19V20ZM19 8H5V6H19V8ZM9 14H7V12H9V14ZM13 14H11V12H13V14ZM17 14H15V12H17V14ZM9 18H7V16H9V18ZM13 18H11V16H13V18ZM17 18H15V16H17V18Z" Fill="#6B7280" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Label x:Name="LblSinTrabajos" Text="No tienes trabajos próximos por ahora." FontSize="13" FontFamily="OpenSansRegular" TextColor="#9CA3AF" HorizontalOptions="Center" IsVisible="False" Margin="0,10,0,0"/>
                </VerticalStackLayout>

                <!-- CUADRICULA DE ACCIONES 2x2 -->
                <Grid Grid.Row="3" ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="15" RowSpacing="15">
                    
                    <!-- 1. Trabajos -->
                    <Border Grid.Row="0" Grid.Column="0" Stroke="#F3F4F6" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="15">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,4" Opacity="0.03" Radius="8"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTrabajosTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Border Stroke="Transparent" BackgroundColor="#DBEAFE" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40" HorizontalOptions="Start">
                                <Path Data="M20 6H16V4C16 2.9 15.1 2 14 2H10C8.9 2 8 2.9 8 4V6H4C2.9 6 2.01 6.9 2.01 8L2 19C2 20.1 2.9 21 4 21H20C21.1 21 22 20.1 22 19V8C22 6.9 21.1 6 20 6ZM10 4H14V6H10V4ZM20 19H4V8H20V19Z" Fill="#3B82F6" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Ver trabajos" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                                <Label Text="Nuevas solicitudes" FontSize="11" FontFamily="OpenSansRegular" TextColor="#6B7280"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 2. Dinero -->
                    <Border Grid.Row="0" Grid.Column="1" Stroke="#F3F4F6" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="15">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,4" Opacity="0.03" Radius="8"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDineroTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Border Stroke="Transparent" BackgroundColor="#D1FAE5" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40" HorizontalOptions="Start">
                                <Path Data="M21 7.28V5C21 3.9 20.1 3 19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V16.72C21.59 16.37 22 15.74 22 15V9C22 8.26 21.59 7.63 21 7.28ZM20 15H13V9H20V15ZM5 19V5H19V7H13C11.9 7 11 7.9 11 9V15C11 16.1 11.9 17 13 17H19V19H5ZM16 13.5C15.17 13.5 14.5 12.83 14.5 12C14.5 11.17 15.17 10.5 16 10.5C16.83 10.5 17.5 11.17 17.5 12C17.5 12.83 16.83 13.5 16 13.5Z" Fill="#10B981" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Mi dinero" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                                <Label Text="Balance y pagos" FontSize="11" FontFamily="OpenSansRegular" TextColor="#6B7280"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 3. Horario -->
                    <Border Grid.Row="1" Grid.Column="0" Stroke="#F3F4F6" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="15">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,4" Opacity="0.03" Radius="8"/>
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="10">
                            <Border Stroke="Transparent" BackgroundColor="#FFEDD5" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40" HorizontalOptions="Start">
                                <Path Data="M19 3H18V1H16V3H8V1H6V3H5C3.89 3 3.01 3.9 3.01 5L3 19C3 20.1 3.89 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3ZM19 19H5V9H19V19ZM19 7H5V5H19V7ZM7 11H12V16H7V11Z" Fill="#F97316" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Mi horario" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                                <Label Text="Disponibilidad" FontSize="11" FontFamily="OpenSansRegular" TextColor="#6B7280"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 4. Ayuda -->
                    <Border Grid.Row="1" Grid.Column="1" Stroke="#F3F4F6" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="15">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,4" Opacity="0.03" Radius="8"/>
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="10">
                            <Border Stroke="Transparent" BackgroundColor="#F3E8FF" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40" HorizontalOptions="Start">
                                <Path Data="M11 18H13V16H11V18ZM12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20ZM12 6C9.79 6 8 7.79 8 10H10C10 8.9 10.9 8 12 8C13.1 8 14 8.9 14 10C14 12 11 11.75 11 15H13C13 12.75 16 12.5 16 10C16 7.79 14.21 6 12 6Z" Fill="#A855F7" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Ayuda" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                                <Label Text="Soporte y dudas" FontSize="11" FontFamily="OpenSansRegular" TextColor="#6B7280"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

            </Grid>
        </ScrollView>

        <!-- BOTTOM TAB BAR (Hardcoded) -->
        <Border Grid.Row="1" Stroke="#F3F4F6" StrokeThickness="1" BackgroundColor="White" Padding="15,10" StrokeShape="RoundRectangle 0">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-4" Opacity="0.05" Radius="10"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*,*,*,*">
                <!-- Inicio (Activo) -->
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <Path Data="M10 20V14H14V20H19V12H22L12 3L2 12H5V20H10Z" Fill="#5A31F4" Aspect="Uniform" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"/>
                    <Label Text="Inicio" FontSize="10" FontFamily="OpenSansSemibold" TextColor="#5A31F4" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Trabajos -->
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTrabajosTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Path Data="M20 6H16V4C16 2.9 15.1 2 14 2H10C8.9 2 8 2.9 8 4V6H4C2.9 6 2.01 6.9 2.01 8L2 19C2 20.1 2.9 21 4 21H20C21.1 21 22 20.1 22 19V8C22 6.9 21.1 6 20 6ZM10 4H14V6H10V4ZM20 19H4V8H20V19Z" Fill="#9CA3AF" Aspect="Uniform" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"/>
                    <Label Text="Trabajos" FontSize="10" FontFamily="OpenSansRegular" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Dinero -->
                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDineroTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Path Data="M21 7.28V5C21 3.9 20.1 3 19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V16.72C21.59 16.37 22 15.74 22 15V9C22 8.26 21.59 7.63 21 7.28ZM20 15H13V9H20V15ZM5 19V5H19V7H13C11.9 7 11 7.9 11 9V15C11 16.1 11.9 17 13 17H19V19H5ZM16 13.5C15.17 13.5 14.5 12.83 14.5 12C14.5 11.17 15.17 10.5 16 10.5C16.83 10.5 17.5 11.17 17.5 12C17.5 12.83 16.83 13.5 16 13.5Z" Fill="#9CA3AF" Aspect="Uniform" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"/>
                    <Label Text="Dinero" FontSize="10" FontFamily="OpenSansRegular" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Perfil -->
                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPerfilTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Path Data="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12ZM12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z" Fill="#9CA3AF" Aspect="Uniform" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center"/>
                    <Label Text="Perfil" FontSize="10" FontFamily="OpenSansRegular" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Border>
        
    </Grid>

</ContentPage>
