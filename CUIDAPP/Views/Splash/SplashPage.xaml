<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:CUIDAPP.Localization"
             x:Class="CUIDAPP.Views.Splash.SplashPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ColorPrimary}"
             SafeAreaEdges="None">

    <Grid SafeAreaEdges="None">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#2A63B8" Offset="0.0" />
                <GradientStop Color="{StaticResource ColorPrimary}" Offset="0.55" />
                <GradientStop Color="{StaticResource ColorPrimaryDark}" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Círculos decorativos suaves -->
        <Ellipse Fill="#14FFFFFF" WidthRequest="340" HeightRequest="340"
                 HorizontalOptions="End" VerticalOptions="Start" Margin="0,-120,-140,0" />
        <Ellipse Fill="#0FFFFFFF" WidthRequest="260" HeightRequest="260"
                 HorizontalOptions="Start" VerticalOptions="End" Margin="-110,0,0,-80" />

        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="28">

            <!-- Logo sobre insignia blanca -->
            <Grid x:Name="LogoCircle" WidthRequest="132" HeightRequest="132" HorizontalOptions="Center" Opacity="0" Scale="0.92">
                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 36">
                    <Border.Shadow>
                        <Shadow Brush="#051A2A" Offset="0,14" Radius="30" Opacity="0.35" />
                    </Border.Shadow>
                    <Image Source="logo_cuidapp.png" Aspect="AspectFit" Margin="18" />
                </Border>
            </Grid>

            <Label x:Name="LblTagline"
                   Text="{loc:T cuidado_en_quien_puedes_confiar}"
                   FontFamily="OpenSansSemibold" FontSize="15"
                   TextColor="#E6EEF8"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"
                   MaximumWidthRequest="260"
                   Opacity="0"/>

            <HorizontalStackLayout x:Name="DotsPanel" Spacing="8" HorizontalOptions="Center" Margin="0,8,0,0" Opacity="0">
                <Ellipse x:Name="Dot1" Fill="White" Opacity="0.9" WidthRequest="8" HeightRequest="8"/>
                <Ellipse x:Name="Dot2" Fill="White" Opacity="0.9" WidthRequest="8" HeightRequest="8"/>
                <Ellipse x:Name="Dot3" Fill="White" Opacity="0.9" WidthRequest="8" HeightRequest="8"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>

        <Label x:Name="LblVersion"
               Text=""
               FontFamily="OpenSansRegular" FontSize="12"
               TextColor="#99FFFFFF"
               HorizontalOptions="Center" VerticalOptions="End"
               Margin="0,0,0,32"
               Opacity="0"/>

    </Grid>

</ContentPage>
