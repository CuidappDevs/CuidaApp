<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:CUIDAPP.Localization"
             x:Class="CUIDAPP.Views.Soporte.NuevoReportePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ColorBackground}"
             SafeAreaEdges="None">

    <Grid SafeAreaEdges="None">
        <ScrollView SafeAreaEdges="None">
            <VerticalStackLayout Spacing="0" SafeAreaEdges="None">

                <!-- ENCABEZADO (borde a borde) -->
                <Grid SafeAreaEdges="None" Padding="0,0,0,44">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#2A63B8" Offset="0.0" />
                            <GradientStop Color="{StaticResource ColorPrimary}" Offset="0.6" />
                            <GradientStop Color="{StaticResource ColorPrimaryDark}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Ellipse Fill="#14FFFFFF" WidthRequest="220" HeightRequest="220" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-90,-80,0"/>

                    <VerticalStackLayout x:Name="ContenidoEncabezado" Spacing="14">
                        <Grid ColumnDefinitions="44,*,44" Padding="12,10">
                            <Border x:Name="BtnBack" Stroke="Transparent" BackgroundColor="#26FFFFFF" WidthRequest="44" HeightRequest="44">
                                <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBackTapped" />
                                </Border.GestureRecognizers>
                                <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="White" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="{loc:T nuevo_reporte}" FontSize="17" FontFamily="OpenSansSemibold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="20,0">
                            <Border Stroke="Transparent" BackgroundColor="#26FFFFFF" StrokeShape="RoundRectangle 14" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                                <Path Data="M12 1C7.03 1 3 5.03 3 10V17C3 18.66 4.34 20 6 20H9V12H5V10C5 6.13 8.13 3 12 3C15.87 3 19 6.13 19 10V12H15V20H19V21H12V23H18C19.66 23 21 21.66 21 20V10C21 5.03 16.97 1 12 1Z" Fill="White" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Grid.Column="1" Text="{loc:T soporte_reportar_un_problema}" FontSize="15" FontFamily="OpenSansSemibold" TextColor="White" VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Grid>

                <!-- Hoja -->
                <Border Margin="0,-28,0,0" Stroke="Transparent" BackgroundColor="{StaticResource ColorBackground}" StrokeShape="RoundRectangle 28,28,0,0">
                    <VerticalStackLayout x:Name="Formulario" Padding="20,24,20,0" Spacing="20">

                        <!-- Categoría: tarjetas seleccionables (el Picker queda oculto para el código) -->
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{loc:T categoria}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}"/>
                            <FlexLayout x:Name="ListaCategorias" Wrap="Wrap" JustifyContent="Start"/>
                            <Picker x:Name="PickerCategoria" IsVisible="False"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="{loc:T asunto}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}"/>
                            <Border Stroke="Transparent" StrokeThickness="1.5" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="14,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Path Data="M14 2H6C4.9 2 4 2.9 4 4V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V8L14 2ZM16 18H8V16H16V18ZM16 14H8V12H16V14ZM13 9V3.5L18.5 9H13Z" Fill="{StaticResource ColorTextMuted}" Aspect="Uniform" WidthRequest="17" HeightRequest="17" VerticalOptions="Center"/>
                                    <Entry x:Name="EntryAsunto" Grid.Column="1" Placeholder="{loc:T resume_tu_problema_en_pocas}" FontFamily="OpenSansRegular" FontSize="15" PlaceholderColor="#8A97A6" TextColor="{StaticResource ColorTextStrong}" BackgroundColor="Transparent" HeightRequest="52"
                                           Focused="OnCampoFocused" Unfocused="OnCampoUnfocused"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="{loc:T descripcion}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}"/>
                            <Border Stroke="Transparent" StrokeThickness="1.5" BackgroundColor="White" StrokeShape="RoundRectangle 18" Padding="12,6">
                                <Editor x:Name="EditorDescripcion" Placeholder="{loc:T cuentanos_que_paso_con_el}" FontFamily="OpenSansRegular" FontSize="15" PlaceholderColor="#8A97A6" TextColor="{StaticResource ColorTextStrong}" BackgroundColor="Transparent" HeightRequest="150" AutoSize="Disabled"
                                        Focused="OnCampoFocused" Unfocused="OnCampoUnfocused"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Enviar (dentro del contenido: nada anclado al borde inferior) -->
                        <Grid>
                            <Button x:Name="BtnEnviar" Text="{loc:T enviar_reporte}" Clicked="OnEnviarClicked" BackgroundColor="{StaticResource ColorPrimary}" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="16" HeightRequest="56"/>
                            <ActivityIndicator x:Name="SpinnerEnviar" Color="White" IsRunning="False" IsVisible="False" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True"/>
                        </Grid>

                        <ContentView x:Name="EspacioInferior" HeightRequest="40" InputTransparent="True"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
