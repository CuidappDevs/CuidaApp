<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:CUIDAPP.Localization"
             xmlns:models="clr-namespace:CUIDAPP.Models.Calificacion"
             x:Class="CUIDAPP.Views.Calificacion.MisCalificacionesPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ColorBackground}"
             SafeAreaEdges="None">

    <Grid RowDefinitions="Auto, *" SafeAreaEdges="None">

        <!-- ENCABEZADO (borde a borde) -->
        <Grid Grid.Row="0" SafeAreaEdges="None" Padding="0,0,0,40">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#2A63B8" Offset="0.0" />
                    <GradientStop Color="{StaticResource ColorPrimary}" Offset="0.6" />
                    <GradientStop Color="{StaticResource ColorPrimaryDark}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Ellipse Fill="#14FFFFFF" WidthRequest="220" HeightRequest="220" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-90,-80,0"/>

            <VerticalStackLayout x:Name="ContenidoEncabezado" Spacing="10">
                <Grid ColumnDefinitions="44,*,44" Padding="12,10">
                    <Border x:Name="BtnBack" Stroke="Transparent" BackgroundColor="#26FFFFFF" WidthRequest="44" HeightRequest="44">
                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Border.GestureRecognizers>
                        <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="White" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Grid.Column="1" Text="{loc:T mis_calificaciones}" FontSize="17" FontFamily="OpenSansSemibold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>

                <!-- Resumen: promedio grande -->
                <VerticalStackLayout x:Name="PanelResumen" Spacing="4" HorizontalOptions="Center" IsVisible="False" Margin="0,4,0,0">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label x:Name="LblPromedio" Text="0.0" FontSize="44" FontFamily="OpenSansSemibold" TextColor="White" VerticalOptions="Center"/>
                        <Path Data="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.45 13.97L5.82 21L12 17.27Z" Fill="#FFC94D" Aspect="Uniform" WidthRequest="34" HeightRequest="34" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Label x:Name="LblTotal" Text="" FontSize="13" FontFamily="OpenSansRegular" TextColor="#D9E6F7" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <!-- Hoja -->
        <Border Grid.Row="1" Margin="0,-28,0,0" Stroke="Transparent" BackgroundColor="{StaticResource ColorBackground}" StrokeShape="RoundRectangle 28,28,0,0">
            <Grid>
                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="True" IsVisible="True" Color="{StaticResource ColorPrimary}" VerticalOptions="Center" HorizontalOptions="Center"/>

                <VerticalStackLayout x:Name="PanelVacio" IsVisible="False" VerticalOptions="Center" HorizontalOptions="Center" Spacing="14" Padding="40">
                    <Border Stroke="Transparent" BackgroundColor="#FFF4DC" WidthRequest="88" HeightRequest="88" HorizontalOptions="Center">
                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                        <Path Data="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.45 13.97L5.82 21L12 17.27Z" Fill="#E09A1A" Aspect="Uniform" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="{loc:T todavia_no_tienes_calificaciones}" FontSize="15" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <CollectionView x:Name="ListaCalificaciones" IsVisible="False" Margin="0,24,0,0">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.Footer>
                        <ContentView HeightRequest="32"/>
                    </CollectionView.Footer>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CalificacionRecibida">
                            <Border Stroke="Transparent" BackgroundColor="White" StrokeShape="RoundRectangle 20" Margin="20,0" Padding="16">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <!-- Ícono de cita -->
                                        <Border Stroke="Transparent" BackgroundColor="#EAF1FB" StrokeShape="RoundRectangle 12" WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                                            <Path Data="M6 17H9L11 13V7H5V13H8L6 17ZM14 17H17L19 13V7H13V13H16L14 17Z" Fill="{StaticResource ColorPrimary}" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding CalificadorNombre}" FontSize="15" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" MaxLines="1" LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding TipoServicio}" FontSize="12" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}"/>
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2" Stroke="Transparent" BackgroundColor="#FFF4DC" StrokeShape="RoundRectangle 12" Padding="10,4" VerticalOptions="Start">
                                            <Label Text="{Binding EstrellasTexto}" FontSize="13" TextColor="#E09A1A"/>
                                        </Border>
                                    </Grid>
                                    <!-- Comentario con barra de acento -->
                                    <Grid ColumnDefinitions="3,*" ColumnSpacing="10" IsVisible="{Binding TieneComentario}">
                                        <BoxView Color="{StaticResource ColorPrimaryLight}" CornerRadius="2" Opacity="0.5"/>
                                        <Label Grid.Column="1" Text="{Binding Comentario}" FontSize="14" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextStrong}" LineHeight="1.4"/>
                                    </Grid>
                                    <Label Text="{Binding FechaTexto}" FontSize="11" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

    </Grid>

</ContentPage>
