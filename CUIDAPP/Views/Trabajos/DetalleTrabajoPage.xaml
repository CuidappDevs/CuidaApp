<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CUIDAPP.Views.Trabajos.DetalleTrabajoPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFFFFF">

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- HEADER -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20,15,20,10" BackgroundColor="White">
            <ContentView x:Name="BtnBack" VerticalOptions="Center">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </ContentView.GestureRecognizers>
                <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="#111827" Aspect="Uniform" WidthRequest="22" HeightRequest="22" />
            </ContentView>
            
            <Label Grid.Column="1" Text="Detalle del trabajo" FontSize="18" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <!-- CONTENIDO -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,40" Spacing="25">
                
                <!-- Perfil del Cliente -->
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Border Grid.Column="0" Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 30" BackgroundColor="#F3F4F6" WidthRequest="60" HeightRequest="60" VerticalOptions="Center" Margin="0,0,15,0">
                        <Image Source="https://i.pravatar.cc/150?u=familia" Aspect="AspectFill" />
                    </Border>
                    
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="Familia Rodriguez" FontSize="16" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                        <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                            <!-- Estrellitas -->
                            <Path Data="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" Fill="#FBBF24" Aspect="Uniform" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                            <Path Data="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" Fill="#FBBF24" Aspect="Uniform" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                            <Path Data="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" Fill="#FBBF24" Aspect="Uniform" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                            <Path Data="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" Fill="#FBBF24" Aspect="Uniform" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                            <Path Data="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" Fill="#FBBF24" Aspect="Uniform" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="5" Margin="0,2,0,0">
                            <Path Data="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" Fill="#F59E0B" Aspect="Uniform" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                            <Label Text="4.9 (28)" FontSize="12" FontFamily="OpenSansSemibold" TextColor="#6B7280" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    
                    <Border Grid.Column="2" Stroke="Transparent" BackgroundColor="#F3E8FF" StrokeShape="RoundRectangle 16" Padding="15,6" VerticalOptions="Center">
                        <Label Text="Ver perfil" FontSize="12" FontFamily="OpenSansSemibold" TextColor="#5A31F4" VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <BoxView HeightRequest="1" Color="#F3F4F6"/>

                <!-- Resumen de Trabajo -->
                <VerticalStackLayout Spacing="20">
                    
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Trabajo" FontSize="13" FontFamily="OpenSansRegular" TextColor="#6B7280"/>
                            <Label Text="Limpieza del hogar" FontSize="16" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Stroke="Transparent" BackgroundColor="#FCE7F3" StrokeShape="RoundRectangle 20" Padding="12,4" VerticalOptions="Center">
                            <Label Text="Por horas" FontSize="12" FontFamily="OpenSansSemibold" TextColor="#9D174D"/>
                        </Border>
                    </Grid>

                    <VerticalStackLayout>
                        <Label Text="Fecha" FontSize="13" FontFamily="OpenSansRegular" TextColor="#6B7280"/>
                        <Label Text="Hoy, 20 de mayo" FontSize="16" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label Text="Hora" FontSize="13" FontFamily="OpenSansRegular" TextColor="#6B7280"/>
                        <Label Text="10:00 AM – 1:00 PM (3 horas)" FontSize="16" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label Text="Dirección" FontSize="13" FontFamily="OpenSansRegular" TextColor="#6B7280"/>
                        <Label Text="Ens. Naco, Santo Domingo" FontSize="16" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label Text="Pago total" FontSize="13" FontFamily="OpenSansRegular" TextColor="#6B7280"/>
                        <Label Text="RD$900.00" FontSize="20" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                    </VerticalStackLayout>

                    <!-- Mensaje de Confianza -->
                    <VerticalStackLayout Margin="0,10,0,0">
                        <Label Text="La familia ya pagó en la app." FontSize="14" FontFamily="OpenSansSemibold" TextColor="#059669"/>
                        <Label Text="Tu pago está 100% asegurado." FontSize="14" FontFamily="OpenSansSemibold" TextColor="#059669"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTONES DE ACCION FIJOS ABAJO -->
        <VerticalStackLayout Grid.Row="2" Padding="20,10,20,30" Spacing="15" BackgroundColor="White">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-4" Opacity="0.05" Radius="10"/>
            </Border.Shadow>
            <Button Text="Aceptar trabajo" BackgroundColor="#5A31F4" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="12" HeightRequest="55"/>
            <Label Text="Rechazar" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#5A31F4" HorizontalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
