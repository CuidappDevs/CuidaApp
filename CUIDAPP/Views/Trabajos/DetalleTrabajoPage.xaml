<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CUIDAPP.Views.Trabajos.DetalleTrabajoPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFFFFF">

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- HEADER -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20,15,20,10" BackgroundColor="White">
            <ContentView x:Name="BtnBack" VerticalOptions="Center">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </ContentView.GestureRecognizers>
                <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="#111827" Aspect="Uniform" WidthRequest="22" HeightRequest="22" />
            </ContentView>
            
            <Label Grid.Column="1" Text="Detalle del trabajo" FontSize="18" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <!-- CONTENIDO -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,10,20,40" Spacing="20">
                
                <!-- Tarjeta del Cliente -->
                <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 20" Padding="15">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,4" Opacity="0.03" Radius="10"/>
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 30" BackgroundColor="#F3F4F6" WidthRequest="55" HeightRequest="55" VerticalOptions="Center" Margin="0,0,15,0">
                            <Image Source="https://i.pravatar.cc/150?u=familia" Aspect="AspectFill" />
                        </Border>
                        
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Familia Rodriguez" FontSize="16" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                            <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                                <!-- Estrellitas -->
                                <Path Data="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" Fill="#FBBF24" Aspect="Uniform" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                                <Path Data="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" Fill="#FBBF24" Aspect="Uniform" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                                <Path Data="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" Fill="#FBBF24" Aspect="Uniform" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                                <Path Data="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" Fill="#FBBF24" Aspect="Uniform" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                                <Path Data="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z" Fill="#FBBF24" Aspect="Uniform" WidthRequest="12" HeightRequest="12" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="5" Margin="0,2,0,0">
                                <Label Text="4.9" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#374151" VerticalOptions="Center"/>
                                <Label Text="(28 reseñas)" FontSize="12" FontFamily="OpenSansRegular" TextColor="#6B7280" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        
                        <Border Grid.Column="2" Stroke="Transparent" BackgroundColor="#F3E8FF" StrokeShape="RoundRectangle 16" Padding="12,6" VerticalOptions="Center">
                            <Label Text="Ver perfil" FontSize="12" FontFamily="OpenSansSemibold" TextColor="#5A31F4" VerticalOptions="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Tarjeta de Detalles del Trabajo -->
                <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 20" Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,4" Opacity="0.03" Radius="10"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="20">
                        
                        <!-- Header del Trabajo -->
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Trabajo" FontSize="12" FontFamily="OpenSansRegular" TextColor="#6B7280"/>
                                <Label Text="Limpieza del hogar" FontSize="18" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="1" Stroke="Transparent" BackgroundColor="#FCE7F3" StrokeShape="RoundRectangle 20" Padding="12,4" VerticalOptions="Start">
                                <Label Text="Por horas" FontSize="12" FontFamily="OpenSansSemibold" TextColor="#9D174D"/>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F3F4F6"/>

                        <!-- Filas de Detalles con Iconos -->
                        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, *" RowSpacing="15" ColumnSpacing="15">
                            
                            <!-- Fecha -->
                            <Border Grid.Row="0" Grid.Column="0" Stroke="Transparent" BackgroundColor="#F3F4F6" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                                <Path Data="M19 4H18V2H16V4H8V2H6V4H5C3.89 4 3 4.9 3 6V20C3 21.1 3.89 22 5 22H19C20.1 22 21 21.1 21 20V6C21 4.9 20.1 4 19 4ZM19 20H5V10H19V20ZM19 8H5V6H19V8Z" Fill="#6B7280" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Fecha" FontSize="12" FontFamily="OpenSansRegular" TextColor="#6B7280"/>
                                <Label Text="Hoy, 20 de mayo" FontSize="15" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                            </VerticalStackLayout>

                            <!-- Hora -->
                            <Border Grid.Row="1" Grid.Column="0" Stroke="Transparent" BackgroundColor="#F3F4F6" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                                <Path Data="M11.99 2C6.47 2 2 6.48 2 12C2 17.52 6.47 22 11.99 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 11.99 2ZM12 20C7.58 20 4 16.42 4 12C4 7.58 7.58 4 12 4C16.42 4 20 7.58 20 12C20 16.42 16.42 20 12 20ZM12.5 7H11V13L16.25 16.15L17 14.92L12.5 12.25V7Z" Fill="#6B7280" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Hora" FontSize="12" FontFamily="OpenSansRegular" TextColor="#6B7280"/>
                                <Label Text="10:00 AM – 1:00 PM (3 horas)" FontSize="15" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                            </VerticalStackLayout>

                            <!-- Dirección -->
                            <Border Grid.Row="2" Grid.Column="0" Stroke="Transparent" BackgroundColor="#F3F4F6" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                                <Path Data="M12 2C8.13 2 5 5.13 5 9C5 14.25 12 22 12 22C12 22 19 14.25 19 9C19 5.13 15.87 2 12 2ZM12 11.5C10.62 11.5 9.5 10.38 9.5 9C9.5 7.62 10.62 6.5 12 6.5C13.38 6.5 14.5 7.62 14.5 9C14.5 10.38 13.38 11.5 12 11.5Z" Fill="#6B7280" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Dirección" FontSize="12" FontFamily="OpenSansRegular" TextColor="#6B7280"/>
                                <Label Text="Ens. Naco, Santo Domingo" FontSize="15" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F3F4F6" Margin="0,5,0,0"/>

                        <!-- Sección de Pago -->
                        <Border Stroke="Transparent" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 12" Padding="15">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="Pago total" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#475569" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="RD$900.00" FontSize="22" FontFamily="OpenSansBold" TextColor="#111827" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- Mensaje de Confianza -->
                <Border Stroke="#D1FAE5" StrokeThickness="1" BackgroundColor="#ECFDF5" StrokeShape="RoundRectangle 12" Padding="15">
                    <Grid ColumnDefinitions="Auto, *">
                        <Path Grid.Column="0" Data="M12 1L3 5V11C3 16.55 6.84 21.74 12 23C17.16 21.74 21 16.55 21 11V5L12 1ZM10 17L5 12L6.41 10.59L10 14.17L17.59 6.58L19 8L10 17Z" Fill="#10B981" Aspect="Uniform" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Margin="0,0,12,0"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="La familia ya pagó en la app." FontSize="13" FontFamily="OpenSansSemibold" TextColor="#065F46"/>
                            <Label Text="Tu pago está 100% asegurado." FontSize="13" FontFamily="OpenSansRegular" TextColor="#065F46"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTONES DE ACCION FIJOS ABAJO -->
        <VerticalStackLayout Grid.Row="2" Padding="20,10,20,30" Spacing="15" BackgroundColor="White">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-4" Opacity="0.05" Radius="10"/>
            </Border.Shadow>
            <Button Text="Aceptar trabajo" BackgroundColor="#5A31F4" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="12" HeightRequest="55"/>
            <Label Text="Rechazar" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#5A31F4" HorizontalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
