<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CUIDAPP.Views.Trabajos.CancelarServicioPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFFFFF">

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="20,15,20,10" BackgroundColor="White">
            <ContentView x:Name="BtnBack" VerticalOptions="Center">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </ContentView.GestureRecognizers>
                <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="#111827" Aspect="Uniform" WidthRequest="22" HeightRequest="22" />
            </ContentView>
            <Label Grid.Column="1" Text="Cancelar servicio" FontSize="18" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,15,20,20" Spacing="18">

                <Border Stroke="#FEE2E2" StrokeThickness="1" BackgroundColor="#FEF2F2" StrokeShape="RoundRectangle 12" Padding="15">
                    <Label Text="Cancelar un servicio ya aceptado afecta la confianza del cliente. Selecciona el motivo real para que podamos ayudarte mejor." FontSize="13" FontFamily="OpenSansRegular" TextColor="#991B1B" HorizontalTextAlignment="Center"/>
                </Border>

                <Label Text="¿Por qué necesitas cancelar?" FontSize="15" FontFamily="OpenSansSemibold" TextColor="#111827"/>

                <VerticalStackLayout x:Name="ListaMotivos" Spacing="10" />

                <VerticalStackLayout x:Name="ContenedorOtro" Spacing="8" IsVisible="False">
                    <Label Text="Cuéntanos brevemente" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#374151"/>
                    <Border Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,0">
                        <Entry x:Name="EntryOtroMotivo" Placeholder="Escribe el motivo" FontFamily="OpenSansRegular" FontSize="14" HeightRequest="45" TextChanged="OnOtroMotivoTextChanged"/>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Padding="20,10,20,30" Spacing="10" BackgroundColor="White">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-4" Opacity="0.05" Radius="10"/>
            </Border.Shadow>
            <Button x:Name="BtnConfirmar" Text="Confirmar cancelación" Clicked="OnConfirmarClicked" BackgroundColor="#EF4444" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="12" HeightRequest="55" IsEnabled="False"/>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
