<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:CUIDAPP.Localization"
             x:Class="CUIDAPP.Views.Trabajos.FinalizarTrabajoPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ColorBackground}">

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" ColumnDefinitions="44, *, 44" Padding="12,8,16,8" BackgroundColor="{StaticResource ColorBackground}">
            <Border x:Name="BtnBack" Stroke="Transparent" BackgroundColor="{StaticResource ColorSurface}" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="{StaticResource ColorTextStrong}" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Grid.Column="1" Text="{loc:T finalizar_trabajo}" FontSize="17" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="25,30,25,20" Spacing="25">

                <Border x:Name="Insignia" Stroke="Transparent" BackgroundColor="{StaticResource ColorSuccess}" StrokeShape="RoundRectangle 28" WidthRequest="88" HeightRequest="88" HorizontalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource ColorSuccess}" Offset="0,10" Radius="22" Opacity="0.3" />
                    </Border.Shadow>
                    <Path Data="M9 16.17L4.83 12L3.41 13.41L9 19L21 7L19.59 5.59L9 16.17Z" Fill="White" Aspect="Uniform" WidthRequest="38" HeightRequest="38" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="{loc:T ingresa_el_codigo_de_salida}" FontSize="19" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Center"/>
                    <Label Text="{loc:T pidele_a_tu_cliente_el}" FontSize="13" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="20,0,20,0"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="14">
                    <Label x:Name="LblCliente" Text="" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorSuccess}" HorizontalOptions="Center"/>

                    <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Border Stroke="Transparent" StrokeThickness="2" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource ColorSurface}" WidthRequest="62" HeightRequest="74">
                            <Entry x:Name="EntryPin1" MaxLength="1" Keyboard="Numeric" FontSize="28" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Fill" HorizontalTextAlignment="Center" VerticalOptions="Fill" BackgroundColor="Transparent" Focused="OnPinFocused" Unfocused="OnPinUnfocused" TextChanged="OnPin1Changed"/>
                        </Border>
                        <Border Stroke="Transparent" StrokeThickness="2" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource ColorSurface}" WidthRequest="62" HeightRequest="74">
                            <Entry x:Name="EntryPin2" MaxLength="1" Keyboard="Numeric" FontSize="28" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Fill" HorizontalTextAlignment="Center" VerticalOptions="Fill" BackgroundColor="Transparent" Focused="OnPinFocused" Unfocused="OnPinUnfocused" TextChanged="OnPin2Changed"/>
                        </Border>
                        <Border Stroke="Transparent" StrokeThickness="2" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource ColorSurface}" WidthRequest="62" HeightRequest="74">
                            <Entry x:Name="EntryPin3" MaxLength="1" Keyboard="Numeric" FontSize="28" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Fill" HorizontalTextAlignment="Center" VerticalOptions="Fill" BackgroundColor="Transparent" Focused="OnPinFocused" Unfocused="OnPinUnfocused" TextChanged="OnPin3Changed"/>
                        </Border>
                        <Border Stroke="Transparent" StrokeThickness="2" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource ColorSurface}" WidthRequest="62" HeightRequest="74">
                            <Entry x:Name="EntryPin4" MaxLength="1" Keyboard="Numeric" FontSize="28" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Fill" HorizontalTextAlignment="Center" VerticalOptions="Fill" BackgroundColor="Transparent" Focused="OnPinFocused" Unfocused="OnPinUnfocused" TextChanged="OnPin4Changed"/>
                        </Border>
                    </HorizontalStackLayout>

                    <Label x:Name="LblError" Text="" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorDanger}" HorizontalOptions="Center" IsVisible="False"/>
                </VerticalStackLayout>

                <!-- Solo visible si se está terminando antes de la hora acordada -->
                <VerticalStackLayout x:Name="CardJustificacion" Spacing="8" IsVisible="False">
                    <Label Text="{loc:T estas_terminando_antes_de_lo}" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorWarning}"/>
                    <Border Stroke="Transparent" BackgroundColor="{StaticResource ColorWarningSoft}" StrokeShape="RoundRectangle 16" Padding="12,8">
                        <Editor x:Name="EditorJustificacion" Placeholder="{loc:T ej_el_cliente_me_pidio}" FontFamily="OpenSansRegular" FontSize="14" HeightRequest="80" AutoSize="TextChanges"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Solo en servicios en efectivo: ¿cobró completo? Si no, la diferencia queda como deuda del cliente -->
                <Border x:Name="CardEfectivo" IsVisible="False" Stroke="{StaticResource ColorBorder}" StrokeThickness="1" BackgroundColor="{StaticResource ColorSurface}" StrokeShape="RoundRectangle 20" Padding="18">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Stroke="Transparent" BackgroundColor="{StaticResource ColorSuccessSoft}" StrokeShape="RoundRectangle 12" WidthRequest="40" HeightRequest="40" VerticalOptions="Start">
                                <Path Data="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"
                                      Fill="{StaticResource ColorSuccess}" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{loc:T efectivo_cobro_titulo}" FontSize="15" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}"/>
                                <Label x:Name="LblEfectivoTotal" FontSize="13" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Dos opciones tipo segmento -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border x:Name="OpcionCompleto" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" HeightRequest="48">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCobroCompleto"/></Border.GestureRecognizers>
                                <Label x:Name="LblOpcionCompleto" Text="{loc:T efectivo_cobro_completo}" FontSize="14" FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Border x:Name="OpcionParcial" Grid.Column="1" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" HeightRequest="48">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCobroParcial"/></Border.GestureRecognizers>
                                <Label x:Name="LblOpcionParcial" Text="{loc:T efectivo_cobro_parcial}" FontSize="14" FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>

                        <VerticalStackLayout x:Name="BloqueMontoRecibido" Spacing="8" IsVisible="False">
                            <Label Text="{loc:T efectivo_cobro_monto}" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}"/>
                            <Border Stroke="{StaticResource ColorBorder}" StrokeThickness="1.2" BackgroundColor="{StaticResource ColorBackground}" StrokeShape="RoundRectangle 14" Padding="12,2" HeightRequest="50">
                                <Entry x:Name="EntryMontoRecibido" Keyboard="Numeric" FontSize="16" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" PlaceholderColor="{StaticResource ColorPlaceholder}" Placeholder="0" BackgroundColor="Transparent" TextChanged="OnMontoRecibidoChanged"/>
                            </Border>
                            <Border x:Name="AvisoDiferencia" IsVisible="False" Stroke="Transparent" BackgroundColor="{StaticResource ColorWarningSoft}" StrokeShape="RoundRectangle 12" Padding="12,10">
                                <Label x:Name="LblDiferencia" FontSize="13" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextStrong}"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Acción: fila propia de la cuadrícula (zona segura por defecto, sobre la barra de gestos) -->
        <VerticalStackLayout Grid.Row="2" Padding="20,12,20,14" Spacing="10" BackgroundColor="{StaticResource ColorBackground}">
            <Button x:Name="BtnConfirmar" Text="{loc:T confirmar_finalizacion}" Clicked="OnConfirmarClicked" BackgroundColor="{StaticResource ColorSuccess}" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="16" HeightRequest="56" IsEnabled="False"/>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
