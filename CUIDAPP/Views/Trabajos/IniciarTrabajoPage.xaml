<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CUIDAPP.Views.Trabajos.IniciarTrabajoPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFFFFF">

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="20,15,20,10" BackgroundColor="White">
            <ContentView x:Name="BtnBack" VerticalOptions="Center">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </ContentView.GestureRecognizers>
                <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="#111827" Aspect="Uniform" WidthRequest="22" HeightRequest="22" />
            </ContentView>
            <Label Grid.Column="1" Text="Iniciar trabajo" FontSize="18" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="25,30,25,20" Spacing="25">

                <Border Stroke="Transparent" BackgroundColor="#F3E8FF" StrokeShape="RoundRectangle 40" WidthRequest="80" HeightRequest="80" HorizontalOptions="Center">
                    <Path Data="M12 1C8.68 1 6 3.68 6 7V10H5C3.9 10 3 10.9 3 12V20C3 21.1 3.9 22 5 22H19C20.1 22 21 21.1 21 20V12C21 10.9 20.1 10 19 10H18V7C18 3.68 15.32 1 12 1ZM12 3C14.21 3 16 4.79 16 7V10H8V7C8 4.79 9.79 3 12 3ZM12 13C13.1 13 14 13.9 14 15C14 15.74 13.6 16.38 13 16.72V18C13 18.55 12.55 19 12 19C11.45 19 11 18.55 11 18V16.72C10.4 16.38 10 15.74 10 15C10 13.9 10.9 13 12 13Z" Fill="#7C3AED" Aspect="Uniform" WidthRequest="34" HeightRequest="34" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="Ingresa el código del cliente" FontSize="19" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Center"/>
                    <Label Text="Pídele a tu cliente el código de 4 dígitos para confirmar que iniciarás el servicio." FontSize="13" FontFamily="OpenSansRegular" TextColor="#6B7280" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="20,0,20,0"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="14">
                    <Label x:Name="LblCliente" Text="" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#5A31F4" HorizontalOptions="Center"/>

                    <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Border Stroke="#E5E7EB" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" BackgroundColor="#F9FAFB" WidthRequest="60" HeightRequest="70">
                            <Entry x:Name="EntryPin1" MaxLength="1" Keyboard="Numeric" FontSize="28" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Fill" HorizontalTextAlignment="Center" VerticalOptions="Fill" BackgroundColor="Transparent" TextChanged="OnPin1Changed"/>
                        </Border>
                        <Border Stroke="#E5E7EB" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" BackgroundColor="#F9FAFB" WidthRequest="60" HeightRequest="70">
                            <Entry x:Name="EntryPin2" MaxLength="1" Keyboard="Numeric" FontSize="28" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Fill" HorizontalTextAlignment="Center" VerticalOptions="Fill" BackgroundColor="Transparent" TextChanged="OnPin2Changed"/>
                        </Border>
                        <Border Stroke="#E5E7EB" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" BackgroundColor="#F9FAFB" WidthRequest="60" HeightRequest="70">
                            <Entry x:Name="EntryPin3" MaxLength="1" Keyboard="Numeric" FontSize="28" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Fill" HorizontalTextAlignment="Center" VerticalOptions="Fill" BackgroundColor="Transparent" TextChanged="OnPin3Changed"/>
                        </Border>
                        <Border Stroke="#E5E7EB" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" BackgroundColor="#F9FAFB" WidthRequest="60" HeightRequest="70">
                            <Entry x:Name="EntryPin4" MaxLength="1" Keyboard="Numeric" FontSize="28" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Fill" HorizontalTextAlignment="Center" VerticalOptions="Fill" BackgroundColor="Transparent" TextChanged="OnPin4Changed"/>
                        </Border>
                    </HorizontalStackLayout>

                    <Label x:Name="LblError" Text="" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#EF4444" HorizontalOptions="Center" IsVisible="False"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Padding="20,10,20,30" Spacing="10" BackgroundColor="White">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-4" Opacity="0.05" Radius="10"/>
            </Border.Shadow>
            <Button x:Name="BtnConfirmar" Text="Confirmar inicio" Clicked="OnConfirmarClicked" BackgroundColor="#5A31F4" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="12" HeightRequest="55" IsEnabled="False"/>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
