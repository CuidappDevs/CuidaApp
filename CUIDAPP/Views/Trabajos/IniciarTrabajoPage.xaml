<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:CUIDAPP.Localization"
             x:Class="CUIDAPP.Views.Trabajos.IniciarTrabajoPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ColorBackground}">

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" ColumnDefinitions="44, *, 44" Padding="12,8,16,8" BackgroundColor="{StaticResource ColorBackground}">
            <Border x:Name="BtnBack" Stroke="Transparent" BackgroundColor="White" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="{StaticResource ColorTextStrong}" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Grid.Column="1" Text="{loc:T iniciar_trabajo}" FontSize="17" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="25,30,25,20" Spacing="25">

                <Border x:Name="Insignia" Stroke="Transparent" BackgroundColor="{StaticResource ColorPrimary}" StrokeShape="RoundRectangle 28" WidthRequest="88" HeightRequest="88" HorizontalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource ColorPrimary}" Offset="0,10" Radius="22" Opacity="0.3" />
                    </Border.Shadow>
                    <Path Data="M12 1C8.68 1 6 3.68 6 7V10H5C3.9 10 3 10.9 3 12V20C3 21.1 3.9 22 5 22H19C20.1 22 21 21.1 21 20V12C21 10.9 20.1 10 19 10H18V7C18 3.68 15.32 1 12 1ZM12 3C14.21 3 16 4.79 16 7V10H8V7C8 4.79 9.79 3 12 3ZM12 13C13.1 13 14 13.9 14 15C14 15.74 13.6 16.38 13 16.72V18C13 18.55 12.55 19 12 19C11.45 19 11 18.55 11 18V16.72C10.4 16.38 10 15.74 10 15C10 13.9 10.9 13 12 13Z" Fill="White" Aspect="Uniform" WidthRequest="38" HeightRequest="38" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="{loc:T ingresa_el_codigo_del_cliente}" FontSize="19" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Center"/>
                    <Label Text="{loc:T pidele_a_tu_cliente_el_2}" FontSize="13" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="20,0,20,0"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="14">
                    <Label x:Name="LblCliente" Text="" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorPrimary}" HorizontalOptions="Center"/>

                    <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Border Stroke="Transparent" StrokeThickness="2" StrokeShape="RoundRectangle 18" BackgroundColor="White" WidthRequest="62" HeightRequest="74">
                            <Entry x:Name="EntryPin1" MaxLength="1" Keyboard="Numeric" FontSize="28" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Fill" HorizontalTextAlignment="Center" VerticalOptions="Fill" BackgroundColor="Transparent" Focused="OnPinFocused" Unfocused="OnPinUnfocused" TextChanged="OnPin1Changed"/>
                        </Border>
                        <Border Stroke="Transparent" StrokeThickness="2" StrokeShape="RoundRectangle 18" BackgroundColor="White" WidthRequest="62" HeightRequest="74">
                            <Entry x:Name="EntryPin2" MaxLength="1" Keyboard="Numeric" FontSize="28" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Fill" HorizontalTextAlignment="Center" VerticalOptions="Fill" BackgroundColor="Transparent" Focused="OnPinFocused" Unfocused="OnPinUnfocused" TextChanged="OnPin2Changed"/>
                        </Border>
                        <Border Stroke="Transparent" StrokeThickness="2" StrokeShape="RoundRectangle 18" BackgroundColor="White" WidthRequest="62" HeightRequest="74">
                            <Entry x:Name="EntryPin3" MaxLength="1" Keyboard="Numeric" FontSize="28" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Fill" HorizontalTextAlignment="Center" VerticalOptions="Fill" BackgroundColor="Transparent" Focused="OnPinFocused" Unfocused="OnPinUnfocused" TextChanged="OnPin3Changed"/>
                        </Border>
                        <Border Stroke="Transparent" StrokeThickness="2" StrokeShape="RoundRectangle 18" BackgroundColor="White" WidthRequest="62" HeightRequest="74">
                            <Entry x:Name="EntryPin4" MaxLength="1" Keyboard="Numeric" FontSize="28" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Fill" HorizontalTextAlignment="Center" VerticalOptions="Fill" BackgroundColor="Transparent" Focused="OnPinFocused" Unfocused="OnPinUnfocused" TextChanged="OnPin4Changed"/>
                        </Border>
                    </HorizontalStackLayout>

                    <Label x:Name="LblError" Text="" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorDanger}" HorizontalOptions="Center" IsVisible="False"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Acción: fila propia de la cuadrícula (zona segura por defecto, sobre la barra de gestos) -->
        <VerticalStackLayout Grid.Row="2" Padding="20,12,20,14" Spacing="10" BackgroundColor="{StaticResource ColorBackground}">
            <Button x:Name="BtnConfirmar" Text="{loc:T confirmar_inicio}" Clicked="OnConfirmarClicked" BackgroundColor="{StaticResource ColorPrimary}" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="16" HeightRequest="56" IsEnabled="False"/>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
