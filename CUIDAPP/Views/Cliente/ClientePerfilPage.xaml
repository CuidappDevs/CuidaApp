<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CUIDAPP.Views.Cliente.ClientePerfilPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F9FAFB">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- PORTADA -->
            <Grid>
                <Border Stroke="Transparent" BackgroundColor="#5A31F4" HeightRequest="140" VerticalOptions="Start" StrokeShape="Rectangle">
                    <ContentView HorizontalOptions="Start" VerticalOptions="Start" Margin="20,20,0,0">
                        <ContentView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </ContentView.GestureRecognizers>
                        <Border Stroke="Transparent" BackgroundColor="#40000000" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40">
                            <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="White" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </ContentView>
                </Border>

                <Border Stroke="White" StrokeThickness="4" StrokeShape="RoundRectangle 55" BackgroundColor="#E5E7EB" WidthRequest="110" HeightRequest="110" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,90,0,0">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,4" Opacity="0.1" Radius="10"/>
                    </Border.Shadow>
                    <Image x:Name="ImgFoto" Aspect="AspectFill" />
                </Border>
            </Grid>

            <VerticalStackLayout Padding="20,60,20,30" Spacing="20">

                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label x:Name="LblNombre" Text="" FontSize="22" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Center"/>
                    <Label x:Name="LblEmail" Text="" FontSize="13" FontFamily="OpenSansRegular" TextColor="#6B7280" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="20">
                    <VerticalStackLayout Spacing="18">

                        <Grid ColumnDefinitions="Auto, *">
                            <Border Grid.Column="0" Stroke="Transparent" BackgroundColor="#F3F4F6" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                                <Path Data="M12 2C8.13 2 5 5.13 5 9C5 14.25 12 22 12 22C12 22 19 14.25 19 9C19 5.13 15.87 2 12 2ZM12 11.5C10.62 11.5 9.5 10.38 9.5 9C9.5 7.62 10.62 6.5 12 6.5C13.38 6.5 14.5 7.62 14.5 9C14.5 10.38 13.38 11.5 12 11.5Z" Fill="#5A31F4" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="15,0,0,0">
                                <Label Text="Dirección principal" FontSize="12" FontFamily="OpenSansRegular" TextColor="#6B7280"/>
                                <Label x:Name="LblDireccion" Text="" FontSize="15" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F3F4F6"/>

                        <Grid ColumnDefinitions="Auto, *">
                            <Border Grid.Column="0" Stroke="Transparent" BackgroundColor="#F3F4F6" StrokeShape="RoundRectangle 10" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                                <Path Data="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 4C13.66 4 15 5.34 15 7C15 8.66 13.66 10 12 10C10.34 10 9 8.66 9 7C9 5.34 10.34 4 12 4ZM16 18H8V16C8 13.34 13.33 12 16 12C16 12 16 12.01 16 12.01V18Z" Fill="#5A31F4" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="15,0,0,0">
                                <Label Text="Contacto de emergencia" FontSize="12" FontFamily="OpenSansRegular" TextColor="#6B7280"/>
                                <Label x:Name="LblContacto" Text="" FontSize="15" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <Button Text="Cerrar sesión" Clicked="OnCerrarSesionTapped" BackgroundColor="#FEE2E2" TextColor="#DC2626" FontFamily="OpenSansSemibold" FontSize="15" CornerRadius="12" HeightRequest="50"/>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
