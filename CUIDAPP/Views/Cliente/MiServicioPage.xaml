<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CUIDAPP.Views.Cliente.MiServicioPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F9FAFB">

    <Grid RowDefinitions="Auto, *">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20,15,20,10" BackgroundColor="White">
            <ContentView x:Name="BtnBack" VerticalOptions="Center">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </ContentView.GestureRecognizers>
                <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="#111827" Aspect="Uniform" WidthRequest="22" HeightRequest="22" />
            </ContentView>
            <Label Grid.Column="1" Text="Mi servicio" FontSize="18" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Center" VerticalOptions="Center"/>
            <Label Grid.Column="2" Text="" WidthRequest="22"/>
        </Grid>

        <ActivityIndicator x:Name="LoadingIndicator" Grid.Row="1" IsRunning="False" Color="#5A31F4" VerticalOptions="Center"/>

        <ScrollView x:Name="ContenedorInfo" Grid.Row="1" IsVisible="False">
            <VerticalStackLayout Padding="20,15,20,30" Spacing="18">

                <!-- Badge de estado grande -->
                <Border x:Name="BadgeEstado" Stroke="Transparent" StrokeShape="RoundRectangle 14" Padding="15" HorizontalOptions="Fill">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border x:Name="DotEstado" Stroke="Transparent" StrokeShape="RoundRectangle 5" WidthRequest="10" HeightRequest="10" VerticalOptions="Center"/>
                        <Label x:Name="LblEstado" Text="Pendiente" FontSize="16" FontFamily="OpenSansSemibold"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Cuidador -->
                <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="15">
                    <Grid ColumnDefinitions="Auto, *">
                        <Border Grid.Column="0" Stroke="Transparent" StrokeShape="RoundRectangle 30" BackgroundColor="#E5E7EB" WidthRequest="60" HeightRequest="60" Margin="0,0,15,0">
                            <Image x:Name="ImgCuidador" Aspect="AspectFill" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label x:Name="LblCuidadorNombre" Text="" FontSize="17" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                            <Label x:Name="LblTipoServicio" Text="" FontSize="13" FontFamily="OpenSansRegular" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Detalles -->
                <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="18">
                    <VerticalStackLayout Spacing="15">

                        <Grid ColumnDefinitions="Auto, *">
                            <Path Grid.Column="0" Data="M19 3H18V1H16V3H8V1H6V3H5C3.89 3 3.01 3.9 3.01 5L3 19C3 20.1 3.89 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3ZM19 19H5V9H19V19ZM19 7H5V5H19V7Z" Fill="#5A31F4" Aspect="Uniform" WidthRequest="18" HeightRequest="18" VerticalOptions="Start" Margin="0,2,12,0"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Fecha y horario" FontSize="12" FontFamily="OpenSansRegular" TextColor="#9CA3AF"/>
                                <Label x:Name="LblFechaHora" Text="" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="Auto, *">
                            <Path Grid.Column="0" Data="M12 2C8.13 2 5 5.13 5 9C5 14.25 12 22 12 22C12 22 19 14.25 19 9C19 5.13 15.87 2 12 2ZM12 11.5C10.62 11.5 9.5 10.38 9.5 9C9.5 7.62 10.62 6.5 12 6.5C13.38 6.5 14.5 7.62 14.5 9C14.5 10.38 13.38 11.5 12 11.5Z" Fill="#5A31F4" Aspect="Uniform" WidthRequest="18" HeightRequest="18" VerticalOptions="Start" Margin="0,2,12,0"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Dirección" FontSize="12" FontFamily="OpenSansRegular" TextColor="#9CA3AF"/>
                                <Label x:Name="LblDireccion" Text="" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Código de inicio para el cuidador -->
                <Border x:Name="CardPin" Stroke="#DDD6FE" StrokeThickness="1" BackgroundColor="#F5F3FF" StrokeShape="RoundRectangle 16" Padding="18" IsVisible="False">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="Dale este código a tu cuidador al llegar" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#5B21B6" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        <Label x:Name="LblPin" Text="----" FontSize="32" FontFamily="OpenSansSemibold" TextColor="#4024A2" HorizontalOptions="Center" CharacterSpacing="6"/>
                        <Label Text="Lo necesita para confirmar que inició el trabajo en tu domicilio." FontSize="12" FontFamily="OpenSansRegular" TextColor="#7C3AED" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Pago -->
                <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="20">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Pago total" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#111827" VerticalOptions="Center"/>
                        <Label x:Name="LblPago" Grid.Column="1" Text="" FontSize="22" FontFamily="OpenSansSemibold" TextColor="#5A31F4" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Línea de tiempo del servicio -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Estado del servicio" FontSize="16" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                    <VerticalStackLayout x:Name="ListaPasos" Spacing="0" />
                </VerticalStackLayout>

                <Button x:Name="BtnCancelar" Text="Cancelar solicitud" Clicked="OnCancelarClicked" BackgroundColor="Transparent" TextColor="#EF4444" BorderColor="#EF4444" BorderWidth="1" FontFamily="OpenSansSemibold" FontSize="15" CornerRadius="12" HeightRequest="50" IsVisible="False"/>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout x:Name="ContenedorVacio" Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="15" Padding="40" IsVisible="False">
            <Border Stroke="Transparent" BackgroundColor="#F3E8FF" StrokeShape="RoundRectangle 40" WidthRequest="80" HeightRequest="80">
                <Path Data="M20 6H16V4C16 2.9 15.1 2 14 2H10C8.9 2 8 2.9 8 4V6H4C2.9 6 2.01 6.9 2.01 8L2 19C2 20.1 2.9 21 4 21H20C21.1 21 22 20.1 22 19V8C22 6.9 21.1 6 20 6ZM10 4H14V6H10V4ZM20 19H4V8H20V19Z" Fill="#A855F7" Aspect="Uniform" WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <Label Text="No tienes servicios activos" FontSize="17" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Center"/>
            <Label Text="Cuando solicites un servicio, aquí podrás seguir su estado en tiempo real." FontSize="13" FontFamily="OpenSansRegular" TextColor="#6B7280" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
