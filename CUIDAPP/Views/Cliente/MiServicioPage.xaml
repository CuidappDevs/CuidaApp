<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:CUIDAPP.Localization"
             x:Class="CUIDAPP.Views.Cliente.MiServicioPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ColorBackground}"
             SafeAreaEdges="None">

    <Grid RowDefinitions="Auto, *" SafeAreaEdges="None">

        <!-- ENCABEZADO (borde a borde) -->
        <Grid Grid.Row="0" SafeAreaEdges="None" Padding="0,0,0,40">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#2A63B8" Offset="0.0" />
                    <GradientStop Color="{StaticResource ColorPrimary}" Offset="0.6" />
                    <GradientStop Color="{StaticResource ColorPrimaryDark}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Ellipse Fill="#14FFFFFF" WidthRequest="220" HeightRequest="220" HorizontalOptions="End" VerticalOptions="Start" Margin="0,-90,-80,0"/>

            <Grid x:Name="ContenidoEncabezado" ColumnDefinitions="44,*,44" Padding="12,10">
                <Border x:Name="BtnBack" Stroke="Transparent" BackgroundColor="#26FFFFFF" WidthRequest="44" HeightRequest="44">
                    <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="White" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Grid.Column="1" Text="{loc:T mis_servicios}" FontSize="17" FontFamily="OpenSansSemibold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Grid>
        </Grid>

        <!-- Hoja -->
        <Border Grid.Row="1" Margin="0,-28,0,0" Stroke="Transparent" BackgroundColor="{StaticResource ColorBackground}" StrokeShape="RoundRectangle 28,28,0,0">
            <Grid>
                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" Color="{StaticResource ColorPrimary}" VerticalOptions="Center"/>

                <ScrollView>
                    <VerticalStackLayout Padding="20,24,20,0" Spacing="12">
                        <VerticalStackLayout x:Name="ListaServicios" Spacing="12" />
                        <ContentView x:Name="EspacioInferior" HeightRequest="40" InputTransparent="True"/>
                    </VerticalStackLayout>
                </ScrollView>

                <VerticalStackLayout x:Name="ContenedorVacio" VerticalOptions="Center" HorizontalOptions="Center" Spacing="14" Padding="40" IsVisible="False">
                    <Border Stroke="Transparent" BackgroundColor="{StaticResource ColorPrimarySoft}" WidthRequest="88" HeightRequest="88" HorizontalOptions="Center">
                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                        <Path Data="M20 6H16V4C16 2.9 15.1 2 14 2H10C8.9 2 8 2.9 8 4V6H4C2.9 6 2.01 6.9 2.01 8L2 19C2 20.1 2.9 21 4 21H20C21.1 21 22 20.1 22 19V8C22 6.9 21.1 6 20 6ZM10 4H14V6H10V4ZM20 19H4V8H20V19Z" Fill="{StaticResource ColorPrimaryLight}" Aspect="Uniform" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="{loc:T no_tienes_servicios_activos}" FontSize="17" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Label Text="{loc:T cuando_solicites_un_servicio_aqui}" FontSize="13" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>

</ContentPage>
