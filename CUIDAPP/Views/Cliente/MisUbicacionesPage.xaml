<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CUIDAPP.Views.Cliente.MisUbicacionesPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F9FAFB">

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="20,15,20,10" BackgroundColor="White">
            <ContentView x:Name="BtnBack" VerticalOptions="Center">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </ContentView.GestureRecognizers>
                <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="#111827" Aspect="Uniform" WidthRequest="22" HeightRequest="22" />
            </ContentView>
            <Label x:Name="LblTitulo" Grid.Column="1" Text="Mis ubicaciones" FontSize="18" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <CollectionView x:Name="ListaUbicaciones" Margin="20,15,20,15">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 14" Padding="16" Margin="0,0,0,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnUbicacionTapped" CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" Stroke="Transparent" BackgroundColor="#F3E8FF" StrokeShape="RoundRectangle 10" WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                                    <Path Data="M12 2C8.13 2 5 5.13 5 9C5 14.25 12 22 12 22C12 22 19 14.25 19 9C19 5.13 15.87 2 12 2ZM12 11.5C10.62 11.5 9.5 10.38 9.5 9C9.5 7.62 10.62 6.5 12 6.5C13.38 6.5 14.5 7.62 14.5 9C14.5 10.38 13.38 11.5 12 11.5Z" Fill="#5A31F4" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding Nombre}" FontSize="15" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                                        <Border Stroke="Transparent" BackgroundColor="#ECFDF5" StrokeShape="RoundRectangle 8" Padding="8,2" IsVisible="{Binding EsPredeterminada}">
                                            <Label Text="Predeterminada" FontSize="10" FontFamily="OpenSansSemibold" TextColor="#065F46"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Direccion}" FontSize="13" FontFamily="OpenSansRegular" TextColor="#6B7280" LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>
                                <ContentView Grid.Column="2" VerticalOptions="Center">
                                    <ContentView.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnEliminarTapped" CommandParameter="{Binding .}"/>
                                    </ContentView.GestureRecognizers>
                                    <Path Data="M6 19C6 20.1 6.9 21 8 21H16C17.1 21 18 20.1 18 19V7H6V19ZM19 4H15.5L14.5 3H9.5L8.5 4H5V6H19V4Z" Fill="#DC2626" Aspect="Uniform" WidthRequest="20" HeightRequest="20"/>
                                </ContentView>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout x:Name="EstadoVacio" IsVisible="False" HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                <Label Text="Aún no tienes ubicaciones guardadas" FontSize="15" FontFamily="OpenSansSemibold" TextColor="#6B7280" HorizontalOptions="Center"/>
                <Label Text="Agrega la dirección de tu casa para reservar más rápido" FontSize="13" FontFamily="OpenSansRegular" TextColor="#9CA3AF" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <ActivityIndicator x:Name="LoaderCarga" IsRunning="False" IsVisible="False" Color="#5A31F4" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <VerticalStackLayout Grid.Row="2" Padding="20,10,20,30" BackgroundColor="White">
            <Button x:Name="BtnAgregar" Text="+ Agregar ubicación" Clicked="OnAgregarClicked" BackgroundColor="#5A31F4" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="12" HeightRequest="55"/>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
