<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CUIDAPP.Views.Cliente.SolicitarServicioPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFFFFF">

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="20,15,20,10" BackgroundColor="White">
            <ContentView x:Name="BtnBack" VerticalOptions="Center">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </ContentView.GestureRecognizers>
                <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="#111827" Aspect="Uniform" WidthRequest="22" HeightRequest="22" />
            </ContentView>
            <Label Grid.Column="1" Text="Solicitar servicio" FontSize="18" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,15,20,30" Spacing="18">

                <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="#FAFAFA" StrokeShape="RoundRectangle 16" Padding="15">
                    <Grid ColumnDefinitions="Auto, *">
                        <Border Grid.Column="0" Stroke="Transparent" StrokeShape="RoundRectangle 25" BackgroundColor="#E5E7EB" WidthRequest="50" HeightRequest="50" Margin="0,0,15,0">
                            <Image x:Name="ImgFoto" Aspect="AspectFill" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label x:Name="LblNombre" Text="" FontSize="16" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                            <Label x:Name="LblEspecialidad" Text="" FontSize="13" FontFamily="OpenSansRegular" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Fecha" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#374151"/>
                    <Border Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,0">
                        <DatePicker x:Name="PickerFecha" FontFamily="OpenSansRegular" FontSize="14"/>
                    </Border>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="8">
                        <Label Text="Hora inicio" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#374151"/>
                        <Border Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,0">
                            <TimePicker x:Name="PickerHoraInicio" FontFamily="OpenSansRegular" FontSize="14"/>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Text="Hora fin" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#374151"/>
                        <Border Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,0">
                            <TimePicker x:Name="PickerHoraFin" FontFamily="OpenSansRegular" FontSize="14"/>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="8">
                    <Label Text="¿A dónde va el cuidador?" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#374151"/>
                    <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="#FAFAFA" StrokeShape="RoundRectangle 12" Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnElegirUbicacionTapped"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <Path Grid.Column="0" Data="M12 2C8.13 2 5 5.13 5 9C5 14.25 12 22 12 22C12 22 19 14.25 19 9C19 5.13 15.87 2 12 2ZM12 11.5C10.62 11.5 9.5 10.38 9.5 9C9.5 7.62 10.62 6.5 12 6.5C13.38 6.5 14.5 7.62 14.5 9C14.5 10.38 13.38 11.5 12 11.5Z" Fill="#2563EB" Aspect="Uniform" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label x:Name="LblUbicacionNombre" Text="Selecciona una ubicación" FontSize="15" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                                <Label x:Name="LblUbicacionDireccion" Text="Toca para elegir" FontSize="13" FontFamily="OpenSansRegular" TextColor="#6B7280" LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                            <Path Grid.Column="2" Data="M8.59 16.59L13.17 12L8.59 7.41L10 6L16 12L10 18L8.59 16.59Z" Fill="#9CA3AF" Aspect="Uniform" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Tarifa por hora" FontSize="14" FontFamily="OpenSansRegular" TextColor="#6B7280" VerticalOptions="Center"/>
                            <Label x:Name="LblTarifa" Grid.Column="1" Text="" FontSize="14" FontFamily="OpenSansRegular" TextColor="#6B7280" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#F3F4F6"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Total a pagar" FontSize="15" FontFamily="OpenSansSemibold" TextColor="#111827" VerticalOptions="Center"/>
                            <Label x:Name="LblTotal" Grid.Column="1" Text="" FontSize="22" FontFamily="OpenSansSemibold" TextColor="#2563EB" VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Padding="20,10,20,30" Spacing="10" BackgroundColor="White">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-4" Opacity="0.05" Radius="10"/>
            </Border.Shadow>
            <Button x:Name="BtnEnviar" Text="Enviar solicitud" Clicked="OnEnviarClicked" BackgroundColor="#2563EB" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="12" HeightRequest="55"/>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
