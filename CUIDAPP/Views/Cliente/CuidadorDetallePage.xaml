<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CUIDAPP.Views.Cliente.CuidadorDetallePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFFFFF">

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="20,15,20,10" BackgroundColor="White">
            <ContentView x:Name="BtnBack" VerticalOptions="Center">
                <ContentView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </ContentView.GestureRecognizers>
                <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Fill="#111827" Aspect="Uniform" WidthRequest="22" HeightRequest="22" />
            </ContentView>
            <Label Grid.Column="1" Text="Perfil del cuidador" FontSize="18" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,30" Spacing="20">

                <Border Stroke="White" StrokeThickness="4" StrokeShape="RoundRectangle 55" BackgroundColor="#E5E7EB" WidthRequest="110" HeightRequest="110" HorizontalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,4" Opacity="0.1" Radius="10"/>
                    </Border.Shadow>
                    <Image x:Name="ImgFoto" Aspect="AspectFill" />
                </Border>

                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label x:Name="LblNombre" Text="" FontSize="22" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Center"/>
                    <Label x:Name="LblEspecialidad" Text="" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#5A31F4" HorizontalOptions="Center"/>
                    <Label x:Name="LblDistancia" Text="" FontSize="13" FontFamily="OpenSansRegular" TextColor="#6B7280" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="20">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                            <Label Text="Tarifa por hora" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                        </VerticalStackLayout>
                        <Label x:Name="LblTarifa" Grid.Column="1" Text="" FontSize="20" FontFamily="OpenSansSemibold" TextColor="#5A31F4" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Sobre mí" FontSize="16" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                    <Label x:Name="LblBio" Text="" FontSize="14" FontFamily="OpenSansRegular" TextColor="#4B5563" LineHeight="1.5"/>
                </VerticalStackLayout>

                <Border Stroke="#D1FAE5" StrokeThickness="1" BackgroundColor="#ECFDF5" StrokeShape="RoundRectangle 12" Padding="15">
                    <Grid ColumnDefinitions="Auto, *">
                        <Path Grid.Column="0" Data="M12 1L3 5V11C3 16.55 6.84 21.74 12 23C17.16 21.74 21 16.55 21 11V5L12 1ZM10 17L5 12L6.41 10.59L10 14.17L17.59 6.58L19 8L10 17Z" Fill="#10B981" Aspect="Uniform" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Margin="0,0,12,0"/>
                        <Label Grid.Column="1" Text="Documentos verificados por CuidApp" FontSize="13" FontFamily="OpenSansSemibold" TextColor="#065F46" VerticalOptions="Center"/>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Padding="20,10,20,30" Spacing="10" BackgroundColor="White">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-4" Opacity="0.05" Radius="10"/>
            </Border.Shadow>
            <Button Text="Solicitar servicio" Clicked="OnSolicitarTapped" BackgroundColor="#5A31F4" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="12" HeightRequest="55"/>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
