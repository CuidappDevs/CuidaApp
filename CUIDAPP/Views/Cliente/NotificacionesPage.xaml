<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:CUIDAPP.Localization"
             x:Class="CUIDAPP.Views.Cliente.NotificacionesPage"
             Shell.PresentationMode="ModalAnimated"
             BackgroundColor="{StaticResource ColorBackground}">

    <!-- Se abre como ventana modal: diseño claro con encabezado blanco y botón de cerrar -->
    <Grid RowDefinitions="Auto, *">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20,18,16,14" BackgroundColor="{StaticResource ColorBackground}">
            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="{loc:T notificaciones}" FontSize="24" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}"/>
            </VerticalStackLayout>
            <Border x:Name="BtnCerrar" Grid.Column="1" Stroke="Transparent" BackgroundColor="White" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCerrarTapped" />
                </Border.GestureRecognizers>
                <Path Data="M19 6.41L17.59 5L12 10.59L6.41 5L5 6.41L10.59 12L5 17.59L6.41 19L12 13.41L17.59 19L19 17.59L13.41 12L19 6.41Z" Fill="{StaticResource ColorTextStrong}" Aspect="Uniform" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </Grid>

        <VerticalStackLayout x:Name="EstadoVacio" Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="14" Padding="40" IsVisible="False">
            <Border Stroke="Transparent" BackgroundColor="#EAF1FB" WidthRequest="88" HeightRequest="88" HorizontalOptions="Center">
                <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                <Path x:Name="CampanaVacia" Data="M12 22C13.1 22 14 21.1 14 20H10C10 21.1 10.9 22 12 22ZM18 16V11C18 7.93 16.36 5.36 13.5 4.68V4C13.5 3.17 12.83 2.5 12 2.5C11.17 2.5 10.5 3.17 10.5 4V4.68C7.63 5.36 6 7.92 6 11V16L4 18V19H20V18L18 16ZM16 17H8V11C8 8.52 9.51 6.5 12 6.5C14.49 6.5 16 8.52 16 11V17Z" Fill="{StaticResource ColorPrimaryLight}" Aspect="Uniform" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center" VerticalOptions="Center" AnchorY="0.15"/>
            </Border>
            <Label Text="{loc:T no_tienes_notificaciones}" FontSize="17" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Center"/>
            <Label Text="{loc:T aqui_veras_avisos_sobre_tus}" FontSize="13" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="ListaNotificaciones" Padding="16,4,16,32" Spacing="10"/>
        </ScrollView>

    </Grid>

</ContentPage>
