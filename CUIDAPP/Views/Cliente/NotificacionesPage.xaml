<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:CUIDAPP.Localization"
             x:Class="CUIDAPP.Views.Cliente.NotificacionesPage"
             Shell.PresentationMode="ModalAnimated"
             BackgroundColor="{StaticResource ColorBackground}">

    <!-- Ventana modal: encabezado con contador y acciones; lista agrupada por día -->
    <Grid RowDefinitions="Auto, *">

        <VerticalStackLayout Grid.Row="0" Padding="20,18,16,10" Spacing="12" BackgroundColor="{StaticResource ColorBackground}">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="{loc:T notificaciones}" FontSize="24" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}"/>
                    <Label x:Name="LblResumen" FontSize="13" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}"/>
                </VerticalStackLayout>
                <Border x:Name="BtnCerrar" Grid.Column="1" Stroke="Transparent" BackgroundColor="{StaticResource ColorSurface}" WidthRequest="44" HeightRequest="44" VerticalOptions="Center"
                        SemanticProperties.Description="{loc:T cerrar}">
                    <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCerrarTapped" />
                    </Border.GestureRecognizers>
                    <Path Data="M19 6.41L17.59 5L12 10.59L6.41 5L5 6.41L10.59 12L5 17.59L6.41 19L12 13.41L17.59 19L19 17.59L13.41 12L19 6.41Z" Fill="{StaticResource ColorTextStrong}" Aspect="Uniform" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>

            <!-- Acciones -->
            <HorizontalStackLayout x:Name="Acciones" Spacing="8">
                <Border x:Name="BtnLeidas" Stroke="Transparent" BackgroundColor="{StaticResource ColorPrimarySoft}" StrokeShape="RoundRectangle 14" Padding="12,7">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMarcarLeidasTapped"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Path Data="M18 7L16.59 5.59L10.25 11.93L11.66 13.34L18 7ZM22.24 5.59L11.66 16.17L7.48 12L6.07 13.41L11.66 19L23.66 7L22.24 5.59ZM0.41 13.41L6 19L7.41 17.59L1.83 12L0.41 13.41Z" Fill="{StaticResource ColorPrimary}" Aspect="Uniform" WidthRequest="15" HeightRequest="15" VerticalOptions="Center"/>
                        <Label Text="{loc:T nh_marcar_leidas}" FontSize="12.5" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorPrimary}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <Border x:Name="BtnBorrar" Stroke="Transparent" BackgroundColor="{StaticResource ColorSurface}" StrokeShape="RoundRectangle 14" Padding="12,7">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBorrarTapped"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Path Data="M6 19C6 20.1 6.9 21 8 21H16C17.1 21 18 20.1 18 19V7H6V19ZM19 4H15.5L14.5 3H9.5L8.5 4H5V6H19V4Z" Fill="{StaticResource ColorTextMuted}" Aspect="Uniform" WidthRequest="14" HeightRequest="14" VerticalOptions="Center"/>
                        <Label Text="{loc:T nh_borrar}" FontSize="12.5" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextMuted}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <VerticalStackLayout x:Name="EstadoVacio" Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="14" Padding="40" IsVisible="False">
            <Border Stroke="Transparent" BackgroundColor="{StaticResource ColorPrimarySoft}" WidthRequest="88" HeightRequest="88" HorizontalOptions="Center">
                <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                <Path x:Name="CampanaVacia" Data="M12 22C13.1 22 14 21.1 14 20H10C10 21.1 10.9 22 12 22ZM18 16V11C18 7.93 16.36 5.36 13.5 4.68V4C13.5 3.17 12.83 2.5 12 2.5C11.17 2.5 10.5 3.17 10.5 4V4.68C7.63 5.36 6 7.92 6 11V16L4 18V19H20V18L18 16ZM16 17H8V11C8 8.52 9.51 6.5 12 6.5C14.49 6.5 16 8.52 16 11V17Z" Fill="{StaticResource ColorPrimary}" Aspect="Uniform" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center" VerticalOptions="Center" AnchorY="0.15"/>
            </Border>
            <Label Text="{loc:T no_tienes_notificaciones}" FontSize="17" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Center"/>
            <Label Text="{loc:T aqui_veras_avisos_sobre_tus}" FontSize="13" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>

        <ScrollView x:Name="Desplazamiento" Grid.Row="1">
            <VerticalStackLayout x:Name="ListaNotificaciones" Padding="16,4,16,32" Spacing="8"/>
        </ScrollView>

    </Grid>

</ContentPage>
