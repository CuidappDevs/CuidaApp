<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CUIDAPP.Views.Cliente.ClienteDashboardPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFFFFF">

    <!-- Un único Grid: el mapa ocupa toda la pantalla y todo lo demás flota encima -->
    <Grid>

        <!-- MAPA A PANTALLA COMPLETA -->
        <Grid>
            <WebView x:Name="MapaWebView" />
            <BoxView Color="#F3F4F6" IsVisible="{Binding Source={x:Reference MapaLoading}, Path=IsRunning}" />
            <ActivityIndicator x:Name="MapaLoading" IsRunning="True" Color="#5A31F4" />
        </Grid>

        <!-- BARRA SUPERIOR FLOTANTE -->
        <Grid VerticalOptions="Start" Padding="20,55,20,0" ColumnDefinitions="Auto, *, Auto">
            <Border Grid.Column="0" Stroke="White" StrokeThickness="2" StrokeShape="RoundRectangle 22" BackgroundColor="#E5E7EB" WidthRequest="44" HeightRequest="44">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,3" Opacity="0.15" Radius="8"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPerfilTapped" />
                </Border.GestureRecognizers>
                <Image x:Name="ImgFotoPerfil" Aspect="AspectFill" />
            </Border>

            <Border Grid.Column="2" Stroke="Transparent" StrokeShape="RoundRectangle 20" WidthRequest="44" HeightRequest="44" BackgroundColor="White">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,3" Opacity="0.15" Radius="8"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNotificacionesTapped" />
                </Border.GestureRecognizers>
                <Path Data="M12 22C13.1 22 14 21.1 14 20H10C10 21.1 10.9 22 12 22ZM18 16V11C18 7.93 16.36 5.36 13.5 4.68V4C13.5 3.17 12.83 2.5 12 2.5C11.17 2.5 10.5 3.17 10.5 4V4.68C7.63 5.36 6 7.92 6 11V16L4 18V19H20V18L18 16ZM16 17H8V11C8 8.52 9.51 6.5 12 6.5C14.49 6.5 16 8.52 16 11V17Z" Fill="#4024A2" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </Grid>

        <!-- PANEL INFERIOR FLOTANTE (BOTTOM SHEET, MINIMIZABLE) -->
        <Border x:Name="BottomSheet" VerticalOptions="End" Stroke="Transparent" BackgroundColor="White" StrokeShape="RoundRectangle 28,28,0,0" HeightRequest="460">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-6" Opacity="0.12" Radius="18"/>
            </Border.Shadow>

            <VerticalStackLayout Padding="20,12,20,0">

                <!-- Manija + encabezado compacto (siempre visibles, tocar para minimizar/expandir) -->
                <VerticalStackLayout>
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTogglePanelTapped" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Border Stroke="Transparent" BackgroundColor="#E5E7EB" StrokeShape="RoundRectangle 3" WidthRequest="40" HeightRequest="5" HorizontalOptions="Center" Margin="0,0,0,12"/>

                    <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label x:Name="LblSaludo" Text="Hola" FontSize="20" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                            <Label Text="¿Qué servicio necesitas hoy?" FontSize="13" FontFamily="OpenSansRegular" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Label x:Name="LblChevron" Grid.Column="1" Text="⌄" FontSize="22" TextColor="#9CA3AF" VerticalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>

                <!-- Contenido colapsable -->
                <VerticalStackLayout x:Name="ContenidoExpandible">

                    <!-- Buscador -->
                    <Border Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#F9FAFB" Padding="15,0" Margin="0,0,0,15">
                        <Grid ColumnDefinitions="Auto, *">
                            <Path Grid.Column="0" Data="M15.5 14H14.71L14.43 13.73C15.41 12.59 16 11.11 16 9.5C16 5.91 13.09 3 9.5 3C5.91 3 3 5.91 3 9.5C3 13.09 5.91 16 9.5 16C11.11 16 12.59 15.41 13.73 14.43L14 14.71V15.5L19 20.49L20.49 19L15.5 14ZM9.5 14C7.01 14 5 11.99 5 9.5C5 7.01 7.01 5 9.5 5C11.99 5 14 7.01 14 9.5C14 11.99 11.99 14 9.5 14Z" Fill="#9CA3AF" Aspect="Uniform" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" Margin="0,0,10,0"/>
                            <Entry Grid.Column="1" x:Name="EntryBuscar" Placeholder="Buscar un servicio (ej. limpieza)" FontFamily="OpenSansRegular" FontSize="14" TextChanged="OnBuscarTextChanged" BackgroundColor="Transparent" HeightRequest="45" VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <!-- Categorías (chips horizontales) -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,0,0,15">
                        <HorizontalStackLayout x:Name="ListaCategorias" Spacing="10" />
                    </ScrollView>

                    <!-- Lista de servicios -->
                    <ScrollView HeightRequest="220">
                        <VerticalStackLayout Spacing="12" Padding="0,0,0,20">
                            <ActivityIndicator x:Name="ServiciosLoading" IsRunning="False" Color="#5A31F4" HorizontalOptions="Center"/>
                            <Label x:Name="LblSinServicios" Text="No encontramos cuidadores disponibles cerca de tu ubicación por ahora." FontSize="13" FontFamily="OpenSansRegular" TextColor="#9CA3AF" HorizontalOptions="Center" IsVisible="False" Margin="0,10,0,0"/>
                            <VerticalStackLayout x:Name="ListaServicios" Spacing="12" />
                        </VerticalStackLayout>
                    </ScrollView>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
