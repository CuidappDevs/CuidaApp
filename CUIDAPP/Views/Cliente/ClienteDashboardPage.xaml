<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:CUIDAPP.Localization"
             x:Class="CUIDAPP.Views.Cliente.ClienteDashboardPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFFFFF">

    <!-- Un único Grid: el mapa ocupa toda la pantalla y todo lo demás flota encima -->
    <Grid>

        <!-- MAPA A PANTALLA COMPLETA -->
        <Grid>
            <WebView x:Name="MapaWebView" />
        </Grid>

        <!-- Degradado suave arriba para que los botones se lean sobre el mapa -->
        <BoxView VerticalOptions="Start" HeightRequest="130" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#99FFFFFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- BARRA SUPERIOR FLOTANTE -->
        <Grid VerticalOptions="Start" Padding="20,55,20,0" ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10">
            <Border x:Name="BtnPerfil" Grid.Column="0" Stroke="White" StrokeThickness="2.5" BackgroundColor="#E5E7EB" WidthRequest="46" HeightRequest="46" Opacity="0" TranslationY="-16">
                <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#0A2F41" Offset="0,4" Opacity="0.18" Radius="10"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPerfilTapped" />
                </Border.GestureRecognizers>
                <Image x:Name="ImgFotoPerfil" Aspect="AspectFill" />
            </Border>

            <Border x:Name="BtnNotificaciones" Grid.Column="2" Stroke="Transparent" WidthRequest="46" HeightRequest="46" BackgroundColor="White" Opacity="0" TranslationY="-16">
                <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#0A2F41" Offset="0,4" Opacity="0.15" Radius="10"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNotificacionesTapped" />
                </Border.GestureRecognizers>
                <Path x:Name="IconoCampana" Data="M12 22C13.1 22 14 21.1 14 20H10C10 21.1 10.9 22 12 22ZM18 16V11C18 7.93 16.36 5.36 13.5 4.68V4C13.5 3.17 12.83 2.5 12 2.5C11.17 2.5 10.5 3.17 10.5 4V4.68C7.63 5.36 6 7.92 6 11V16L4 18V19H20V18L18 16ZM16 17H8V11C8 8.52 9.51 6.5 12 6.5C14.49 6.5 16 8.52 16 11V17Z"
                      Fill="{StaticResource ColorPrimary}" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" AnchorY="0.15"/>
            </Border>

            <Border x:Name="BtnCerrarSesion" Grid.Column="3" Stroke="Transparent" WidthRequest="46" HeightRequest="46" BackgroundColor="White" Opacity="0" TranslationY="-16">
                <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#0A2F41" Offset="0,4" Opacity="0.15" Radius="10"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCerrarSesionTapped" />
                </Border.GestureRecognizers>
                <Path Data="M17 7L15.59 8.41L18.17 11H8V13H18.17L15.59 15.59L17 17L22 12L17 7ZM4 5H12V3H4C2.9 3 2 3.9 2 5V19C2 20.1 2.9 21 4 21H12V19H4V5Z" Fill="{StaticResource ColorDanger}" Aspect="Uniform" WidthRequest="19" HeightRequest="19" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </Grid>

        <!-- PANEL INFERIOR FLOTANTE (BOTTOM SHEET, MINIMIZABLE) -->
        <Border x:Name="BottomSheet" VerticalOptions="End" Stroke="Transparent" BackgroundColor="White" StrokeShape="RoundRectangle 32,32,0,0" HeightRequest="460">
            <Border.Shadow>
                <Shadow Brush="#0A2F41" Offset="0,-8" Opacity="0.14" Radius="24"/>
            </Border.Shadow>

            <VerticalStackLayout Padding="20,10,20,0">

                <!-- Manija + encabezado compacto (siempre visibles, tocar o deslizar para minimizar/expandir) -->
                <VerticalStackLayout>
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTogglePanelTapped" />
                        <PanGestureRecognizer PanUpdated="OnPanelPanUpdated" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Border x:Name="ManijaHandle" Stroke="Transparent" BackgroundColor="{StaticResource ColorBorder}" StrokeShape="RoundRectangle 3" WidthRequest="40" HeightRequest="5" HorizontalOptions="Center" Margin="0,4,0,14"/>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <VerticalStackLayout x:Name="BloqueSaludo" Spacing="3">
                            <HorizontalStackLayout Spacing="6">
                                <Label x:Name="LblSaludo" Text="{loc:T hola}" FontSize="24" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" VerticalOptions="Center"/>
                                <!-- Mano que saluda -->
                                <Label x:Name="ManoSaludo" Text="👋" FontSize="22" VerticalOptions="Center" AnchorX="0.7" AnchorY="0.9"/>
                            </HorizontalStackLayout>
                            <Label Text="{loc:T que_servicio_necesitas_hoy}" FontSize="14" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <!-- Aviso de servicio activo (atajo a "Mis servicios") -->
                <Border x:Name="BannerServicioActivo" Stroke="Transparent" StrokeShape="RoundRectangle 18" Padding="14" Margin="0,0,0,14" IsVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2A63B8" Offset="0" />
                            <GradientStop Color="{StaticResource ColorPrimary}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource ColorPrimary}" Offset="0,6" Opacity="0.25" Radius="14"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVerServicioActivoTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                        <Grid WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                            <!-- Pulso "en vivo" -->
                            <Ellipse x:Name="PulsoServicio" Fill="#66FFFFFF" WidthRequest="40" HeightRequest="40"/>
                            <Border Stroke="Transparent" BackgroundColor="#33FFFFFF" WidthRequest="40" HeightRequest="40">
                                <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                <Path Data="M20 6H16V4C16 2.9 15.1 2 14 2H10C8.9 2 8 2.9 8 4V6H4C2.9 6 2.01 6.9 2.01 8L2 19C2 20.1 2.9 21 4 21H20C21.1 21 22 20.1 22 19V8C22 6.9 21.1 6 20 6ZM10 4H14V6H10V4ZM20 19H4V8H20V19Z" Fill="White" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{loc:T ya_tienes_un_servicio_en}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="White"/>
                            <Label x:Name="LblBannerServicioActivo" Text="" FontSize="12" FontFamily="OpenSansRegular" TextColor="#D9E6F7"/>
                        </VerticalStackLayout>
                        <Path x:Name="FlechaBanner" Grid.Column="2" Data="M10 6L8.59 7.41L13.17 12L8.59 16.59L10 18L16 12L10 6Z" Fill="White" Aspect="Uniform" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Contenido colapsable -->
                <VerticalStackLayout x:Name="ContenidoExpandible">

                    <!-- Buscador -->
                    <Border x:Name="BordeBuscar" Stroke="Transparent" StrokeThickness="1.5" StrokeShape="RoundRectangle 26" BackgroundColor="#EEF1F5" Padding="18,2" Margin="0,0,0,14">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Path x:Name="IconoBuscar" Grid.Column="0" Data="M15.5 14H14.71L14.43 13.73C15.41 12.59 16 11.11 16 9.5C16 5.91 13.09 3 9.5 3C5.91 3 3 5.91 3 9.5C3 13.09 5.91 16 9.5 16C11.11 16 12.59 15.41 13.73 14.43L14 14.71V15.5L19 20.49L20.49 19L15.5 14ZM9.5 14C7.01 14 5 11.99 5 9.5C5 7.01 7.01 5 9.5 5C11.99 5 14 7.01 14 9.5C14 11.99 11.99 14 9.5 14Z" Fill="{StaticResource ColorTextStrong}" Aspect="Uniform" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            <Entry Grid.Column="1" x:Name="EntryBuscar" Placeholder="{loc:T buscar_un_servicio_ej_limpieza}" FontFamily="OpenSansSemibold" FontSize="16" PlaceholderColor="#5B6B7C" TextColor="{StaticResource ColorTextStrong}" TextChanged="OnBuscarTextChanged" BackgroundColor="Transparent" HeightRequest="50" VerticalOptions="Center"
                                   Focused="OnBuscarFocused" Unfocused="OnBuscarUnfocused"/>
                        </Grid>
                    </Border>

                    <!-- Categorías (chips horizontales) -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,0,0,14">
                        <HorizontalStackLayout x:Name="ListaCategorias" Spacing="8" />
                    </ScrollView>

                    <Label Text="{loc:T servicios_cerca_de_ti}" FontSize="16" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" Margin="0,0,0,10"/>

                    <!-- Servicios: mosaicos planos en cuadricula (estilo Uber) -->
                    <ScrollView MaximumHeightRequest="230" VerticalOptions="Start">
                        <VerticalStackLayout Spacing="12" Padding="0,0,0,10" VerticalOptions="Start">
                            <!-- Esqueleto de carga (primera vez) -->
                            <VerticalStackLayout x:Name="ServiciosLoading" Spacing="12" IsVisible="False">
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                    <Border Stroke="Transparent" BackgroundColor="#EEF1F5" StrokeShape="RoundRectangle 22" HeightRequest="78" WidthRequest="78"/>
                                    <Border Grid.Column="1" Stroke="Transparent" BackgroundColor="#EEF1F5" StrokeShape="RoundRectangle 22" HeightRequest="78" WidthRequest="78" Opacity="0.75"/>
                                    <Border Grid.Column="2" Stroke="Transparent" BackgroundColor="#EEF1F5" StrokeShape="RoundRectangle 22" HeightRequest="78" WidthRequest="78" Opacity="0.5"/>
                                    <Border Grid.Column="3" Stroke="Transparent" BackgroundColor="#EEF1F5" StrokeShape="RoundRectangle 22" HeightRequest="78" WidthRequest="78" Opacity="0.3"/>
                                </Grid>
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="LblSinServicios" Spacing="8" IsVisible="False" Margin="0,10,0,0" HorizontalOptions="Center">
                                <Label Text="🔍" FontSize="30" HorizontalOptions="Center"/>
                                <Label Text="{loc:T no_encontramos_cuidadores_disponibles_ce}" FontSize="13" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                            <FlexLayout x:Name="ListaServicios" Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start" />
                        </VerticalStackLayout>
                    </ScrollView>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>

        <!-- OVERLAY DE CARGA (semitransparente, deja ver el mapa detrás) -->
        <Grid x:Name="OverlayCarga" BackgroundColor="#80FFFFFF" InputTransparent="False" IsVisible="False">
            <Border x:Name="TarjetaCarga" HorizontalOptions="Center" VerticalOptions="Center" Stroke="Transparent" BackgroundColor="White" StrokeShape="RoundRectangle 24" Padding="28,24">
                <Border.Shadow>
                    <Shadow Brush="#0A2F41" Offset="0,10" Opacity="0.15" Radius="24"/>
                </Border.Shadow>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="14">
                    <Grid WidthRequest="64" HeightRequest="64" HorizontalOptions="Center">
                        <Ellipse x:Name="OndaCarga" Fill="#331C4D96" WidthRequest="64" HeightRequest="64"/>
                        <Border Stroke="Transparent" BackgroundColor="White" WidthRequest="52" HeightRequest="52" HorizontalOptions="Center" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                            <Image x:Name="LogoCarga" Source="logo_cuidapp.png" Aspect="AspectFit" Margin="6"/>
                        </Border>
                    </Grid>
                    <Label Text="{loc:T cargando_servicios_cercanos}" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
