<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CUIDAPP.Views.Cliente.ClienteDashboardPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFFFFF">

    <!-- Un único Grid: el mapa ocupa toda la pantalla y todo lo demás flota encima -->
    <Grid>

        <!-- MAPA A PANTALLA COMPLETA -->
        <Grid>
            <WebView x:Name="MapaWebView" />
        </Grid>

        <!-- BARRA SUPERIOR FLOTANTE -->
        <Grid VerticalOptions="Start" Padding="20,55,20,0" ColumnDefinitions="Auto, *, Auto, Auto">
            <Border Grid.Column="0" Stroke="White" StrokeThickness="2" StrokeShape="RoundRectangle 22" BackgroundColor="#E5E7EB" WidthRequest="44" HeightRequest="44">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,3" Opacity="0.15" Radius="8"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPerfilTapped" />
                </Border.GestureRecognizers>
                <Image x:Name="ImgFotoPerfil" Aspect="AspectFill" />
            </Border>

            <Border Grid.Column="2" Stroke="Transparent" StrokeShape="RoundRectangle 20" WidthRequest="44" HeightRequest="44" BackgroundColor="White" Margin="0,0,10,0">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,3" Opacity="0.15" Radius="8"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNotificacionesTapped" />
                </Border.GestureRecognizers>
                <Path Data="M12 22C13.1 22 14 21.1 14 20H10C10 21.1 10.9 22 12 22ZM18 16V11C18 7.93 16.36 5.36 13.5 4.68V4C13.5 3.17 12.83 2.5 12 2.5C11.17 2.5 10.5 3.17 10.5 4V4.68C7.63 5.36 6 7.92 6 11V16L4 18V19H20V18L18 16ZM16 17H8V11C8 8.52 9.51 6.5 12 6.5C14.49 6.5 16 8.52 16 11V17Z" Fill="#1D4ED8" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <Border Grid.Column="3" Stroke="Transparent" StrokeShape="RoundRectangle 20" WidthRequest="44" HeightRequest="44" BackgroundColor="White">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,3" Opacity="0.15" Radius="8"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCerrarSesionTapped" />
                </Border.GestureRecognizers>
                <Path Data="M17 7L15.59 8.41L18.17 11H8V13H18.17L15.59 15.59L17 17L22 12L17 7ZM4 5H12V3H4C2.9 3 2 3.9 2 5V19C2 20.1 2.9 21 4 21H12V19H4V5Z" Fill="#EF4444" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </Grid>

        <!-- PANEL INFERIOR FLOTANTE (BOTTOM SHEET, MINIMIZABLE) -->
        <Border x:Name="BottomSheet" VerticalOptions="End" Stroke="Transparent" BackgroundColor="White" StrokeShape="RoundRectangle 28,28,0,0" HeightRequest="460">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-6" Opacity="0.12" Radius="18"/>
            </Border.Shadow>

            <VerticalStackLayout Padding="20,12,20,0">

                <!-- Manija + encabezado compacto (siempre visibles, tocar o deslizar para minimizar/expandir) -->
                <VerticalStackLayout>
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTogglePanelTapped" />
                        <PanGestureRecognizer PanUpdated="OnPanelPanUpdated" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Border x:Name="ManijaHandle" Stroke="Transparent" BackgroundColor="#D1D5DB" StrokeShape="RoundRectangle 3" WidthRequest="44" HeightRequest="5" HorizontalOptions="Center" Margin="0,4,0,10"/>

                    <VerticalStackLayout Spacing="2" Margin="0,0,0,10">
                        <Label x:Name="LblSaludo" Text="Hola" FontSize="20" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                        <Label Text="¿Qué servicio necesitas hoy?" FontSize="13" FontFamily="OpenSansRegular" TextColor="#6B7280"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Aviso de servicio activo (reemplaza el buscador mientras haya una solicitud en curso) -->
                <Border x:Name="BannerServicioActivo" Stroke="#BFDBFE" StrokeThickness="1" BackgroundColor="#EFF6FF" StrokeShape="RoundRectangle 14" Padding="15" Margin="0,0,0,10" IsVisible="False">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVerServicioActivoTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" Stroke="Transparent" BackgroundColor="#2563EB" StrokeShape="RoundRectangle 18" WidthRequest="36" HeightRequest="36" Margin="0,0,12,0">
                            <Path Data="M20 6H16V4C16 2.9 15.1 2 14 2H10C8.9 2 8 2.9 8 4V6H4C2.9 6 2.01 6.9 2.01 8L2 19C2 20.1 2.9 21 4 21H20C21.1 21 22 20.1 22 19V8C22 6.9 21.1 6 20 6ZM10 4H14V6H10V4ZM20 19H4V8H20V19Z" Fill="White" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                            <Label Text="Ya tienes un servicio en curso" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#111827"/>
                            <Label x:Name="LblBannerServicioActivo" Text="" FontSize="12" FontFamily="OpenSansRegular" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="26" TextColor="#9CA3AF" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Contenido colapsable -->
                <VerticalStackLayout x:Name="ContenidoExpandible">

                    <!-- Buscador -->
                    <Border Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#F9FAFB" Padding="15,0" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="Auto, *">
                            <Path Grid.Column="0" Data="M15.5 14H14.71L14.43 13.73C15.41 12.59 16 11.11 16 9.5C16 5.91 13.09 3 9.5 3C5.91 3 3 5.91 3 9.5C3 13.09 5.91 16 9.5 16C11.11 16 12.59 15.41 13.73 14.43L14 14.71V15.5L19 20.49L20.49 19L15.5 14ZM9.5 14C7.01 14 5 11.99 5 9.5C5 7.01 7.01 5 9.5 5C11.99 5 14 7.01 14 9.5C14 11.99 11.99 14 9.5 14Z" Fill="#9CA3AF" Aspect="Uniform" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" Margin="0,0,10,0"/>
                            <Entry Grid.Column="1" x:Name="EntryBuscar" Placeholder="Buscar un servicio (ej. limpieza)" FontFamily="OpenSansRegular" FontSize="14" TextChanged="OnBuscarTextChanged" BackgroundColor="Transparent" HeightRequest="45" VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <!-- Categorías (chips horizontales) -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,0,0,10">
                        <HorizontalStackLayout x:Name="ListaCategorias" Spacing="10" />
                    </ScrollView>

                    <!-- Lista de servicios -->
                    <ScrollView MaximumHeightRequest="220" VerticalOptions="Start">
                        <VerticalStackLayout Spacing="12" Padding="0,0,0,10" VerticalOptions="Start">
                            <ActivityIndicator x:Name="ServiciosLoading" IsRunning="False" IsVisible="False" Color="#2563EB" HorizontalOptions="Center"/>
                            <Label x:Name="LblSinServicios" Text="No encontramos cuidadores disponibles cerca de tu ubicación por ahora." FontSize="13" FontFamily="OpenSansRegular" TextColor="#9CA3AF" HorizontalOptions="Center" IsVisible="False" Margin="0,10,0,0"/>
                            <VerticalStackLayout x:Name="ListaServicios" Spacing="12" />
                        </VerticalStackLayout>
                    </ScrollView>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>

        <!-- OVERLAY DE CARGA (semitransparente, deja ver el mapa detrás) -->
        <Grid x:Name="OverlayCarga" BackgroundColor="#B3FFFFFF" InputTransparent="False">
            <Border HorizontalOptions="Center" VerticalOptions="Center" Stroke="Transparent" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="25,20">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,4" Opacity="0.12" Radius="12"/>
                </Border.Shadow>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="12">
                    <ActivityIndicator IsRunning="True" Color="#2563EB" WidthRequest="32" HeightRequest="32"/>
                    <Label Text="Cargando servicios cercanos..." FontSize="13" FontFamily="OpenSansSemibold" TextColor="#374151" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
