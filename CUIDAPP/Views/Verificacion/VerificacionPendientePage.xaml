<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:CUIDAPP.Localization"
             x:Class="CUIDAPP.Views.Verificacion.VerificacionPendientePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ColorBackground}">

    <Grid RowDefinitions="*, Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="25,40,25,20" Spacing="20">

                <!-- Insignia con anillo que respira -->
                <Grid WidthRequest="130" HeightRequest="130" HorizontalOptions="Center">
                    <Ellipse x:Name="AnilloEstado" Fill="#331C4D96" WidthRequest="130" HeightRequest="130"/>
                    <Border Stroke="Transparent" WidthRequest="100" HeightRequest="100" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="{StaticResource ColorSurface}">
                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource ColorShadow}" Offset="0,8" Radius="20" Opacity="0.12" />
                        </Border.Shadow>
                    <Path x:Name="IconEstadoGeneral" Data="M12 1L3 5V11C3 16.55 6.84 21.74 12 23C17.16 21.74 21 16.55 21 11V5L12 1ZM12 12C13.66 12 15 10.66 15 9C15 7.34 13.66 6 12 6C10.34 6 9 7.34 9 9C9 10.66 10.34 12 12 12ZM12 13.9C9.97 13.9 6 14.9 6 16.9V18H18V16.9C18 14.9 14.03 13.9 12 13.9Z" Fill="{StaticResource ColorPrimary}" Aspect="Uniform" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Label x:Name="LblTituloEstado" Text="{loc:T documentos_en_revision}" FontSize="24" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Label x:Name="LblDescripcionEstado" Text="{loc:T estamos_verificando_tus_documentos_te}" FontSize="14" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,-10,0,10" />

                <Label Text="{loc:T estado_de_tus_documentos}" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource ColorTextStrong}" Margin="0,15,0,0" />

                <VerticalStackLayout x:Name="ListaDocumentos" Spacing="12" />

                <Label x:Name="LblSinDocumentos" Text="{loc:T no_se_encontraron_documentos_asociados}" FontFamily="OpenSansRegular" FontSize="13" TextColor="{StaticResource ColorTextMuted}" HorizontalOptions="Center" IsVisible="False" Margin="0,10,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Padding="20,10,20,14" Spacing="6" BackgroundColor="{StaticResource ColorBackground}">
            <Button x:Name="BtnActualizar" Text="{loc:T actualizar_estado}" Clicked="OnActualizarTapped" BackgroundColor="{StaticResource ColorPrimary}" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="16" HeightRequest="56" />
            <Button x:Name="BtnCerrarSesion" Text="{loc:T cerrar_sesion}" Clicked="OnCerrarSesionTapped" BackgroundColor="Transparent" TextColor="{StaticResource ColorTextMuted}" FontFamily="OpenSansSemibold" FontSize="14" BorderColor="Transparent" HeightRequest="40" />
        </VerticalStackLayout>

        <Grid x:Name="OverlayExito" Grid.RowSpan="2" IsVisible="False" Opacity="0" BackgroundColor="{StaticResource ColorPrimary}">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="18" Padding="40,0">
                <Border x:Name="CirculoExito" Stroke="Transparent" StrokeShape="RoundRectangle 60" WidthRequest="120" HeightRequest="120" BackgroundColor="{StaticResource ColorSurface}" HorizontalOptions="Center" Scale="0.5">
                    <Path Data="M9 16.17L4.83 12L3.41 13.41L9 19L21 7L19.59 5.59L9 16.17Z" Fill="{StaticResource ColorSuccess}" Aspect="Uniform" WidthRequest="60" HeightRequest="60" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="{loc:T felicidades}" FontSize="26" FontFamily="OpenSansSemibold" TextColor="White" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Label Text="{loc:T todos_tus_documentos_fueron_validados}" FontSize="15" FontFamily="OpenSansRegular" TextColor="#DBEAFE" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
