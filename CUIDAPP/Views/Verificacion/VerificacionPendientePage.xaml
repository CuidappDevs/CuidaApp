<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CUIDAPP.Views.Verificacion.VerificacionPendientePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="*, Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="25,40,25,20" Spacing="20">

                <Border Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 60" WidthRequest="100" HeightRequest="100" HorizontalOptions="Center" BackgroundColor="#F3E8FF">
                    <Path x:Name="IconEstadoGeneral" Data="M12 1L3 5V11C3 16.55 6.84 21.74 12 23C17.16 21.74 21 16.55 21 11V5L12 1ZM12 12C13.66 12 15 10.66 15 9C15 7.34 13.66 6 12 6C10.34 6 9 7.34 9 9C9 10.66 10.34 12 12 12ZM12 13.9C9.97 13.9 6 14.9 6 16.9V18H18V16.9C18 14.9 14.03 13.9 12 13.9Z" Fill="#4024A2" Aspect="Uniform" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Label x:Name="LblTituloEstado" Text="Documentos en revisión" FontSize="24" FontFamily="OpenSansSemibold" TextColor="#111827" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Label x:Name="LblDescripcionEstado" Text="Estamos verificando tus documentos. Te avisaremos cuando tu cuenta esté aprobada para empezar a trabajar." FontSize="14" FontFamily="OpenSansRegular" TextColor="#6B7280" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,-10,0,10" />

                <Label Text="Estado de tus documentos" FontFamily="OpenSansSemibold" FontSize="15" TextColor="#374151" Margin="0,15,0,0" />

                <VerticalStackLayout x:Name="ListaDocumentos" Spacing="12" />

                <Label x:Name="LblSinDocumentos" Text="No se encontraron documentos asociados a tu cuenta." FontFamily="OpenSansRegular" FontSize="13" TextColor="#9CA3AF" HorizontalOptions="Center" IsVisible="False" Margin="0,10,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Padding="25,10,25,25" Spacing="10" BackgroundColor="#F8F9FA">
            <Button x:Name="BtnActualizar" Text="Actualizar estado" Clicked="OnActualizarTapped" BackgroundColor="#4024A2" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" CornerRadius="12" HeightRequest="55" />
            <Button x:Name="BtnCerrarSesion" Text="Cerrar sesión" Clicked="OnCerrarSesionTapped" BackgroundColor="Transparent" TextColor="#6B7280" FontFamily="OpenSansSemibold" FontSize="14" BorderColor="Transparent" HeightRequest="40" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
