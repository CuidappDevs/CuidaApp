<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CUIDAPP.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ColorBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="25,20" Spacing="25">
            
            <!-- Logo CUIDAPP -->
            <Grid WidthRequest="140" HeightRequest="140" HorizontalOptions="Center" Margin="0, 40, 0, 0">
                <Image Source="logo_cuidapp.png" Aspect="AspectFit" Margin="14" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.Shadow>
                        <Shadow Brush="Black" Offset="0,10" Radius="15" Opacity="0.15" />
                    </Image.Shadow>
                </Image>
            </Grid>

            <!-- Saludo -->
            <VerticalStackLayout Spacing="5" HorizontalOptions="Center" Margin="0, 15, 0, 15">
                <Label Text="¡Hola de nuevo!" FontFamily="OpenSansSemibold" FontSize="28" TextColor="{StaticResource ColorTextStrong}" HorizontalOptions="Center" />
                <Label Text="Ingresa tus datos para continuar" FontFamily="OpenSansRegular" FontSize="15" TextColor="{StaticResource ColorTextMuted}" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Input Correo -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Correo electrónico o teléfono" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource ColorTextStrong}" />
                <Border Stroke="{StaticResource ColorBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource ColorSurface}" Padding="15,2">
                    <Entry x:Name="EntryEmail" Placeholder="ejemplo@correo.com" FontFamily="OpenSansRegular" PlaceholderColor="{StaticResource ColorTextMuted}" TextColor="{StaticResource ColorTextStrong}" FontSize="15" BackgroundColor="Transparent" ClearButtonVisibility="WhileEditing" HeightRequest="45" Keyboard="Email" />
                </Border>
            </VerticalStackLayout>

            <!-- Input Contraseña -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Contraseña" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource ColorTextStrong}" />
                <Border Stroke="{StaticResource ColorBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource ColorSurface}" Padding="15,2">
                    <Grid ColumnDefinitions="*, Auto">
                        <Entry x:Name="EntryPassword" Placeholder="••••••••" FontFamily="OpenSansRegular" PlaceholderColor="{StaticResource ColorTextMuted}" TextColor="{StaticResource ColorTextStrong}" FontSize="15" IsPassword="True" BackgroundColor="Transparent" Grid.Column="0" HeightRequest="45" />
                        <!-- Icono Ojo (Path) -->
                        <Path Grid.Column="1" Data="M12 4.5C7 4.5 2.73 7.61 1 12C2.73 16.39 7 19.5 12 19.5C17 19.5 21.27 16.39 23 12C21.27 7.61 17 4.5 12 4.5ZM12 17C9.24 17 7 14.76 7 12C7 9.24 9.24 7 12 7C14.76 7 17 9.24 17 12C17 14.76 14.76 17 12 17ZM12 9C10.34 9 9 10.34 9 12C9 13.66 10.34 15 12 15C13.66 15 15 13.66 15 12C15 10.34 13.66 9 12 9Z" 
                              Fill="{StaticResource ColorTextMuted}" Aspect="Uniform" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Margin="0,0,5,0">
                            <Path.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTogglePasswordVisibility" />
                            </Path.GestureRecognizers>
                        </Path>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Olvidaste contraseña -->
            <Label Text="¿Olvidaste tu contraseña?" FontFamily="OpenSansSemibold" FontSize="13" TextColor="{StaticResource ColorPrimary}" HorizontalOptions="End" Margin="0, -10, 0, 15">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                </Label.GestureRecognizers>
            </Label>

            <!-- Boton Login -->
            <Button x:Name="BtnLogin" Text="Iniciar sesión" FontFamily="OpenSansSemibold" BackgroundColor="{StaticResource ColorPrimary}" TextColor="{StaticResource ColorSurface}" FontSize="16" CornerRadius="12" HeightRequest="55" Margin="0, 5, 0, 15" Clicked="OnLoginClicked">
                <Button.Shadow>
                    <Shadow Brush="{StaticResource ColorPrimaryDark}" Offset="0,5" Radius="10" Opacity="0.3" />
                </Button.Shadow>
            </Button>

            <!-- Link Registro -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0, 10, 0, 0">
                <Label Text="¿No tienes cuenta?" FontFamily="OpenSansRegular" FontSize="14" TextColor="{StaticResource ColorTextMuted}" />
                <Label Text="Regístrate aquí" FontFamily="OpenSansSemibold" FontSize="14" TextColor="{StaticResource ColorPrimary}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRegisterTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
