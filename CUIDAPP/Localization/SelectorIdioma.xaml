<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:CUIDAPP.Localization"
             x:Class="CUIDAPP.Localization.SelectorIdioma">

    <!-- Tarjeta: icono + título/idioma actual + control segmentado -->
    <Border x:Name="Tarjeta" Stroke="{StaticResource ColorBorder}" StrokeThickness="1" BackgroundColor="{StaticResource ColorSurface}" StrokeShape="RoundRectangle 16" Padding="14,12">
        <Grid x:Name="Contenido" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">

            <Border x:Name="IconoCaja" Grid.Column="0" Stroke="Transparent" BackgroundColor="{StaticResource ColorPrimarySoft}" StrokeShape="RoundRectangle 12" WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm6.93 6h-2.95a15.65 15.65 0 0 0-1.38-3.56A8.03 8.03 0 0 1 18.93 8zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2s.06 1.34.14 2H4.26zm.82 2h2.95c.32 1.25.78 2.45 1.38 3.56A7.99 7.99 0 0 1 5.08 16zm2.95-8H5.08a7.99 7.99 0 0 1 4.33-3.56A15.65 15.65 0 0 0 8.03 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66c-.1-.66-.16-1.32-.16-2s.06-1.35.16-2h4.68c.09.65.16 1.32.16 2s-.07 1.34-.16 2zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95a8.03 8.03 0 0 1-4.33 3.56zM16.36 14c.08-.66.14-1.32.14-2s-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2h-3.38z"
                      x:Name="IconoGlobo" Fill="{StaticResource ColorPrimary}" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <VerticalStackLayout x:Name="Textos" Grid.Column="1" VerticalOptions="Center" Spacing="1">
                <Label Text="{loc:T idioma}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource ColorTextStrong}"/>
                <Label x:Name="LblIdiomaActual" FontSize="12" FontFamily="OpenSansRegular" TextColor="{StaticResource ColorTextMuted}" LineBreakMode="TailTruncation"/>
            </VerticalStackLayout>

            <!-- Control segmentado -->
            <Border x:Name="Pista" Grid.Column="2" Stroke="Transparent" BackgroundColor="{StaticResource ColorSubtle}" StrokeShape="RoundRectangle 10" Padding="3" VerticalOptions="Center">
                <HorizontalStackLayout x:Name="Segmentos" Spacing="2"/>
            </Border>

        </Grid>
    </Border>
</ContentView>
